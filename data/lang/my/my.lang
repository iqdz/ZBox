format_word_italic = စာလုံးစောင်း
format_word_strike = မျဉ်းကြောင်းဖြတ်
format_word_href = လင့်ခ်
format_word_bullet = ကျည်ဆံပွင့်စာရင်း
format_word_number = နံပါတ်စာရင်း
format_word_quote = ကိုးကားချက်
format_word_code = ကုဒ်
format_word_heading1 = ခေါင်းစီး
format_applied = {formatting} ကို အသုံးပြုပြီးပါပြီ။
format_inserted = {formatting} ကို ထည့်ပြီးပါပြီ။
format_not_available = ရိုးရိုးမက်ဆေ့ချ်ကိုယ်ထည်တွင် {formatting} မရနိုင်ပါ။

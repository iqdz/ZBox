# What a bulk action is called, when ZBox says which one just
# finished. These are names, not sentences.
action_archive = မော်ကွန်းတင်ရန်
action_delete = ဖျက်ရန်
action_delete_permanently = အပြီးအပိုင် ဖျက်ရန်
action_mark_as_junk = အမှိုက်စာအဖြစ် မှတ်ရန်
action_mark_as_not_junk = အမှိုက်စာမဟုတ်ဟု မှတ်ရန်
action_move_to = ရွှေ့ရန်
action_copy_to = ကူးယူရန်
action_mark_message = မက်ဆေ့ချ်ကို မှတ်ရန်
action_undo = နောက်ပြန်ရန်

# Finishing an action on one or more messages. {action} is one of the
# names just above and {to_folder} is one of your own folders.
undo_done_one = {action} ကို နောက်ပြန်လိုက်ပါပြီ။
undo_done_many = မက်ဆေ့ချ် {count} ခုအတွက် {action} ကို နောက်ပြန်လိုက်ပါပြီ။
junk_marked_one = အမှိုက်စာအဖြစ် မှတ်ပြီးပါပြီ။
junk_marked_many = မက်ဆေ့ချ် {count} ခုကို အမှိုက်စာအဖြစ် မှတ်ပြီးပါပြီ။
junk_no_new_sender = ပို့သူအသစ် မည်သူ့ကိုမျှ မပိတ်ဆို့ပါ - ပိတ်ဆို့ပြီးသား၊ စာပို့စာရင်း၊ သို့မဟုတ် သင့်ကိုယ်ပိုင်လိပ်စာတစ်ခု ဖြစ်သည်။
not_junk_marked_one = အမှိုက်စာမဟုတ်ဟု မှတ်ပြီးပါပြီ။
not_junk_marked_many = မက်ဆေ့ချ် {count} ခုကို အမှိုက်စာမဟုတ်ဟု မှတ်ပြီးပါပြီ။
moved_to_one = {to_folder} သို့ ရွှေ့ပြီးပါပြီ။
moved_to_many = မက်ဆေ့ချ် {count} ခုကို {to_folder} သို့ ရွှေ့ပြီးပါပြီ။
copied_to_many = မက်ဆေ့ချ် {count} ခုကို {to_folder} သို့ ကူးယူပြီးပါပြီ။
marked_read = ဖတ်ပြီးအဖြစ် မှတ်ပြီးပါပြီ။
marked_unread = မဖတ်ရသေးအဖြစ် မှတ်ပြီးပါပြီ။

# When a run of several messages is stopped or partly fails. {done}
# is the ordinary finished message above, spoken first.
bulk_cancelled = {total} ခုအနက် {completed} ခုပြီးနောက် ပယ်ဖျက်ခဲ့သည်။ အောင်မြင် {succeeded}၊ မအောင်မြင် {failed}။
bulk_failed_one = မက်ဆေ့ချ် ၁ စောင်တွင် {failed} ခု {done} မအောင်မြင်ပါ။
bulk_failed_many = မက်ဆေ့ချ် {total} စောင်တွင် {failed} ခု {done} မအောင်မြင်ပါ။

# Formatting, as it is spoken while writing. The word on the left of

# The explanatory note under a control, one paragraph per key.
acct_note_display_name = ظاہری نام اختیاری ہے -- اس اکاؤنٹ کے اپنے نام سے بھیجنے کے لیے خالی چھوڑیں۔
acct_note_identity = اگر آپ کے فراہم کنندہ نے اس میل باکس سے کوئی حسبِ منشا ڈومین جوڑ رکھا ہو تو ای میل پتہ لاگ ان ای میل سے مختلف ہو سکتا ہے۔ میل اوپر والے پتے سے بھیجی اور وصول کی جائے گی، جبکہ سائن ان اب بھی لاگ ان ای میل سے ہو گا۔ اس اکاؤنٹ کا پہلے سے محفوظ پاس ورڈ رکھنے کے لیے پاس ورڈ کا خانہ خالی چھوڑیں -- مثلاً Gmail ایپ پاس ورڈ بدلنے کے بعد نیا یہاں لکھیں؛ ورنہ خالی چھوڑیں۔
acct_note_identities = دوسرے پتے جن سے یہ اکاؤنٹ بھیج اور جواب دے سکتا ہے۔ ان میں سے کسی پر بھیجے گئے پیغام کا جواب دینے سے بھیجنے والا خود بخود اوپر والے پتے کے بجائے وہی پتہ ہو جاتا ہے۔
acct_note_signature = اس اکاؤنٹ سے بھیجے گئے ہر نئے پیغام، جواب اور آگے بھیجے گئے پیغام کے آخر میں "-- " والی سطر کے نیچے شامل ہوتے ہیں۔ دستخط نہ چاہیں تو خالی چھوڑیں۔ دستخط میں ترمیم کریں فارمیٹ شدہ ایڈیٹر کھولتا ہے، جہاں جلی، فہرستیں اور لنکس دستیاب ہیں؛ پھر اوپر والا خانہ اس کے ساتھ جانے والا سادہ متن ورژن رکھتا ہے۔
acct_note_junk = جنک نشان زد کریں پیغامات کو کس اصل فولڈر میں منتقل کرتا ہے۔ "{automatic}" وہی فراہم کنندہ پر مبنی اندازہ استعمال کرتا ہے جو آرکائیو اور ردی کی ٹوکری پہلے سے استعمال کرتے ہیں؛ اسے صرف تب مقرر کریں جب وہ اندازہ غلط ہو یا آپ کے جنک فولڈر کا حسبِ منشا نام ہو۔
acct_note_disable = غیر فعال اکاؤنٹ سے دوبارہ فعال ہونے تک کبھی رابطہ نہیں کیا جاتا -- نہ IDLE، نہ وقفے وقفے سے تازہ کاری، کچھ بھی نہیں۔ یہ درخت میں (غیر فعال) کے نشان کے ساتھ دکھائی دیتا رہتا ہے، اور اس کی پہلے سے ڈاؤن لوڈ شدہ میل آف لائن دستیاب رہتی ہے۔ یہ وہی سوئچ ہے جو اکاؤنٹس > اکاؤنٹ غیر فعال کریں یا اکاؤنٹ کے اپنے سیاقی مینو میں ہے؛ یہ اس تک پہنچنے کی بس ایک اور جگہ ہے۔
acct_note_default = اس اکاؤنٹ کے فولڈرز درخت میں پہلے آتے ہیں، اور نیا پیغام خود بخود اسی سے بھیجا جاتا ہے جب تک ایڈیٹر میں دستی طور پر نہ بدلا جائے۔ اس پر اثر نہیں پڑتا کہ جواب یا آگے بھیجا گیا پیغام کون سا پتہ استعمال کرتا ہے -- وہ پہلے ہی جواب دیے جانے والے پیغام کی پیروی کرتا ہے (اوپر اضافی شناختیں دیکھیں)۔ ہمیشہ بالکل ایک پہلے سے طے شدہ اکاؤنٹ ہوتا ہے، اس لیے موجودہ پر یہ نشان ہٹانا، کسی دوسرے پر لگائے بغیر، اسے نہیں بدلتا -- پہلے سے طے شدہ کسی اور اکاؤنٹ کو دینے کے لیے اس کا خانہ نشان زد کریں۔
acct_note_mute = خاموش کرنا اس اکاؤنٹ کی نئی میل کی آواز، بولا گیا اعلان اور Windows اطلاع روک دیتا ہے، چاہے وہ کسی بھی طرح ترتیب دیے گئے ہوں۔ دوسرے اکاؤنٹس متاثر نہیں ہوتے، اور یہ اب بھی ترتیبات > آواز اور اطلاعات کے مرکزی سوئچز (مجموعی طور پر آوازیں اور ڈیسک ٹاپ اطلاعات) کے تابع ہے۔
wiz_note_app_password = اگر آپ پہلے ہی ZBox کے لیے ایپ پاس ورڈ بنا چکے ہیں تو آگے بڑھنے کے لیے اگلا دبائیں۔
wiz_note_login = لاگ ان کی اسناد۔\nاگر آپ کی لاگ ان ای میل اوپر والے پتے سے مختلف ہے، مثلاً آپ کا فراہم کنندہ اکاؤنٹ login@example.net ہے مگر آپ you@example.org کے طور پر بھیجنا اور وصول کرنا چاہتے ہیں، تو یہاں لاگ ان ای میل درج کریں۔ حسبِ منشا بھیجنے کا پتہ آپ بعد میں اکاؤنٹ اور شناخت کی ترتیبات میں مقرر کر سکتے ہیں۔
wiz_note_servers = سرور کی ترتیبات، ڈومین پہچانے جانے پر پہلے سے بھری ہوئی۔ جو کچھ مختلف ہونا چاہیے اس میں ترمیم کریں۔
wiz_preset_none = اس ڈومین کے لیے کوئی پہلے سے طے شدہ ترتیب نہیں ملی۔ اپنے فراہم کنندہ کی سرور ترتیبات دستی طور پر درج کریں؛ آپ کے فراہم کنندہ کے مدد کے صفحات ان کی فہرست دیتے ہیں۔
ab_note_groups = کسی گروپ کے تمام اراکین ایک ساتھ بھرنے کے لیے تحریر کی ونڈو کے بنام، Cc یا Bcc خانے میں اس گروپ کا نام لکھیں۔
cache_note_intro = یہ صرف ZBox کی مقامی نقلیں ہٹاتے ہیں۔ کسی میل سرور سے کچھ حذف نہیں ہوتا، اور ہٹایا گیا پیغام اگلی بار کھولنے پر دوبارہ ڈاؤن لوڈ ہو جاتا ہے۔
cache_note_age = خودکار صفائی دن میں ایک بار چلتی ہے، جب ZBox میں دس منٹ تک کی بورڈ کی کوئی سرگرمی نہ ہو اور کوئی پیغام کھلا نہ ہو۔ یہ ہر پیغام کی اپنی تاریخ کے حساب سے چلتی ہے، ان پیغامات سمیت جو ابھی آپ کے اکاؤنٹ میں ہیں۔
filt_note_intro = اصول ترتیب سے، اوپر سے نیچے، بھیجنے والا، بنام اور موضوع جانچتے ہوئے چلتے ہیں۔ اس اکاؤنٹ کے ان باکس میں آنے والی نئی میل پر خود بخود لاگو ہوتے ہیں؛ کسی فولڈر میں پہلے سے موجود پیغامات پر لاگو کرنے کے لیے نیچے ابھی چلائیں استعمال کریں۔
filt_note_run_now = اوپر کا ہر فعال اصول، ترتیب سے، منتخب فولڈر میں پہلے سے موجود ہر پیغام پر لاگو کرتا ہے -- OK کی طرح پہلے آپ کی تبدیلیاں محفوظ کرتا ہے۔
mp_note_intro = یہ اکاؤنٹس کسی دوسرے کمپیوٹر پر ترتیب دیے گئے تھے۔ یہاں ان کے محفوظ شدہ پاس ورڈز کھولنے کے لیے ماسٹر پاس ورڈ درج کریں۔ اس کمپیوٹر پر آپ سے صرف ایک بار پوچھا جائے گا۔\n\nاس کے بغیر ہر اکاؤنٹ کو اپنے میل سرور پر دوبارہ سائن ان کرنا ہو گا۔
priv_note_remote = کوئی پیغام انٹرنیٹ سے جو تصاویر، اسٹائل شیٹس اور فونٹس لوڈ کرتا ہے وہ بھیجنے والے کو بتا دیتے ہیں کہ آپ نے اسے کب اور کہاں سے کھولا۔ اس کے آن ہونے پر ان میں سے کچھ لوڈ نہیں ہوتا: پیغام کے اوپر ایک اطلاع بتاتی ہے کہ کیا مسدود ہوا، اور Ctrl+Shift+I اسے صرف اسی پیغام کے لیے لوڈ کرتا ہے۔ خود پیغام سے منسلک تصاویر ہمیشہ دکھائی دیتی ہیں۔ اسکرپٹس اور سرایت شدہ فریمز بہرحال ہٹا دیے جاتے ہیں اور کبھی لوڈ نہیں ہوتے۔
priv_note_blocklist = یہ دوسری تہہ ہے۔ یہ تب اہم ہے جب آپ کسی پیغام کا بیرونی مواد لوڈ کریں یا کسی بھیجنے والے کو اجازت دیں: تصاویر لوڈ ہوتی ہیں، مگر کسی معروف ٹریکنگ یا اشتہاری ڈومین سے آنے والی کوئی چیز پھر بھی لوڈ نہیں ہوتی۔ فہرست عوامی اشتہاری اور ٹریکر فہرستوں سے ڈاؤن لوڈ کر کے یکجا کی جاتی ہے؛ اپ ڈیٹ میں ایک دو سیکنڈ لگتے ہیں اور یہ پس منظر میں چلتی ہے۔
priv_note_junk = کوئی اندازہ نہیں۔ جنک نشان زد کریں بھیجنے والے کو نیچے کی مسدود فہرست میں شامل کرتا ہے، الا یہ کہ پیغام کسی میلنگ لسٹ کے ذریعے آیا ہو۔ جنک نہیں نشان زد کریں بھیجنے والے کو کبھی جنک نہیں والی فہرست میں شامل کرتا ہے اور وہ پیغام پھر کبھی نہیں جانچا جاتا۔ کسی مسدود بھیجنے والے کا نیا پیغام فہرست میں مسدود بھیجنے والا کے طور پر نشان زد ہوتا ہے؛ کسی معروف فشنگ یا میلویئر سائٹ کا لنک رکھنے والا پیغام ممکنہ فشنگ کے طور پر نشان زد ہوتا ہے۔ آپ کے میل فراہم کنندہ کی اپنی اسپیم فلٹرنگ پہلے کی طرح چلتی رہتی ہے۔
priv_status_phishing_updating = فشنگ کی فہرست: پس منظر میں اپ ڈیٹ ہو رہی ہے۔ نتیجہ دیکھنے کے لیے یہ ڈائیلاگ دوبارہ کھولیں۔

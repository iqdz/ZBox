# The explanatory note under each setting. One paragraph, one key.
set_debug_note = اگر کچھ غلط ہو جائے تو ڈیبگ لاگنگ مسائل کی تشخیص میں مدد کرتی ہے۔ اسے بند کرنے سے نئے اندراجات لکھے جانا بند ہو جاتے ہیں؛ موجودہ لاگ فائلیں حذف نہیں ہوتیں۔ ZBox اگلی بار شروع ہونے پر لاگو ہوتا ہے۔
set_language_note = ZBox اگلی بار شروع ہونے پر لاگو ہوتا ہے۔ زبان کی فائلیں ZBox کے lang فولڈر میں، sounds فولڈر کے ساتھ، سادہ متن فائلیں ہیں۔ نئی زبان شامل کرنے کے لیے en فولڈر کاپی کریں، کاپی اور اس کے اندر کی ‎.lang فائل کا نام اپنی زبان کے کوڈ پر رکھیں، اور ہر برابر کے نشان کے دائیں طرف کا متن ترجمہ کریں۔ جو ابھی ترجمہ نہیں ہوا وہ خاموش رہنے کے بجائے انگریزی میں بولا جاتا ہے، اس لیے ادھوری فائل استعمال کرنا محفوظ ہے۔
set_headers_note = بھیجنے والا، بنام، Cc، تاریخ اور موضوع، متن اور HTML دونوں مناظر میں پیغام کے متن کے اوپر دکھائے جاتے ہیں۔ اس کے بغیر ٹیب بند کر کے فہرست پر واپس گئے بغیر پیغام کے اندر سے یہ جاننے کا کوئی طریقہ نہیں کہ اسے کس نے بھیجا۔ فوکس پھر بھی پیغام کے متن پر آتا ہے؛ ہیڈرز کا حصہ ایک Shift+Tab کے فاصلے پر ہے۔ اگلی بار پیغام کھلنے پر لاگو ہوتا ہے۔
set_zoom_note = کھلے پیغام کے اپنے متن کو، باقی ZBox اور Windows کے اپنے ڈسپلے اسکیلنگ سے الگ، بڑا یا چھوٹا کرتا ہے۔ متن اور HTML دونوں مناظر پر لاگو ہوتا ہے۔ “پڑھنے کا فونٹ” اختیاری طور پر پیغام کے متن کے لیے کوئی خاص فونٹ (مثلاً Consolas، OpenDyslexic) نافذ کرتا ہے؛ عام فونٹ رکھنے کے لیے خالی چھوڑیں۔ منظر مینو میں Ctrl+Shift+= / Ctrl+Shift+- / Ctrl+Shift+0 یہ ڈائیلاگ کھولے بغیر صرف فونٹ کا سائز بڑھاتے، گھٹاتے یا بحال کرتے ہیں، اور ہر کھلے پیغام پر فوراً لاگو ہوتے ہیں۔ یہاں کی گئی تبدیلیاں بھی OK دبانے پر فوراً لاگو ہوتی ہیں۔
set_view_note = HTML پہلے سے طے شدہ ہے۔ یہ پیغام کو ویسا ہی دکھاتا ہے جیسا بھیجا گیا تھا، اور NVDA اور JAWS اسے پڑھتے ہیں: جب کوئی HTML صفحہ کھلتا ہے تو ZBox براؤزر کا اپنا اعلان خاموش کرتا ہے، پڑھنے کا کرسر پیغام کی پہلی سطر پر رکھتا ہے، اور ZBox کے اپنے شارٹ کٹس صفحے کے اندر کام کرتے رکھتا ہے، بشمول F6 جو فوکس کو اس سے باہر لے جاتا ہے۔ متن وہی پیغام ایک عام ترمیمی کنٹرول میں سادہ، بغیر فارمیٹنگ کے متن کے طور پر دکھاتا ہے -- نہ تصاویر، نہ ترتیب، اور نصب شدہ براؤزر انجن پر کوئی انحصار نہیں۔ کھلے پیغام کے اندر دونوں میں تبدیل کرنے کے لیے Ctrl+B دبائیں۔
set_engine_note = Edge جدید CSS رینڈر کرتا ہے لیکن صفحہ الگ پروسیس میں چلاتا ہے، اور اپنا مواد اسکرین ریڈر کو صرف ایسے انٹرفیس کے ذریعے دیتا ہے جس تک wxPython نہیں پہنچ سکتا -- اس لیے پیغام ایسے کھل سکتا ہے کہ اس میں پڑھنے کے قابل کچھ نہ ہو۔ پرانا MSHTML وہ انجن ہے جو Outlook Express اور Windows Mail استعمال کرتے تھے: یہ اسی پروسیس میں چلتا ہے اور عام دستاویزی درخت شائع کرتا ہے، اس لیے NVDA اور JAWS اسے کسی بھی ویب صفحے کی طرح براؤز موڈ میں پڑھتے ہیں۔ اگلی بار پیغام کھلنے پر لاگو ہوتا ہے۔
set_runtime_note = سسٹم کا رن ٹائم Windows Update کے ذریعے برقرار رکھا جاتا ہے، اس لیے آپ کی میل پڑھنے والا انجن بغیر اطلاع بدل سکتا ہے — یوں ایک کام کرتا ہوا HTML پیغام منظر ایسی مشین پر خراب ہو سکتا ہے جہاں ZBox میں کچھ نہیں بدلا۔ deps فولڈر میں شامل نقل بالکل وہی ورژن مقرر کرتی ہے جس پر ZBox کی جانچ کی گئی تھی۔ اسے نصب کرنے کے لیے tools\get_webview2.bat چلائیں۔ اگر کوئی شامل نقل موجود نہ ہو تو ZBox بہرحال سسٹم کا رن ٹائم استعمال کرتا ہے، اس لیے یہ ہمیشہ شروع ہوتا ہے۔ ZBox اگلی بار شروع ہونے پر لاگو ہوتا ہے۔
set_sr_intro = پیغام کھلتے وقت ZBox آپ کے اسکرین ریڈر کو کتنا بولنے دیتا ہے، اور ZBox کے اپنے بولے گئے اعلانات کتنی دیر نظر آتے ہیں۔
set_silence_note = جب کوئی HTML پیغام کھلتا ہے تو ZBox اسکرین ریڈر کے براؤزر اعلان کو خاموش کرنے کے لیے 2 سیکنڈ تک ایک مصنوعی Ctrl دبائے رکھ سکتا ہے۔ پیغام کا موضوع پہلے ہی صفحے کے عنوان کے طور پر استعمال ہوتا ہے، جو base64 URL کو بلند آواز میں پڑھے جانے سے روکتا ہے، لیکن ریڈر پھر بھی پیغام کے آغاز پر کنٹرول اور دستاویز کی قسم کا اعلان کرتا ہے، اس لیے یہ پہلے سے آن ہے۔ بند کرنے کے لیے 0 کریں، یا اگر فالتو گفتگو اب بھی آئے تو بڑھائیں۔
set_focus_delay_note = جب کوئی HTML پیغام لوڈ ہو جاتا ہے تو ZBox اسے واقعی فوکس دینے سے پہلے اتنی دیر انتظار کرتا ہے۔ WebView2 کا صفحہ لوڈ ہونے کی اطلاع دینا اور Windows کا اس صفحے کا رسائی درخت مکمل کرنا ایک ہی لمحہ نہیں؛ بہت جلدی فوکس دینے سے NVDA/JAWS پیغام کے بجائے ایک عمومی “ویب مواد کا صفحہ” اعلان کرتے ہیں، یا کھلنے کے بعد کچھ دیر پیغام کو غیر دستیاب بتاتے ہیں۔ درجہ 1 سو ملی سیکنڈ ہے، درجہ 10 پورا ایک سیکنڈ۔ اگر یہ اب بھی نظر آئے تو بڑھائیں؛ جب کھلنا مستحکم لگے تو تیز تر کھلنے کے لیے گھٹائیں۔
set_announce_note = Ctrl+U اور Ctrl+Shift+U بھیجنے والے کو ایک چھوٹے ڈائیلاگ میں بتاتے ہیں جو خود بند ہو جاتا ہے، کیونکہ اسٹیٹس بار صرف تبھی بولا جاتا ہے جب آپ کے اسکرین ریڈر میں اسٹیٹس بار پڑھنا فعال ہو۔ یہ اس ڈائیلاگ کے کھلا رہنے کا دورانیہ ہے۔ اسے اپنی بولنے کی رفتار کے مطابق رکھیں: بہت کم ہو تو یہ جملے کے بیچ میں بند ہو جاتا ہے، جس سے مقصد فوت ہو جاتا ہے۔ کوئی بھی کلید اسے جلد بند کر دیتی ہے؛ تیر والی کلیدیں اسے کھلا رکھتی ہیں تاکہ آپ دوبارہ پڑھ سکیں۔ 0 کا مطلب ہے کہ یہ کلید کا انتظار کرتا ہے اور کبھی خود بند نہیں ہوتا۔
set_attachment_dir_note = جب پیغام میں ایک سے زیادہ منسلکات ہوں تو “سب محفوظ کریں” انہیں یہاں لکھتا ہے۔ اگر موجود نہ ہو تو خود بخود بن جاتا ہے۔ ایک منسلکہ والا پیغام پہلے کی طرح پوچھتا ہے کہ اسے کہاں محفوظ کیا جائے۔ پہلے سے طے شدہ کے لیے خالی چھوڑیں:\n{path}
set_autosave_note = آپ کے لکھتے وقت کھلا تحریری ٹیب کتنی بار خود کو مسودات میں محفوظ کرتا ہے۔ مسودہ محفوظ کریں (Ctrl+S) بہرحال مانگنے پر محفوظ کرتا ہے، اور غیر محفوظ تحریر والا ٹیب بند کرنے پر ہمیشہ اسے محفوظ کرنے کی پیشکش ہوتی ہے۔ 0 خودکار محفوظ کاری بند کرتا ہے۔ 15 سیکنڈ سے کم کی پیشکش نہیں کی جاتی -- یہ آپ کی ٹائپنگ سے مقابلہ کرتا سرور کا چکر ہو گا۔
set_auto_purge_note = ردی کی ٹوکری اور جنک میں اتنے دن پڑے رہنے کے بعد پیغامات کو مستقل طور پر ہٹا دیتا ہے -- وہی مستقل ہٹانا جو ردی کی ٹوکری خالی کریں اور جنک خالی کریں مانگنے پر کرتے ہیں، ZBox کھلا ہونے پر روزانہ ایک بار خود بخود۔ پہلے سے 30 دن کے ساتھ آن ہے۔ 0 اسے بند کرتا ہے۔ پیغام ہٹ جانے کے بعد اسے کالعدم نہیں کیا جا سکتا۔
set_bare_keys_note = آن ہونے پر، پیغامات کی فہرست میں صرف S، A، J، W یا K دبانے سے فوراً جھنڈا بدلتا ہے، آرکائیو ہوتا ہے، منتخب پیغامات جنک نشان زد ہوتے ہیں (Shift+J انہیں جنک نہیں نشان زد کرتا ہے)، یا انتخاب جس تھریڈ کا حصہ ہے اس کی نگرانی/نظر اندازی ہوتی ہے -- آرکائیو اور جنک نشان زد کرنے کی نہ کوئی تصدیق ہے نہ کالعدم۔ اسے بند کرنے سے S، A، J، W اور K فہرست میں پہلے حرف سے عام نیویگیشن پر واپس آ جاتے ہیں۔ Ctrl+S اور Ctrl+Shift+A بہرحال کام کرتے رہتے ہیں۔ فوراً لاگو ہوتا ہے۔
set_sounds_note = پیش رفت، نئے پیغامات، بھیجنے، جواب دینے یا آگے بھیجنے کے اعمال، حذف کرنے اور تلاش کے نتائج کے لیے مختصر آوازیں۔ بند ہونے پر ایپ کی تمام آوازیں بند ہو جاتی ہیں؛ اسکرین ریڈر اور اسٹیٹس بار کے اعلانات بہرحال متاثر نہیں ہوتے۔
set_desktop_notifications_note = نئی میل کی ہر کھیپ کے لیے ایک Windows اطلاع، اوپر والی آواز سے الگ۔ بند ہونے پر تمام اکاؤنٹس کے لیے بند ہو جاتی ہے؛ کسی ایک اکاؤنٹ کو اکاؤنٹ کی ترتیبات میں الگ سے بھی خاموش کیا جا سکتا ہے۔
set_theme_note = حسبِ منشا تھیمز ZBox کے sounds فولڈر کے اندر رکھے گئے فولڈرز ہیں، ہر ایک کی اپنی progress-tick.wav، incoming-message.wav، action-done.wav، delete.wav، searching.wav، searching_done.wav اور none_found.wav فائلیں ہوتی ہیں۔ تھیم کی کوئی فائل غائب ہو تو پہلے سے طے شدہ آواز استعمال ہوتی ہے۔
set_theme_note_only_default = حسبِ منشا تھیمز ZBox کے sounds فولڈر کے اندر رکھے گئے فولڈرز ہیں، ہر ایک کی اپنی progress-tick.wav، incoming-message.wav، action-done.wav، delete.wav، searching.wav، searching_done.wav اور none_found.wav فائلیں ہوتی ہیں۔ تھیم کی کوئی فائل غائب ہو تو پہلے سے طے شدہ آواز استعمال ہوتی ہے۔ جب تک آپ کوئی اور تھیم فولڈر شامل نہ کریں، صرف “default” دستیاب ہے۔
set_lock_note = ZBox شروع ہونے پر کوئی بھی اکاؤنٹ کھولنے سے پہلے آپ کے لاک کھولنے کے طریقوں میں سے ایک مانگتا ہے۔ کوئی بھی ایک کافی ہے: پاس کی، سکیورٹی کی، یا ماسٹر پاس ورڈ۔ ٹرے میں بند کرنا باہر نکلنا نہیں اور دوبارہ مقفل نہیں کرتا؛ فائل > باہر نکلیں اور ٹرے آئیکن کا بند کریں باہر نکلنا ہیں۔ اگر کچھ رجسٹرڈ نہ ہو اور کوئی ماسٹر پاس ورڈ مقرر نہ ہو تو آپ کو اپنی ہی میل سے باہر رکھنے کے بجائے لاک چھوڑ دیا جاتا ہے۔
set_security_note = تینوں میں سے صرف ماسٹر پاس ورڈ ہی کچھ خفیہ کرتا ہے: یہی اس فولڈر کو کسی دوسرے کمپیوٹر پر محفوظ شدہ اکاؤنٹ پاس ورڈز کھولنے دیتا ہے۔ پاس کی یا سکیورٹی کی اس کمپیوٹر پر ایپ کا لاک کھولتی ہے۔ ان میں سے کوئی بھی ایسے کمپیوٹر پر ماسٹر پاس ورڈ کی جگہ نہیں لیتی جہاں ZBox پہلے استعمال نہ ہوا ہو۔
set_minimize_note = ZBox کو چھوٹا کرنے سے اس کا ٹاسک بار بٹن چھپ جاتا ہے اور یہ ٹرے آئیکن کے پیچھے چلتا رہتا ہے۔ ونڈو واپس لانے کے لیے ٹرے آئیکن پر بایاں کلک کریں (یا جب اس پر کی بورڈ فوکس ہو تو Enter/Space دبائیں)۔
set_close_note = ونڈو کا بند کریں بٹن، Alt+F4، اور میل ٹیب پر دبایا گیا Ctrl+W، ZBox کو بند کرنے کے بجائے ٹرے میں چھپا دیتے ہیں۔ فائل > باہر نکلیں (Ctrl+Shift+Q) اور ٹرے آئیکن کا اپنا بند کریں آئٹم بہرحال ZBox کو واقعی بند کرتے ہیں، اس لیے ٹرے کو چھوئے بغیر باہر نکلنے کا کی بورڈ کا ایک راستہ ہمیشہ موجود رہتا ہے۔
set_stay_maximized_note = ZBox بڑا ہو کر کھلتا ہے اور اگر آپ اسے چھوٹا کریں تو دوبارہ بڑا ہو جاتا ہے۔ مینو بار، ٹائٹل بار اور ونڈو کا کنارہ متاثر نہیں ہوتے -- یہ بغیر کنارے والا فل اسکرین موڈ نہیں، اس لیے Alt والے تمام مینو شارٹ کٹس کام کرتے رہتے ہیں۔
set_run_at_startup_note = Windows میں سائن ان کرنے پر ZBox خود بخود شروع ہوتا ہے، اپنی ونڈو دکھانے کے بجائے سیدھا ٹرے میں کھلتا ہے۔ فوراً لاگو ہوتا ہے، صرف اگلی بار شروع ہونے پر نہیں۔
set_desktop_shortcut_note = آپ کے ڈیسک ٹاپ پر ZBox کا شارٹ کٹ رکھتا ہے، پہلے سے موجود کی جگہ۔ شارٹ کٹ اس ZBox فولڈر کا بالکل مقام محفوظ کرتا ہے، اس لیے اگر آپ ZBox کو کہیں اور منتقل یا کاپی کریں تو ڈیسک ٹاپ شارٹ کٹ کو اس کی طرف کرنے کے لیے نئی نقل میں اسے دوبارہ دبائیں۔ فوراً لاگو ہوتا ہے اور OK کا انتظار نہیں کرتا۔


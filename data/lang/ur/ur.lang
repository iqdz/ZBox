acct_note_signature = اس اکاؤنٹ سے بھیجے گئے ہر نئے پیغام، جواب اور آگے بھیجے گئے پیغام کے آخر میں "-- " والی سطر کے نیچے شامل ہوتے ہیں۔ دستخط نہ چاہیں تو خالی چھوڑیں۔ دستخط میں ترمیم کریں فارمیٹ شدہ ایڈیٹر کھولتا ہے، جہاں جلی، فہرستیں اور لنکس دستیاب ہیں؛ پھر اوپر والا خانہ اس کے ساتھ جانے والا سادہ متن ورژن رکھتا ہے۔
acct_note_junk = جنک نشان زد کریں پیغامات کو کس اصل فولڈر میں منتقل کرتا ہے۔ "{automatic}" وہی فراہم کنندہ پر مبنی اندازہ استعمال کرتا ہے جو آرکائیو اور ردی کی ٹوکری پہلے سے استعمال کرتے ہیں؛ اسے صرف تب مقرر کریں جب وہ اندازہ غلط ہو یا آپ کے جنک فولڈر کا حسبِ منشا نام ہو۔
acct_note_disable = غیر فعال اکاؤنٹ سے دوبارہ فعال ہونے تک کبھی رابطہ نہیں کیا جاتا -- نہ IDLE، نہ وقفے وقفے سے تازہ کاری، کچھ بھی نہیں۔ یہ درخت میں (غیر فعال) کے نشان کے ساتھ دکھائی دیتا رہتا ہے، اور اس کی پہلے سے ڈاؤن لوڈ شدہ میل آف لائن دستیاب رہتی ہے۔ یہ وہی سوئچ ہے جو اکاؤنٹس > اکاؤنٹ غیر فعال کریں یا اکاؤنٹ کے اپنے سیاقی مینو میں ہے؛ یہ اس تک پہنچنے کی بس ایک اور جگہ ہے۔
acct_note_default = اس اکاؤنٹ کے فولڈرز درخت میں پہلے آتے ہیں، اور نیا پیغام خود بخود اسی سے بھیجا جاتا ہے جب تک ایڈیٹر میں دستی طور پر نہ بدلا جائے۔ اس پر اثر نہیں پڑتا کہ جواب یا آگے بھیجا گیا پیغام کون سا پتہ استعمال کرتا ہے -- وہ پہلے ہی جواب دیے جانے والے پیغام کی پیروی کرتا ہے (اوپر اضافی شناختیں دیکھیں)۔ ہمیشہ بالکل ایک پہلے سے طے شدہ اکاؤنٹ ہوتا ہے، اس لیے موجودہ پر یہ نشان ہٹانا، کسی دوسرے پر لگائے بغیر، اسے نہیں بدلتا -- پہلے سے طے شدہ کسی اور اکاؤنٹ کو دینے کے لیے اس کا خانہ نشان زد کریں۔
acct_note_mute = خاموش کرنا اس اکاؤنٹ کی نئی میل کی آواز، بولا گیا اعلان اور Windows اطلاع روک دیتا ہے، چاہے وہ کسی بھی طرح ترتیب دیے گئے ہوں۔ دوسرے اکاؤنٹس متاثر نہیں ہوتے، اور یہ اب بھی ترتیبات > آواز اور اطلاعات کے مرکزی سوئچز (مجموعی طور پر آوازیں اور ڈیسک ٹاپ اطلاعات) کے تابع ہے۔
wiz_note_app_password = اگر آپ پہلے ہی ZBox کے لیے ایپ پاس ورڈ بنا چکے ہیں تو آگے بڑھنے کے لیے اگلا دبائیں۔
wiz_note_login = لاگ ان کی اسناد۔\nاگر آپ کی لاگ ان ای میل اوپر والے پتے سے مختلف ہے، مثلاً آپ کا فراہم کنندہ اکاؤنٹ login@example.net ہے مگر آپ you@example.org کے طور پر بھیجنا اور وصول کرنا چاہتے ہیں، تو یہاں لاگ ان ای میل درج کریں۔ حسبِ منشا بھیجنے کا پتہ آپ بعد میں اکاؤنٹ کی ترتیبات میں مقرر کر سکتے ہیں۔
wiz_note_servers = سرور کی ترتیبات، ڈومین پہچانے جانے پر پہلے سے بھری ہوئی۔ جو کچھ مختلف ہونا چاہیے اس میں ترمیم کریں۔
wiz_preset_none = اس ڈومین کے لیے کوئی پہلے سے طے شدہ ترتیب نہیں ملی۔ اپنے فراہم کنندہ کی سرور ترتیبات دستی طور پر درج کریں؛ آپ کے فراہم کنندہ کے مدد کے صفحات ان کی فہرست دیتے ہیں۔
ab_note_groups = کسی گروپ کے تمام اراکین ایک ساتھ بھرنے کے لیے تحریر کی ونڈو کے بنام، Cc یا Bcc خانے میں اس گروپ کا نام لکھیں۔
cache_note_intro = یہ صرف ZBox کی مقامی نقلیں ہٹاتے ہیں۔ کسی میل سرور سے کچھ حذف نہیں ہوتا، اور ہٹایا گیا پیغام اگلی بار کھولنے پر دوبارہ ڈاؤن لوڈ ہو جاتا ہے۔
cache_note_age = خودکار صفائی دن میں ایک بار چلتی ہے، جب ZBox میں دس منٹ تک کی بورڈ کی کوئی سرگرمی نہ ہو اور کوئی پیغام کھلا نہ ہو۔ یہ ہر پیغام کی اپنی تاریخ کے حساب سے چلتی ہے، ان پیغامات سمیت جو ابھی آپ کے اکاؤنٹ میں ہیں۔

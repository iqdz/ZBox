select_account_first = Chagua akaunti kwenye mti kwanza.
select_account_or_folder = Chagua akaunti au folda kwanza.
filters_left_behind = Jumbe {count} zililingana na kichujio lakini bado ziko kwenye {folder}.
cache_clear_confirm = Futa akiba ya jumbe za nje ya mtandao kwa akaunti zote?\n\nHii inafuta nakala za ndani za ZBox pekee. Hakuna kinachoondolewa kutoka seva yoyote ya barua pepe, na jumbe hupakuliwa tena unapozihitaji.
account_remove_confirm = Ondoa {name} ({address})?\n\nBarua pepe kwenye seva haifutwi.\nNakala zilizopakuliwa kwenye kompyuta hii zinafutwa.\nNenosiri lililohifadhiwa linafutwa.
folder_delete_confirm = Futa kabisa folda "{folder}" na kila kitu ndani yake kwa {address}?\n\nHii haiwezi kutenduliwa.
empty_trash_confirm = Futa kabisa jumbe zote kwenye tupio la {address}?\n\nHii haiwezi kutenduliwa.
empty_junk_confirm = Futa kabisa jumbe zote kwenye barua taka za {address}?\n\nHii haiwezi kutenduliwa.
sync_select_account = Chagua akaunti (si folda iliyounganishwa) ya kusawazisha kwa matumizi ya nje ya mtandao.
accounts_imported = Akaunti {count} zimeingizwa:\n\n{names}\n\nNywila hazihamishwi kamwe, na hifadhi iliyosimbwa ya nywila ni mahususi kwa akaunti hii ya mtumiaji wa Windows, kwa hivyo kila akaunti iliyoingizwa inahitaji nenosiri lake liwekwe mara moja kupitia Zana > Mipangilio ya akaunti na utambulisho kabla ya kuunganisha.
accounts_import_none = Hakuna akaunti zilizopatikana kwenye faili hii. Mipangilio bado iliingizwa, ikiwa faili ilikuwa nayo.
delete_permanently_confirm_one = Futa ujumbe huu kabisa? Hii inaruka tupio na haiwezi kutenduliwa.
accounts_locked = Nywila za akaunti zilizohifadhiwa ziliandikwa kwenye kompyuta nyingine, kwa hivyo haziwezi kusomwa hapa.\n\nKila akaunti italazimika kuingia tena kwenye seva yake ya barua pepe. Ili kuepuka hilo wakati ujao, weka nenosiri kuu kutoka Mipangilio, Usalama wa programu na data kwenye kompyuta ambapo akaunti tayari zinafanya kazi.
master_password_remove_confirm = Ondoa nenosiri kuu? Nywila za akaunti zilizohifadhiwa zitaweza kusomwa tu kwenye kompyuta hii na akaunti hii ya Windows. Ukinakili ZBox mahali pengine baadaye, kila akaunti italazimika kuingia tena.\n\nLiondoe sasa?
shortcut_offer = Weka njia ya mkato ya ZBox kwenye eneo-kazi?\n\nItaanzisha folda hii ya ZBox:\n{path}\n\nNjia ya mkato inakumbuka eneo hilo hasa. Ukihamisha folda ya ZBox baadaye, fungua Mipangilio, Trei ya mfumo na dirisha, kisha uchague Unda njia ya mkato ya eneo-kazi tena ili kuielekeza mahali papya.
shortcut_created = Njia ya mkato imeundwa:\n{path}


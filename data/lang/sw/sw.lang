# The lock screen and the Unlock Methods dialog: its notes, the name
# a button takes when it is unavailable, and every status line.
unl_note_locked = ZBox imefungwa. Tumia njia yoyote kati ya zilizo hapa chini kuifungua. Kughairi kunafunga ZBox bila kufungua akaunti yoyote.
unl_note_foreign_passkey = Ufunguo wa kufikia uliohifadhiwa na folda hii ni wa kompyuta nyingine, kwa hivyo hauwezi kutumika hapa. Fungua kwa ufunguo wako wa usalama au nenosiri kuu, kisha tumia Mipangilio, Faragha na usalama, Njia za kufungua ili kuweka ufunguo wa kufikia kwenye kompyuta hii.
unl_note_methods = Moja yoyote ya hizi hufungua ZBox wakati kufuli ya programu imewashwa, pamoja na nenosiri kuu. Ufunguo wa kufikia hutumia Windows Hello kwenye kompyuta hii; ufunguo wa usalama ni ufunguo wa FIDO2 wa USB au NFC na hufanya kazi kwenye kompyuta yoyote unayoichomeka.
unl_note_not_encryption = Hizi hufungua programu. Hazisimbi chochote: nenosiri kuu bado ndilo pekee linaloweza kufungua nywila za akaunti zilizohifadhiwa kwenye kompyuta ambayo folda hii haijawahi kutumika. Lazima liwekwe kwanza, na hakuna kati ya hizi kinachoweza kuongezwa hadi hapo.
unl_add_passkey_unavailable = &Ongeza ufunguo wa kufikia (haupatikani)
unl_add_key_unavailable = &Ongeza ufunguo wa usalama (haupatikani)
unl_reassign_unavailable = &Kabidhi upya ufunguo wa kufikia kwenye kompyuta hii (haupatikani)
unl_status_cancelled_passkey = Ufunguo wa kufikia umeghairiwa. ZBox bado imefungwa.
unl_status_cancelled_key = Ufunguo wa usalama umeghairiwa. ZBox bado imefungwa.
unl_status_enter_password = Weka nenosiri kuu.
unl_status_no_master = Hakuna nenosiri kuu lililowekwa, kwa hivyo ufunguo wa kufikia au wa usalama hauwezi kuongezwa bado. Liweke kwa kitufe cha Nenosiri kuu kwenye Mipangilio, Faragha na usalama, kisha urudi hapa. Nenosiri kuu ndilo linalofungua nywila zako za akaunti zilizohifadhiwa kwenye kompyuta nyingine; ufunguo wa kufikia hufungua programu tu kwenye hii moja, kwa hivyo hauwezi kusimama peke yake.
unl_status_unsupported = Windows ya kompyuta hii haitumii funguo za kufikia wala funguo za usalama, kwa hivyo ni nenosiri kuu pekee linaloweza kufungua ZBox hapa.
unl_status_foreign_one = Ufunguo 1 wa kufikia ni wa kompyuta nyingine na hauwezi kufungua ZBox hapa. Kukabidhi upya kunauchukua nafasi kwa ule uliotengenezwa kwenye kompyuta hii.
unl_status_foreign_many = Funguo {count} za kufikia ni za kompyuta nyingine na haziwezi kufungua ZBox hapa. Kukabidhi upya kunazichukua nafasi kwa ule uliotengenezwa kwenye kompyuta hii.
unl_status_foreign_one_no_hello = Ufunguo 1 wa kufikia ni wa kompyuta nyingine na hauwezi kufungua ZBox hapa. Windows Hello haijawekwa hapa, kwa hivyo hauwezi kubadilishwa kwenye kompyuta hii; Ondoa huusahau.
unl_status_foreign_many_no_hello = Funguo {count} za kufikia ni za kompyuta nyingine na haziwezi kufungua ZBox hapa. Windows Hello haijawekwa hapa, kwa hivyo haziwezi kubadilishwa kwenye kompyuta hii; Ondoa huzisahau.
unl_status_no_hello = Windows Hello haijawekwa kwenye kompyuta hii, kwa hivyo ufunguo wa kufikia hauwezi kuongezwa hapa. Ufunguo wa usalama bado unaweza.

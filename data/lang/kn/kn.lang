no_formatting_here = ಇಲ್ಲಿ ಫಾರ್ಮ್ಯಾಟಿಂಗ್ ಇಲ್ಲ, ಸರಳ ಪಠ್ಯ.

# Spelling
nothing_to_check = ಪರಿಶೀಲಿಸಲು ಏನೂ ಇಲ್ಲ.
no_misspellings = ಕಾಗುಣಿತ ದೋಷಗಳಿಲ್ಲ.
spelling_dictionary_unavailable = ಕಾಗುಣಿತ ನಿಘಂಟು ಲಭ್ಯವಿಲ್ಲ.
next_misspelling_first = ಮೊದಲು ಮುಂದಿನ ಕಾಗುಣಿತ ದೋಷವನ್ನು ಬಳಸಿ.
word_added = {word} ಅನ್ನು ನಿಘಂಟಿಗೆ ಸೇರಿಸಲಾಗಿದೆ.
word_not_added = {word} ಅನ್ನು ಸೇರಿಸಲಾಗಲಿಲ್ಲ.
corrections_applied_one = 1 ತಿದ್ದುಪಡಿ ಅನ್ವಯಿಸಲಾಗಿದೆ.
corrections_applied_many = {count} ತಿದ್ದುಪಡಿಗಳನ್ನು ಅನ್ವಯಿಸಲಾಗಿದೆ.
corrections_applied_partly = {total} ರಲ್ಲಿ {applied} ತಿದ್ದುಪಡಿಗಳನ್ನು ಅನ್ವಯಿಸಲಾಗಿದೆ. ಉಳಿದವನ್ನು ತಿರಸ್ಕರಿಸಲಾಗಿದೆ, ಲಾಗ್ ನೋಡಿ.
occurrences_replaced_one = 1 ಸ್ಥಳವನ್ನು ಬದಲಿಸಲಾಗಿದೆ.
occurrences_replaced_many = {count} ಸ್ಥಳಗಳನ್ನು ಬದಲಿಸಲಾಗಿದೆ.

# Reading mail
message_did_not_open = ಸಂದೇಶ ತೆರೆಯಲಿಲ್ಲ. ಸರ್ವರ್ ಪ್ರತಿಕ್ರಿಯಿಸಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಲು Enter ಒತ್ತಿ.
thread_open = ಈ ಥ್ರೆಡ್‌ನಲ್ಲಿ {messages}. ಮುಚ್ಚಲು ಮತ್ತೆ ಒತ್ತಿ.
no_thread_selected = ಯಾವುದೇ ಥ್ರೆಡ್ ಆಯ್ಕೆಯಾಗಿಲ್ಲ.
thread_watched = ಥ್ರೆಡ್ ಅನ್ನು ಗಮನಿಸಲಾಗುತ್ತಿದೆ.
thread_not_watched = ಥ್ರೆಡ್ ಅನ್ನು ಇನ್ನು ಗಮನಿಸಲಾಗುವುದಿಲ್ಲ.
thread_ignored = ಥ್ರೆಡ್ ಅನ್ನು ನಿರ್ಲಕ್ಷಿಸಲಾಗಿದೆ.
thread_not_ignored = ಥ್ರೆಡ್ ಅನ್ನು ಇನ್ನು ನಿರ್ಲಕ್ಷಿಸಲಾಗುವುದಿಲ್ಲ.
none_found = ಏನೂ ಸಿಗಲಿಲ್ಲ.
refreshing_this_folder = ಈ ಫೋಲ್ಡರ್ ಅನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಲಾಗುತ್ತಿದೆ.
refreshing_all_accounts = ಎಲ್ಲಾ ಖಾತೆಗಳನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಲಾಗುತ್ತಿದೆ.
message_view_html = ಸಂದೇಶ ವೀಕ್ಷಣೆ: HTML (ರೆಂಡರ್ ಮಾಡಿದ).
message_view_text = ಸಂದೇಶ ವೀಕ್ಷಣೆ: ಪಠ್ಯ.
html_view_still_loading = ಸಂದೇಶ ಇನ್ನೂ ಲೋಡ್ ಆಗುತ್ತಿದೆ. Escape ಅದನ್ನು ಮುಚ್ಚುತ್ತದೆ.
message_still_opening = ಸಂದೇಶವನ್ನು ತೆರೆಯಲಾಗುತ್ತಿದೆ. ಸರ್ವರ್ ನಿಧಾನವಾಗಿದೆ.
remote_content_blocked = ರಿಮೋಟ್ ವಿಷಯವನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ.
remote_content_unblocked = ರಿಮೋಟ್ ವಿಷಯದ ನಿರ್ಬಂಧ ತೆಗೆಯಲಾಗಿದೆ.
remote_content_already_showing = ಈ ಸಂದೇಶದಲ್ಲಿ ರಿಮೋಟ್ ವಿಷಯ ಈಗಾಗಲೇ ತೋರಿಸಲಾಗುತ್ತಿದೆ.
archived = ಆರ್ಕೈವ್ ಮಾಡಲಾಗಿದೆ.
copied_to_folder = {to_folder} ಗೆ ನಕಲಿಸಲಾಗಿದೆ.
deleted_one = ಸಂದೇಶವನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಲಾಗಿದೆ.
deleted_many = {count} ಸಂದೇಶಗಳನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಲಾಗಿದೆ.
trashed_one = ಸಂದೇಶವನ್ನು ಕಸದ ಬುಟ್ಟಿಗೆ ಸರಿಸಲಾಗಿದೆ.
trashed_many = {count} ಸಂದೇಶಗಳನ್ನು ಕಸದ ಬುಟ್ಟಿಗೆ ಸರಿಸಲಾಗಿದೆ.

# Accounts and new mail
no_account_yet = ಜಿಗಿಯಲು ಇನ್ನೂ ಖಾತೆ ಇಲ್ಲ.
inbox_landed = {name} ಇನ್‌ಬಾಕ್ಸ್.
account_enabled = {name} ಸಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ.
auto_check_paused = {account} ಗಾಗಿ ಸ್ವಯಂಚಾಲಿತ ಪರಿಶೀಲನೆಯನ್ನು ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ.
auto_check_resumed = {account} ಗಾಗಿ ಸ್ವಯಂಚಾಲಿತ ಪರಿಶೀಲನೆ ಆನ್ ಮಾಡಲಾಗಿದೆ.
account_disabled = {name} ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ.
new_mail_one = {name} ಗೆ 1 ಹೊಸ ಸಂದೇಶ.
new_mail_many = {name} ಗೆ {count} ಹೊಸ ಸಂದೇಶಗಳು.
refresh_all_done_one = 1 ಖಾತೆಯನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಲಾಗಿದೆ.
refresh_all_done_many = {count} ಖಾತೆಗಳನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಲಾಗಿದೆ.
refresh_all_done_failures = {count} ಖಾತೆಗಳನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಲಾಗಿದೆ, {failed} ರಿಫ್ರೆಶ್ ಆಗಲಿಲ್ಲ.
refresh_all_done_failures_one = {count} ಖಾತೆಯನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಲಾಗಿದೆ, {failed} ರಿಫ್ರೆಶ್ ಆಗಲಿಲ್ಲ.

# The sender of the message in view
sender_address_copied = {sender}. ವಿಳಾಸ ನಕಲಿಸಲಾಗಿದೆ.
sender_no_address = {sender}. ನಕಲಿಸಲು ವಿಳಾಸ ಇಲ್ಲ.
clipboard_not_opened = {sender}. ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ತೆರೆಯಲಾಗಲಿಲ್ಲ.

# The signature editor
signature_page_formatted = ಫಾರ್ಮ್ಯಾಟ್ ಮಾಡಲಾಗಿದೆ. ಇದನ್ನೇ ಉಳಿಸಲಾಗುತ್ತದೆ.
signature_page_html = HTML ಮೂಲ. ಇದನ್ನೇ ಉಳಿಸಲಾಗುತ್ತದೆ.
signature_page_html_still_wins = ಫಾರ್ಮ್ಯಾಟ್ ಮಾಡಲಾಗಿದೆ. HTML ಮೂಲವನ್ನೇ ಇನ್ನೂ ಉಳಿಸಲಾಗುತ್ತದೆ.

# Background work
phishing_list_updating = ಫಿಶಿಂಗ್ ಪಟ್ಟಿಯನ್ನು ಹಿನ್ನೆಲೆಯಲ್ಲಿ ನವೀಕರಿಸಲಾಗುತ್ತಿದೆ.
cache_cleared = {files} ಕ್ಯಾಶ್ ಫೈಲ್‌ಗಳನ್ನು ತೆರವುಗೊಳಿಸಲಾಗಿದೆ, {size} MB.
hotkeys_diagnostic_on = ಹಾಟ್‌ಕೀ ರೋಗನಿರ್ಣಯ ಆನ್, ಗುರುತಿಸಲಾಗಿದೆ
hotkeys_diagnostic_off = ಹಾಟ್‌ಕೀ ರೋಗನಿರ್ಣಯ ಆಫ್, ಗುರುತು ತೆಗೆಯಲಾಗಿದೆ

# What a bulk action is called, when ZBox says which one just
# finished. These are names, not sentences.
action_archive = ಆರ್ಕೈವ್ ಮಾಡಿ
action_delete = ಅಳಿಸಿ
action_delete_permanently = ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಿ
action_mark_as_junk = ಜಂಕ್ ಎಂದು ಗುರುತಿಸಿ
action_mark_as_not_junk = ಜಂಕ್ ಅಲ್ಲ ಎಂದು ಗುರುತಿಸಿ
action_move_to = ಸರಿಸಿ
action_copy_to = ನಕಲಿಸಿ
action_mark_message = ಸಂದೇಶವನ್ನು ಗುರುತಿಸಿ
action_undo = ರದ್ದುಮಾಡಿ

# Finishing an action on one or more messages. {action} is one of the
# names just above and {to_folder} is one of your own folders.
undo_done_one = {action} ರದ್ದುಮಾಡಲಾಗಿದೆ.
undo_done_many = {count} ಸಂದೇಶಗಳಿಗೆ {action} ರದ್ದುಮಾಡಲಾಗಿದೆ.
junk_marked_one = ಜಂಕ್ ಎಂದು ಗುರುತಿಸಲಾಗಿದೆ.
junk_marked_many = {count} ಸಂದೇಶಗಳನ್ನು ಜಂಕ್ ಎಂದು ಗುರುತಿಸಲಾಗಿದೆ.
junk_no_new_sender = ಯಾವುದೇ ಹೊಸ ಕಳುಹಿಸುವವರನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿಲ್ಲ: ಈಗಾಗಲೇ ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ, ಮೇಲಿಂಗ್ ಪಟ್ಟಿ, ಅಥವಾ ನಿಮ್ಮ ಸ್ವಂತ ವಿಳಾಸಗಳಲ್ಲಿ ಒಂದು.
not_junk_marked_one = ಜಂಕ್ ಅಲ್ಲ ಎಂದು ಗುರುತಿಸಲಾಗಿದೆ.
not_junk_marked_many = {count} ಸಂದೇಶಗಳನ್ನು ಜಂಕ್ ಅಲ್ಲ ಎಂದು ಗುರುತಿಸಲಾಗಿದೆ.
moved_to_one = {to_folder} ಗೆ ಸರಿಸಲಾಗಿದೆ.
moved_to_many = {count} ಸಂದೇಶಗಳನ್ನು {to_folder} ಗೆ ಸರಿಸಲಾಗಿದೆ.
copied_to_many = {count} ಸಂದೇಶಗಳನ್ನು {to_folder} ಗೆ ನಕಲಿಸಲಾಗಿದೆ.
marked_read = ಓದಿದೆ ಎಂದು ಗುರುತಿಸಲಾಗಿದೆ.
marked_unread = ಓದಿಲ್ಲ ಎಂದು ಗುರುತಿಸಲಾಗಿದೆ.

# When a run of several messages is stopped or partly fails. {done}
# is the ordinary finished message above, spoken first.
bulk_cancelled = {total} ರಲ್ಲಿ {completed} ನಂತರ ರದ್ದುಗೊಳಿಸಲಾಗಿದೆ. {succeeded} ಯಶಸ್ವಿ, {failed} ವಿಫಲ.
bulk_failed_one = {done} 1 ಸಂದೇಶದಲ್ಲಿ {failed} ವಿಫಲವಾಯಿತು.
bulk_failed_many = {done} {total} ಸಂದೇಶಗಳಲ್ಲಿ {failed} ವಿಫಲವಾದವು.

# Formatting, as it is spoken while writing. The word on the left of
# each format_word line is ZBox's own name for that formatting and is
# never translated; the text on the right is what is said.
format_word_bold = ದಪ್ಪ
format_word_italic = ಇಟಾಲಿಕ್
format_word_strike = ಅಡ್ಡಗೆರೆ
format_word_href = ಲಿಂಕ್
format_word_bullet = ಬುಲೆಟ್ ಪಟ್ಟಿ
format_word_number = ಸಂಖ್ಯೆ ಪಟ್ಟಿ
format_word_quote = ಉಲ್ಲೇಖ
format_word_code = ಕೋಡ್
format_word_heading1 = ಶೀರ್ಷಿಕೆ
format_applied = {formatting} ಅನ್ವಯಿಸಲಾಗಿದೆ.
format_inserted = {formatting} ಸೇರಿಸಲಾಗಿದೆ.
format_not_available = ಸರಳ ಸಂದೇಶ ಮುಖ್ಯ ಭಾಗದಲ್ಲಿ {formatting} ಲಭ್ಯವಿಲ್ಲ.
format_on = {formatting} ಆನ್
format_off = {formatting} ಆಫ್
link_applied = ಲಿಂಕ್ ಅನ್ವಯಿಸಲಾಗಿದೆ.
link_applied_to_selection = ಆಯ್ಕೆಗೆ ಲಿಂಕ್ ಅನ್ವಯಿಸಲಾಗಿದೆ.
plain_body_formatting = ಸರಳ ಸಂದೇಶ ಮುಖ್ಯ ಭಾಗವು ತನ್ನ ಫಾರ್ಮ್ಯಾಟಿಂಗ್ ಅನ್ನು ಟ್ಯಾಗ್‌ಗಳಾಗಿ ತೋರಿಸುತ್ತದೆ.


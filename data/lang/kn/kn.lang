# The explanatory note under each setting. One paragraph, one key.
set_debug_note = ಏನಾದರೂ ತಪ್ಪಾದರೆ ಸಮಸ್ಯೆಗಳನ್ನು ಪತ್ತೆಹಚ್ಚಲು ಡೀಬಗ್ ಲಾಗಿಂಗ್ ಸಹಾಯ ಮಾಡುತ್ತದೆ. ಅದನ್ನು ಆಫ್ ಮಾಡಿದರೆ ಹೊಸ ನಮೂದುಗಳನ್ನು ಬರೆಯಲಾಗುವುದಿಲ್ಲ; ಈಗಿರುವ ಲಾಗ್ ಫೈಲ್‌ಗಳನ್ನು ಅಳಿಸಲಾಗುವುದಿಲ್ಲ. ZBox ಮುಂದಿನ ಬಾರಿ ಪ್ರಾರಂಭವಾದಾಗ ಜಾರಿಗೆ ಬರುತ್ತದೆ.
set_language_note = ZBox ಮುಂದಿನ ಬಾರಿ ಪ್ರಾರಂಭವಾದಾಗ ಜಾರಿಗೆ ಬರುತ್ತದೆ. ಭಾಷಾ ಫೈಲ್‌ಗಳು sounds ಫೋಲ್ಡರ್‌ನ ಪಕ್ಕದಲ್ಲಿರುವ ZBox ನ lang ಫೋಲ್ಡರ್‌ನಲ್ಲಿರುವ ಸರಳ ಪಠ್ಯ ಫೈಲ್‌ಗಳು. ಒಂದನ್ನು ಸೇರಿಸಲು, en ಫೋಲ್ಡರ್ ಅನ್ನು ನಕಲಿಸಿ, ನಕಲಿನ ಮತ್ತು ಅದರೊಳಗಿನ .lang ಫೈಲ್‌ನ ಹೆಸರನ್ನು ನಿಮ್ಮ ಭಾಷಾ ಕೋಡ್‌ಗೆ ಬದಲಿಸಿ, ಮತ್ತು ಪ್ರತಿ ಸಮಾನ ಚಿಹ್ನೆಯ ಬಲಭಾಗದ ಪಠ್ಯವನ್ನು ಅನುವಾದಿಸಿ. ಇನ್ನೂ ಅನುವಾದವಾಗದ್ದನ್ನು ಮೌನವಾಗಿರುವ ಬದಲು ಇಂಗ್ಲಿಷ್‌ನಲ್ಲಿ ಹೇಳಲಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ಅರ್ಧ ಪೂರ್ಣಗೊಂಡ ಫೈಲ್ ಬಳಸಲು ಸುರಕ್ಷಿತ.
set_headers_note = ಇವರಿಂದ, ಇವರಿಗೆ, ನಕಲು, ದಿನಾಂಕ ಮತ್ತು ವಿಷಯ, ಪಠ್ಯ ಮತ್ತು HTML ಎರಡೂ ವೀಕ್ಷಣೆಯಲ್ಲಿ ಸಂದೇಶ ಮುಖ್ಯ ಭಾಗದ ಮೇಲೆ ತೋರಿಸಲಾಗುತ್ತದೆ. ಅದಿಲ್ಲದಿದ್ದರೆ ಟ್ಯಾಬ್ ಮುಚ್ಚಿ ಪಟ್ಟಿಗೆ ಹಿಂತಿರುಗದೆ ಸಂದೇಶದೊಳಗಿನಿಂದ ಯಾರು ಕಳುಹಿಸಿದರು ಎಂದು ತಿಳಿಯಲು ಮಾರ್ಗವಿಲ್ಲ. ಫೋಕಸ್ ಇನ್ನೂ ಸಂದೇಶ ಮುಖ್ಯ ಭಾಗದಲ್ಲಿಯೇ ಇಳಿಯುತ್ತದೆ; ಹೆಡರ್ ಬ್ಲಾಕ್ ಒಂದು Shift+Tab ದೂರದಲ್ಲಿದೆ. ಸಂದೇಶ ಮುಂದಿನ ಬಾರಿ ತೆರೆದಾಗ ಜಾರಿಗೆ ಬರುತ್ತದೆ.
set_zoom_note = ತೆರೆದ ಸಂದೇಶದ ಸ್ವಂತ ಪಠ್ಯವನ್ನು ZBox ನ ಉಳಿದ ಭಾಗದಿಂದ ಮತ್ತು Windows ನ ಸ್ವಂತ ಪ್ರದರ್ಶನ ಮಾಪನದಿಂದ ಸ್ವತಂತ್ರವಾಗಿ ದೊಡ್ಡದಾಗಿ ಅಥವಾ ಚಿಕ್ಕದಾಗಿ ಮಾಡುತ್ತದೆ. ಪಠ್ಯ ಮತ್ತು HTML ಎರಡೂ ವೀಕ್ಷಣೆಗೆ ಅನ್ವಯಿಸುತ್ತದೆ. "ಓದುವ ಅಕ್ಷರ ಶೈಲಿ" ಐಚ್ಛಿಕವಾಗಿ ಸಂದೇಶ ಮುಖ್ಯ ಭಾಗಕ್ಕೆ ನಿರ್ದಿಷ್ಟ ಅಕ್ಷರ ಶೈಲಿಯನ್ನು (ಉದಾ. Consolas, OpenDyslexic) ಬಲವಂತಪಡಿಸುತ್ತದೆ; ಸಾಮಾನ್ಯ ಅಕ್ಷರ ಶೈಲಿ ಉಳಿಸಿಕೊಳ್ಳಲು ಅದನ್ನು ಖಾಲಿ ಬಿಡಿ. ವೀಕ್ಷಿಸಿ ಮೆನುವಿನಲ್ಲಿ Ctrl+Shift+= / Ctrl+Shift+- / Ctrl+Shift+0 ಈ ಸಂವಾದ ತೆರೆಯದೆ ಅಕ್ಷರ ಗಾತ್ರವನ್ನು ಮಾತ್ರ ಹೆಚ್ಚಿಸುತ್ತದೆ, ಕಡಿಮೆ ಮಾಡುತ್ತದೆ ಅಥವಾ ಮರುಹೊಂದಿಸುತ್ತದೆ, ಮತ್ತು ತೆರೆದ ಪ್ರತಿ ಸಂದೇಶಕ್ಕೂ ತಕ್ಷಣ ಅನ್ವಯಿಸುತ್ತದೆ. ಇಲ್ಲಿ ಮಾಡುವ ಬದಲಾವಣೆಗಳು ಸರಿ ಕ್ಲಿಕ್ ಮಾಡಿದಾಗಲೂ ತಕ್ಷಣ ಅನ್ವಯಿಸುತ್ತವೆ.
set_view_note = HTML ಡೀಫಾಲ್ಟ್. ಇದು ಸಂದೇಶವನ್ನು ಕಳುಹಿಸಿದಂತೆಯೇ ತೋರಿಸುತ್ತದೆ, ಮತ್ತು NVDA ಮತ್ತು JAWS ಅದನ್ನು ಓದುತ್ತವೆ: HTML ಪುಟ ತೆರೆದಾಗ, ZBox ಬ್ರೌಸರ್‌ನ ಸ್ವಂತ ಘೋಷಣೆಯನ್ನು ಮೌನಗೊಳಿಸುತ್ತದೆ, ಓದುವ ಕರ್ಸರ್ ಅನ್ನು ಸಂದೇಶದ ಮೊದಲ ಸಾಲಿಗೆ ಇರಿಸುತ್ತದೆ ಮತ್ತು ಪುಟದೊಳಗೆ ZBox ನ ಸ್ವಂತ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳು ಕೆಲಸ ಮಾಡುತ್ತಲೇ ಇರುವಂತೆ ಮಾಡುತ್ತದೆ, ಫೋಕಸ್ ಅನ್ನು ಅದರಿಂದ ಹೊರಗೆ ಸರಿಸುವ F6 ಸೇರಿದಂತೆ. ಪಠ್ಯ ಅದೇ ಸಂದೇಶವನ್ನು ಸಾಮಾನ್ಯ ಸಂಪಾದನೆ ನಿಯಂತ್ರಣದಲ್ಲಿ ಸರಳ, ಫಾರ್ಮ್ಯಾಟ್ ಇಲ್ಲದ ಪಠ್ಯವಾಗಿ ತೋರಿಸುತ್ತದೆ -- ಚಿತ್ರಗಳಿಲ್ಲ, ವಿನ್ಯಾಸವಿಲ್ಲ, ಮತ್ತು ಬ್ರೌಸರ್ ಎಂಜಿನ್ ಸ್ಥಾಪಿತವಾಗಿರುವುದರ ಮೇಲೆ ಅವಲಂಬಿತವಾದ ಏನೂ ಇಲ್ಲ. ಎರಡೂ ದಾರಿಯಲ್ಲಿ ಬದಲಿಸಲು ತೆರೆದ ಸಂದೇಶದಲ್ಲಿ Ctrl+B ಒತ್ತಿ.
set_engine_note = Edge ಆಧುನಿಕ CSS ಅನ್ನು ರೆಂಡರ್ ಮಾಡುತ್ತದೆ ಆದರೆ ಪುಟವನ್ನು ಪ್ರತ್ಯೇಕ ಪ್ರಕ್ರಿಯೆಯಲ್ಲಿ ಚಲಾಯಿಸುತ್ತದೆ, ಮತ್ತು wxPython ತಲುಪಲಾಗದ ಇಂಟರ್‌ಫೇಸ್ ಮೂಲಕ ಮಾತ್ರ ತನ್ನ ವಿಷಯವನ್ನು ಸ್ಕ್ರೀನ್ ರೀಡರ್‌ಗೆ ನೀಡುತ್ತದೆ -- ಆದ್ದರಿಂದ ಸಂದೇಶ ಓದಬಹುದಾದ ಏನೂ ಇಲ್ಲದೆ ತೆರೆಯಬಹುದು. ಹಳೆಯ MSHTML ಎಂದರೆ Outlook Express ಮತ್ತು Windows Mail ಬಳಸಿದ ಎಂಜಿನ್: ಇದು ಅದೇ ಪ್ರಕ್ರಿಯೆಯಲ್ಲಿ ಚಲಿಸುತ್ತದೆ ಮತ್ತು ಸಾಮಾನ್ಯ ದಸ್ತಾವೇಜು ಮರವನ್ನು ಪ್ರಕಟಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ NVDA ಮತ್ತು JAWS ಅದನ್ನು ಯಾವುದೇ ವೆಬ್ ಪುಟದಂತೆ ಬ್ರೌಸ್ ಮೋಡ್‌ನಲ್ಲಿ ಓದುತ್ತವೆ. ಸಂದೇಶ ಮುಂದಿನ ಬಾರಿ ತೆರೆದಾಗ ಜಾರಿಗೆ ಬರುತ್ತದೆ.
set_runtime_note = ಸಿಸ್ಟಮ್-ವ್ಯಾಪಿ ರನ್‌ಟೈಮ್ ಅನ್ನು Windows Update ನಿರ್ವಹಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ನಿಮ್ಮ ಮೇಲ್ ಓದುವ ಎಂಜಿನ್ ಎಚ್ಚರಿಕೆ ಇಲ್ಲದೆ ಬದಲಾಗಬಹುದು — ZBox ಬಗ್ಗೆ ಏನೂ ಬದಲಾಗದ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಕೆಲಸ ಮಾಡುತ್ತಿದ್ದ HTML ಸಂದೇಶ ವೀಕ್ಷಣೆ ಈ ರೀತಿ ಮುರಿಯಬಹುದು. deps ಫೋಲ್ಡರ್‌ನಲ್ಲಿರುವ ಸೇರಿಸಿದ ನಕಲು ZBox ಪರೀಕ್ಷಿಸಿದ ನಿಖರ ಆವೃತ್ತಿಯನ್ನು ಪಿನ್ ಮಾಡುತ್ತದೆ. ಒಂದನ್ನು ಸ್ಥಾಪಿಸಲು tools\get_webview2.bat ಚಲಾಯಿಸಿ. ಸೇರಿಸಿದ ನಕಲು ಇಲ್ಲದಿದ್ದರೆ ZBox ಹೇಗಿದ್ದರೂ ಸಿಸ್ಟಮ್-ವ್ಯಾಪಿ ರನ್‌ಟೈಮ್ ಬಳಸುತ್ತದೆ, ಆದ್ದರಿಂದ ಅದು ಯಾವಾಗಲೂ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ. ZBox ಮುಂದಿನ ಬಾರಿ ಪ್ರಾರಂಭವಾದಾಗ ಜಾರಿಗೆ ಬರುತ್ತದೆ.
set_sr_intro = ಸಂದೇಶ ತೆರೆಯುವಾಗ ZBox ನಿಮ್ಮ ಸ್ಕ್ರೀನ್ ರೀಡರ್ ಅನ್ನು ಎಷ್ಟು ಮಾತನಾಡಲು ಬಿಡುತ್ತದೆ, ಮತ್ತು ಅದರ ಸ್ವಂತ ಮಾತಿನ ಘೋಷಣೆಗಳು ಎಷ್ಟು ಕಾಲ ಉಳಿಯುತ್ತವೆ.
set_silence_note = HTML ಸಂದೇಶ ತೆರೆದಾಗ, ಸ್ಕ್ರೀನ್ ರೀಡರ್‌ನ ಬ್ರೌಸರ್ ಘೋಷಣೆಯನ್ನು ಮೌನಗೊಳಿಸಲು ZBox 2 ಸೆಕೆಂಡ್‌ಗಳವರೆಗೆ ಕೃತಕ Ctrl ಒತ್ತಡವನ್ನು ಹಿಡಿದಿಡಬಹುದು. ಸಂದೇಶದ ವಿಷಯವನ್ನು ಈಗಾಗಲೇ ಪುಟ ಶೀರ್ಷಿಕೆಯಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ, ಇದು base64 URL ಓದುವುದನ್ನು ತಡೆಯುತ್ತದೆ, ಆದರೆ ಓದುಗ ಇನ್ನೂ ಸಂದೇಶದ ಆರಂಭದ ಮೇಲೆ ನಿಯಂತ್ರಣ ಮತ್ತು ದಸ್ತಾವೇಜು ಪ್ರಕಾರವನ್ನು ಘೋಷಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ಇದು ಡೀಫಾಲ್ಟ್ ಆಗಿ ಆನ್ ಇದೆ. ಅದನ್ನು ಆಫ್ ಮಾಡಲು ಆಫ್ ಆಯ್ಕೆಮಾಡಿ, ಅಥವಾ ಮಾತು ಇನ್ನೂ ನುಸುಳಿದರೆ ಹೆಚ್ಚಿನ ಸಮಯವನ್ನು ಆರಿಸಿ.
set_focus_delay_note = HTML ಸಂದೇಶ ಲೋಡ್ ಮುಗಿದಾಗ, ಅದಕ್ಕೆ ನಿಜವಾಗಿ ಫೋಕಸ್ ನೀಡುವ ಮೊದಲು ZBox ಇಷ್ಟು ಸಮಯ ಕಾಯುತ್ತದೆ. WebView2 ಪುಟ ಲೋಡ್ ಆಗಿದೆ ಎಂದು ವರದಿ ಮಾಡುವುದು ಮತ್ತು Windows ಆ ಪುಟದ ಪ್ರವೇಶಸಾಧ್ಯತೆ ಮರವನ್ನು ಮುಗಿಸುವುದು ಒಂದೇ ಕ್ಷಣವಲ್ಲ; ತುಂಬಾ ಬೇಗ ಫೋಕಸ್ ಮಾಡಿದರೆ NVDA/JAWS ಸಂದೇಶದ ಬದಲು ಸಾಮಾನ್ಯ "ವೆಬ್ ವಿಷಯ ಪುಟ" ಘೋಷಿಸುತ್ತವೆ, ಅಥವಾ ತೆರೆದ ಸ್ವಲ್ಪ ಸಮಯ ಸಂದೇಶ ಲಭ್ಯವಿಲ್ಲ ಎಂದು ವರದಿ ಮಾಡುತ್ತವೆ. ಆಯ್ಕೆಗಳು 0.1 ಸೆಕೆಂಡ್‌ನಿಂದ 1 ಸೆಕೆಂಡ್‌ವರೆಗೆ ಇವೆ. ಇದು ಇನ್ನೂ ಕೇಳಿದರೆ ಹೆಚ್ಚಿನ ಸಮಯವನ್ನು, ತೆರೆಯುವುದು ಸ್ಥಿರವೆನಿಸಿದರೆ ಕಡಿಮೆ ಸಮಯವನ್ನು ಆರಿಸಿ, ವೇಗವಾದ ತೆರೆಯುವಿಕೆಗಾಗಿ.
set_announce_note = ಸ್ಟೇಟಸ್ ಬಾರ್ ಅನ್ನು ನಿಮ್ಮ ಸ್ಕ್ರೀನ್ ರೀಡರ್‌ನಲ್ಲಿ ಸ್ಟೇಟಸ್-ಬಾರ್ ವರದಿ ಆನ್ ಆಗಿದ್ದರೆ ಮಾತ್ರ ಓದಲಾಗುವುದರಿಂದ, Ctrl+U ಮತ್ತು Ctrl+Shift+U ಕಳುಹಿಸುವವರನ್ನು ತಾನೇ ಮುಚ್ಚಿಕೊಳ್ಳುವ ಸಣ್ಣ ಸಂವಾದದಲ್ಲಿ ವರದಿ ಮಾಡುತ್ತವೆ. ಆ ಸಂವಾದ ಎಷ್ಟು ಕಾಲ ಉಳಿಯುತ್ತದೆ ಎಂಬುದು ಇದು. ಅದನ್ನು ನಿಮ್ಮ ಮಾತಿನ ವೇಗಕ್ಕೆ ಹೊಂದಿಸಿ: ತುಂಬಾ ಚಿಕ್ಕದಾದರೆ ವಾಕ್ಯದ ಮಧ್ಯದಲ್ಲಿ ಮುಚ್ಚುತ್ತದೆ, ಇದು ಉದ್ದೇಶವನ್ನು ಹಾಳುಮಾಡುತ್ತದೆ. ಯಾವುದೇ ಕೀ ಅದನ್ನು ಬೇಗ ಮುಚ್ಚುತ್ತದೆ; ಬಾಣದ ಕೀಗಳು ಮತ್ತೆ ಓದಲು ಅದನ್ನು ತೆರೆದಿಡುತ್ತವೆ. ಕೀಗಾಗಿ ಕಾಯುತ್ತದೆ ನೀವು ಒಂದನ್ನು ಒತ್ತುವವರೆಗೆ ಅದನ್ನು ತೆರೆದಿಡುತ್ತದೆ.
set_attachment_dir_note = ಸಂದೇಶದಲ್ಲಿ ಒಂದಕ್ಕಿಂತ ಹೆಚ್ಚು ಲಗತ್ತುಗಳಿದ್ದಾಗ "ಎಲ್ಲವನ್ನೂ ಉಳಿಸಿ" ಲಗತ್ತುಗಳನ್ನು ಎಲ್ಲಿ ಬರೆಯುತ್ತದೆ ಎಂಬುದು. ಇಲ್ಲದಿದ್ದರೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ರಚಿಸಲಾಗುತ್ತದೆ. ಒಂದೇ ಲಗತ್ತಿರುವ ಸಂದೇಶ ಮೊದಲಿನಂತೆಯೇ ಎಲ್ಲಿ ಉಳಿಸಬೇಕು ಎಂದು ಇನ್ನೂ ಕೇಳುತ್ತದೆ. ಡೀಫಾಲ್ಟ್‌ಗೆ ಖಾಲಿ ಬಿಡಿ:\n{path}
set_autosave_note = ನೀವು ಬರೆಯುತ್ತಿರುವಾಗ ತೆರೆದ ಬರೆಯುವ ಟ್ಯಾಬ್ ತನ್ನನ್ನು ಎಷ್ಟು ಬಾರಿ ಕರಡುಗಳಲ್ಲಿ ಉಳಿಸಿಕೊಳ್ಳುತ್ತದೆ ಎಂಬುದು. ಕರಡು ಉಳಿಸಿ (Ctrl+S) ಎರಡೂ ಸಂದರ್ಭದಲ್ಲಿ ಬೇಡಿಕೆಯ ಮೇರೆಗೆ ಉಳಿಸುತ್ತದೆ, ಮತ್ತು ಉಳಿಸದ ಪಠ್ಯವಿರುವ ಟ್ಯಾಬ್ ಮುಚ್ಚುವಾಗ ಅದನ್ನು ಉಳಿಸಲು ಯಾವಾಗಲೂ ಅವಕಾಶ ನೀಡಲಾಗುತ್ತದೆ. ಆಫ್ ಸ್ವಯಂ ಉಳಿಸುವಿಕೆಯನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ. 15 ಸೆಕೆಂಡ್‌ಗಳಿಗಿಂತ ಕಡಿಮೆ ನೀಡಲಾಗುವುದಿಲ್ಲ -- ಅದು ನಿಮ್ಮ ಟೈಪಿಂಗ್‌ನೊಂದಿಗೆ ಸ್ಪರ್ಧಿಸುವ ಸರ್ವರ್ ಸುತ್ತು ಆಗುತ್ತದೆ.
set_auto_purge_note = ಕಸದ ಬುಟ್ಟಿ ಮತ್ತು ಜಂಕ್‌ನಲ್ಲಿರುವ ಸಂದೇಶಗಳು ಇಷ್ಟು ದಿನ ಅಲ್ಲಿದ್ದ ನಂತರ ಅವನ್ನು ಶಾಶ್ವತವಾಗಿ ತೆಗೆದುಹಾಕುತ್ತದೆ -- ಕಸದ ಬುಟ್ಟಿ ಖಾಲಿ ಮಾಡಿ ಮತ್ತು ಜಂಕ್ ಖಾಲಿ ಮಾಡಿ ಬೇಡಿಕೆಯ ಮೇರೆಗೆ ಮಾಡುವ ಅದೇ ಶಾಶ್ವತ ಅಳಿಸುವಿಕೆ, ZBox ತೆರೆದಿರುವಾಗ ದಿನಕ್ಕೆ ಒಮ್ಮೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನಡೆಯುತ್ತದೆ. ಡೀಫಾಲ್ಟ್ ಆಗಿ 30 ದಿನಗಳಿಗೆ ಆನ್ ಇದೆ. ಆಫ್ ಅದನ್ನು ಆಫ್ ಮಾಡುತ್ತದೆ. ಸಂದೇಶ ತೆಗೆದುಹಾಕಿದ ನಂತರ ಇದನ್ನು ರದ್ದುಮಾಡಲಾಗುವುದಿಲ್ಲ.
set_bare_keys_note = ಆನ್ ಇದ್ದಾಗ, ಸಂದೇಶ ಪಟ್ಟಿಯಲ್ಲಿ S, A, J, W ಅಥವಾ K ಅನ್ನು ಒಂಟಿಯಾಗಿ ಒತ್ತಿದರೆ ತಕ್ಷಣ ನಕ್ಷತ್ರವನ್ನು ಬದಲಿಸುತ್ತದೆ, ಆರ್ಕೈವ್ ಮಾಡುತ್ತದೆ, ಆಯ್ದ ಸಂದೇಶಗಳನ್ನು ಜಂಕ್ ಎಂದು ಗುರುತಿಸುತ್ತದೆ (Shift+J ಅವುಗಳನ್ನು ಜಂಕ್ ಅಲ್ಲ ಎಂದು ಗುರುತಿಸುತ್ತದೆ), ಅಥವಾ ಆಯ್ಕೆ ಭಾಗವಾಗಿರುವ ಥ್ರೆಡ್ ಅನ್ನು ಗಮನಿಸುತ್ತದೆ/ನಿರ್ಲಕ್ಷಿಸುತ್ತದೆ -- ಆರ್ಕೈವ್ ಮಾಡಿ ಮತ್ತು ಜಂಕ್ ಎಂದು ಗುರುತಿಸಿ ಗೆ ದೃಢೀಕರಣ ಮತ್ತು ರದ್ದುಮಾಡುವಿಕೆ ಇಲ್ಲ. ಅದನ್ನು ಆಫ್ ಮಾಡಿದರೆ S, A, J, W ಮತ್ತು K ಪಟ್ಟಿಯಲ್ಲಿ ಸಾಮಾನ್ಯ ಮೊದಲ ಅಕ್ಷರದ ನ್ಯಾವಿಗೇಶನ್‌ಗೆ ಮರಳುತ್ತವೆ. Ctrl+S ಮತ್ತು Ctrl+Shift+A ಎರಡೂ ಸಂದರ್ಭದಲ್ಲಿ ಕೆಲಸ ಮಾಡುತ್ತವೆ. ತಕ್ಷಣ ಜಾರಿಗೆ ಬರುತ್ತದೆ.
set_sounds_note = ಪ್ರಗತಿ, ಹೊಸ ಸಂದೇಶಗಳು, ಕಳುಹಿಸಿದ, ಉತ್ತರಿಸಿದ ಅಥವಾ ಫಾರ್ವರ್ಡ್ ಮಾಡಿದ ಕ್ರಿಯೆಗಳು, ಅಳಿಸುವಿಕೆಗಳು ಮತ್ತು ಹುಡುಕಾಟ ಫಲಿತಾಂಶಗಳಿಗಾಗಿ ಚಿಕ್ಕ ಸ್ವರಗಳು. ಆಫ್ ಅಪ್ಲಿಕೇಶನ್‌ನ ಪ್ರತಿ ಧ್ವನಿಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ; ಸ್ಕ್ರೀನ್ ರೀಡರ್ ಮತ್ತು ಸ್ಟೇಟಸ್ ಬಾರ್ ಘೋಷಣೆಗಳು ಯಾವ ರೀತಿಯಲ್ಲೂ ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ.
set_desktop_notifications_note = ಪ್ರತಿ ಹೊಸ ಮೇಲ್ ಗುಂಪಿಗೆ ಒಂದು Windows ಅಧಿಸೂಚನೆ, ಮೇಲಿನ ಧ್ವನಿಯಿಂದ ಪ್ರತ್ಯೇಕ. ಆಫ್ ಅದನ್ನು ಎಲ್ಲಾ ಖಾತೆಗಳಿಗೆ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ; ಒಂದು ಖಾತೆಯನ್ನು ಖಾತೆ ಮತ್ತು ಗುರುತಿನ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ತನ್ನದೇ ಆಗಿ ಮ್ಯೂಟ್ ಮಾಡಲೂ ಬಹುದು.
set_theme_note = ಕಸ್ಟಮ್ ಥೀಮ್‌ಗಳು ZBox ನ sounds ಫೋಲ್ಡರ್‌ನೊಳಗೆ ಇಡುವ ಫೋಲ್ಡರ್‌ಗಳು, ಪ್ರತಿಯೊಂದೂ ತನ್ನದೇ progress-tick.wav, incoming-message.wav, action-done.wav, delete.wav, searching.wav, searching_done.wav ಮತ್ತು none_found.wav ನೀಡುತ್ತದೆ. ಕಾಣೆಯಾದ ಥೀಮ್ ಫೈಲ್ ಡೀಫಾಲ್ಟ್ ಧ್ವನಿಗೆ ಹಿಂತಿರುಗುತ್ತದೆ.
set_theme_note_only_default = ಕಸ್ಟಮ್ ಥೀಮ್‌ಗಳು ZBox ನ sounds ಫೋಲ್ಡರ್‌ನೊಳಗೆ ಇಡುವ ಫೋಲ್ಡರ್‌ಗಳು, ಪ್ರತಿಯೊಂದೂ ತನ್ನದೇ progress-tick.wav, incoming-message.wav, action-done.wav, delete.wav, searching.wav, searching_done.wav ಮತ್ತು none_found.wav ನೀಡುತ್ತದೆ. ಕಾಣೆಯಾದ ಥೀಮ್ ಫೈಲ್ ಡೀಫಾಲ್ಟ್ ಧ್ವನಿಗೆ ಹಿಂತಿರುಗುತ್ತದೆ. ನೀವು ಇನ್ನೊಂದು ಥೀಮ್ ಫೋಲ್ಡರ್ ಸೇರಿಸುವವರೆಗೆ "default" ಮಾತ್ರ ಲಭ್ಯ.
set_lock_note = ZBox ಪ್ರಾರಂಭವಾದಾಗ ಯಾವುದೇ ಖಾತೆ ತೆರೆಯುವ ಮೊದಲು ನಿಮ್ಮ ಅನ್‌ಲಾಕ್ ವಿಧಾನಗಳಲ್ಲಿ ಒಂದನ್ನು ಕೇಳುತ್ತದೆ. ಅವುಗಳಲ್ಲಿ ಯಾವುದಾದರೂ ಒಂದು ಸಾಕು: ಪಾಸ್‌ಕೀ, ಭದ್ರತಾ ಕೀ, ಅಥವಾ ಮಾಸ್ಟರ್ ಪಾಸ್‌ವರ್ಡ್. ಟ್ರೇಗೆ ಮುಚ್ಚುವುದು ನಿರ್ಗಮನವಲ್ಲ ಮತ್ತು ಮತ್ತೆ ಲಾಕ್ ಮಾಡುವುದಿಲ್ಲ; ಫೈಲ್ > ನಿರ್ಗಮಿಸಿ ಮತ್ತು ಟ್ರೇ ಐಕಾನ್‌ನ ನಿರ್ಗಮಿಸಿ ಮಾಡುತ್ತವೆ. ಏನೂ ನೋಂದಾಯಿಸಿಲ್ಲದಿದ್ದರೆ ಮತ್ತು ಮಾಸ್ಟರ್ ಪಾಸ್‌ವರ್ಡ್ ಹೊಂದಿಸದಿದ್ದರೆ, ನಿಮ್ಮ ಸ್ವಂತ ಮೇಲ್‌ನಿಂದ ನಿಮ್ಮನ್ನು ಹೊರಗಿಡುವ ಬದಲು ಲಾಕ್ ಅನ್ನು ಬಿಟ್ಟುಬಿಡಲಾಗುತ್ತದೆ.
set_security_note = ಮೂರರಲ್ಲಿ ಏನನ್ನಾದರೂ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡುವುದು ಮಾಸ್ಟರ್ ಪಾಸ್‌ವರ್ಡ್ ಮಾತ್ರ: ಈ ಫೋಲ್ಡರ್ ಬೇರೆ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಉಳಿಸಿದ ಖಾತೆ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ತೆರೆಯಲು ಅದೇ ಅನುಮತಿಸುತ್ತದೆ. ಪಾಸ್‌ಕೀ ಅಥವಾ ಭದ್ರತಾ ಕೀ ಈ ಒಂದೇ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಅಪ್ಲಿಕೇಶನ್ ಅನ್‌ಲಾಕ್ ಮಾಡುತ್ತವೆ. ZBox ಮೊದಲು ಬಳಸದ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಅವುಗಳಲ್ಲಿ ಯಾವುದೂ ಮಾಸ್ಟರ್ ಪಾಸ್‌ವರ್ಡ್‌ಗೆ ಬದಲಿಯಲ್ಲ.
set_private_mode_note = ಸಂದೇಶಗಳನ್ನು ಸರ್ವರ್‌ನಿಂದ ಓದಲಾಗುತ್ತದೆ ಮತ್ತು ಮೆಮೊರಿಯಲ್ಲಿ ಮಾತ್ರ ಇರಿಸಲಾಗುತ್ತದೆ. ಆಫ್‌ಲೈನ್ ನಕಲುಗಳು, ಉಳಿಸಿದ ಸಂದೇಶಗಳು ಅಥವಾ ಡೀಬಗ್ ಲಾಗ್‌ಗಳನ್ನು ಇರಿಸಲಾಗುವುದಿಲ್ಲ, ಮತ್ತು ತೆರೆದ ಲಗತ್ತುಗಳು ಹಾಗೂ HTML ಮೇಲ್‌ನ ಬ್ರೌಸರ್ ಡೇಟಾವನ್ನು ZBox ಮುಚ್ಚಿದಾಗ ಅಳಿಸಲಾಗುತ್ತದೆ. ಮುಚ್ಚುವುದು ZBox ಪ್ರಾರಂಭಿಸಿದ ಪ್ರತಿ ಪ್ರೋಗ್ರಾಂ ಅನ್ನು ಸಹ ಕೊನೆಗೊಳಿಸುತ್ತದೆ, ಲಗತ್ತನ್ನು ತೋರಿಸುವವುಗಳನ್ನೂ, ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಅನ್ನು ಖಾಲಿ ಮಾಡುತ್ತದೆ, ಮತ್ತು ಖಾಸಗಿ ಮೋಡ್ ಅನ್ನು ಈ ಕಂಪ್ಯೂಟರ್‌ನಿಂದಲೇ ಆನ್ ಮಾಡಿದ್ದರೆ ಹೊರತು ಈ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ನಂಬುವುದನ್ನು ನಿಲ್ಲಿಸುತ್ತದೆ. USB ಡ್ರೈವ್‌ಗಳ ಪಟ್ಟಿ, ಪೇಜ್ ಫೈಲ್ ಮತ್ತು ಆಂಟಿವೈರಸ್ ಹಾಗೂ ನೆಟ್‌ವರ್ಕ್ ಲಾಗ್‌ಗಳಂತಹ ಯಾವುದೇ ಪ್ರೋಗ್ರಾಂ ತೆಗೆಯಲಾಗದ ಕೆಲವು ದಾಖಲೆಗಳನ್ನು Windows ಇನ್ನೂ ಇಟ್ಟುಕೊಳ್ಳುತ್ತದೆ.
title_private_mode = ಖಾಸಗಿ ಮೋಡ್
private_mode_need_master = ಖಾಸಗಿ ಮೋಡ್‌ಗೆ ಮಾಸ್ಟರ್ ಪಾಸ್‌ವರ್ಡ್ ಬೇಕು, ಏಕೆಂದರೆ ನಿಮ್ಮದಲ್ಲದ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ನಿಮ್ಮ ಖಾತೆಗಳನ್ನು ತೆರೆಯುವುದು ಮಾಸ್ಟರ್ ಪಾಸ್‌ವರ್ಡ್ ಮಾತ್ರ. ಮಾಸ್ಟರ್ ಪಾಸ್‌ವರ್ಡ್ ಬಟನ್‌ನಿಂದ ಒಂದನ್ನು ಹೊಂದಿಸಿ, ನಂತರ ಖಾಸಗಿ ಮೋಡ್ ಆನ್ ಮಾಡಿ.
private_mode_enter_master = ಖಾಸಗಿ ಮೋಡ್ ಆನ್ ಮಾಡಲು ಮಾಸ್ಟರ್ ಪಾಸ್‌ವರ್ಡ್ ನಮೂದಿಸಿ.
private_mode_confirm = ಖಾಸಗಿ ಮೋಡ್ ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಅಥವಾ ZBox ಚಲಿಸುವ ಡ್ರೈವ್‌ನಲ್ಲಿ ನಿಮ್ಮ ಮೇಲ್‌ನ ನಕಲುಗಳನ್ನು ಇರಿಸುವುದಿಲ್ಲ. ಅದನ್ನು ಆನ್ ಮಾಡುವುದರಿಂದ ZBox ನ ಆಫ್‌ಲೈನ್ ನಕಲುಗಳು, ಉಳಿಸಿದ ಸಂದೇಶಗಳು, ತೆರೆದ ಲಗತ್ತುಗಳು, HTML ಮೇಲ್‌ನ ಬ್ರೌಸರ್ ಡೇಟಾ ಮತ್ತು ಡೀಬಗ್ ಲಾಗ್‌ಗಳು ಅಳಿಸಲ್ಪಡುತ್ತವೆ. ನಿಮ್ಮ ಮೇಲ್ ಸರ್ವರ್‌ಗಳಲ್ಲಿ ಏನನ್ನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ, ಮತ್ತು ನಿಮ್ಮ ಖಾತೆಗಳು, ಸಂಪರ್ಕಗಳು ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲಾಗುತ್ತದೆ. ಖಾಸಗಿ ಮೋಡ್ ಆನ್ ಮಾಡಬೇಕೇ?
set_minimize_note = ZBox ಅನ್ನು ಕಿರಿದಾಗಿಸಿದರೆ ಅದರ ಟಾಸ್ಕ್‌ಬಾರ್ ಬಟನ್ ಮರೆಯಾಗುತ್ತದೆ ಮತ್ತು ಅದು ಟ್ರೇ ಐಕಾನ್ ಹಿಂದೆ ಚಲಿಸುತ್ತಲೇ ಇರುತ್ತದೆ. ವಿಂಡೋ ಮರಳಿ ತರಲು ಟ್ರೇ ಐಕಾನ್ ಮೇಲೆ ಎಡ ಕ್ಲಿಕ್ ಮಾಡಿ (ಅಥವಾ ಅದಕ್ಕೆ ಕೀಬೋರ್ಡ್ ಫೋಕಸ್ ಇದ್ದಾಗ Enter/Space ಒತ್ತಿ).
set_close_note = ವಿಂಡೋದ ಮುಚ್ಚು ಬಟನ್, Alt+F4, ಮತ್ತು ಮೇಲ್ ಟ್ಯಾಬ್‌ನಲ್ಲಿ Ctrl+W ZBox ಅನ್ನು ನಿರ್ಗಮಿಸುವ ಬದಲು ಟ್ರೇನಲ್ಲಿ ಮರೆಮಾಡುತ್ತವೆ. ಫೈಲ್ > ನಿರ್ಗಮಿಸಿ (Ctrl+Shift+Q) ಮತ್ತು ಟ್ರೇ ಐಕಾನ್‌ನ ಸ್ವಂತ ನಿರ್ಗಮಿಸಿ ಎರಡೂ ಸಂದರ್ಭದಲ್ಲಿ ZBox ಅನ್ನು ನಿಜವಾಗಿ ನಿರ್ಗಮಿಸುತ್ತವೆ, ಆದ್ದರಿಂದ ಟ್ರೇ ಮುಟ್ಟದೆ ನಿರ್ಗಮಿಸಲು ಯಾವಾಗಲೂ ಕೀಬೋರ್ಡ್ ಮಾರ್ಗವಿದೆ.
set_stay_maximized_note = ZBox ಗರಿಷ್ಠವಾಗಿ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ ಮತ್ತು ನೀವು ಗರಿಷ್ಠೀಕರಣ ತೆಗೆದರೆ ಮತ್ತೆ ಗರಿಷ್ಠಗೊಳಿಸಲಾಗುತ್ತದೆ. ಮೆನು ಬಾರ್, ಶೀರ್ಷಿಕೆ ಬಾರ್ ಮತ್ತು ವಿಂಡೋ ಅಂಚು ಪ್ರಭಾವಿತವಾಗುವುದಿಲ್ಲ -- ಇದು ಅಂಚುರಹಿತ ಪೂರ್ಣಪರದೆ ಮೋಡ್ ಅಲ್ಲ, ಆದ್ದರಿಂದ ಪ್ರತಿ Alt-ಕೀ ಮೆನು ಶಾರ್ಟ್‌ಕಟ್ ಕೆಲಸ ಮಾಡುತ್ತಲೇ ಇರುತ್ತದೆ.
set_run_at_startup_note = ನೀವು Windows ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ ZBox ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಪ್ರಾರಂಭಿಸುತ್ತದೆ, ತನ್ನ ವಿಂಡೋ ತೋರಿಸುವ ಬದಲು ನೇರವಾಗಿ ಟ್ರೇನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ. ಮುಂದಿನ ಪ್ರಾರಂಭದವರೆಗೆ ಕಾಯದೆ ತಕ್ಷಣ ಜಾರಿಗೆ ಬರುತ್ತದೆ.
set_desktop_shortcut_note = ನಿಮ್ಮ ಡೆಸ್ಕ್‌ಟಾಪ್‌ನಲ್ಲಿ ZBox ಶಾರ್ಟ್‌ಕಟ್ ಇಡುತ್ತದೆ, ಅಲ್ಲಿ ಈಗಾಗಲೇ ಇರುವುದನ್ನು ಬದಲಾಯಿಸುತ್ತದೆ. ಶಾರ್ಟ್‌ಕಟ್ ಈ ZBox ಫೋಲ್ಡರ್‌ನ ನಿಖರ ಸ್ಥಳವನ್ನು ಸಂಗ್ರಹಿಸುತ್ತದೆ, ಆದ್ದರಿಂದ ನೀವು ZBox ಅನ್ನು ಬೇರೆಡೆ ಸರಿಸಿದರೆ ಅಥವಾ ನಕಲಿಸಿದರೆ, ಡೆಸ್ಕ್‌ಟಾಪ್ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಅಲ್ಲಿಗೆ ತೋರಿಸಲು ಹೊಸ ನಕಲಿನಲ್ಲಿ ಇದನ್ನು ಮತ್ತೆ ಒತ್ತಿ. ತಕ್ಷಣ ಜಾರಿಗೆ ಬರುತ್ತದೆ ಮತ್ತು ಸರಿ ಗಾಗಿ ಕಾಯುವುದಿಲ್ಲ.


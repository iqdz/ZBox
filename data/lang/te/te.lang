format_word_number = సంఖ్యల జాబితా
format_word_quote = ఉల్లేఖనం
format_word_code = కోడ్
format_word_heading1 = శీర్షిక
format_applied = {formatting} వర్తింపజేయబడింది.
format_inserted = {formatting} చేర్చబడింది.
format_not_available = సాదా సందేశ భాగంలో {formatting} అందుబాటులో లేదు.
format_on = {formatting} ఆన్
format_off = {formatting} ఆఫ్
link_applied = లింక్ వర్తింపజేయబడింది.
link_applied_to_selection = ఎంపికకు లింక్ వర్తింపజేయబడింది.

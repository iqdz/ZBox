cache_cleared = {files} కాష్ ఫైళ్లు తొలగించబడ్డాయి, {size} MB.
hotkeys_diagnostic_on = హాట్‌కీల డయాగ్నోస్టిక్ ఆన్, ఎంచుకోబడింది
hotkeys_diagnostic_off = హాట్‌కీల డయాగ్నోస్టిక్ ఆఫ్, ఎంపిక తొలగించబడింది

# What a bulk action is called, when ZBox says which one just
# finished. These are names, not sentences.
action_archive = ఆర్కైవ్
action_delete = తొలగించు
action_delete_permanently = శాశ్వతంగా తొలగించు
action_mark_as_junk = జంక్‌గా గుర్తించు
action_mark_as_not_junk = జంక్ కాదని గుర్తించు
action_move_to = తరలించు
action_copy_to = కాపీ చేయి
action_mark_message = సందేశాన్ని గుర్తించు
action_undo = రద్దు చేయి

# Finishing an action on one or more messages. {action} is one of the
# names just above and {to_folder} is one of your own folders.
undo_done_one = {action} రద్దు చేయబడింది.
undo_done_many = {count} సందేశాలకు {action} రద్దు చేయబడింది.
junk_marked_one = జంక్‌గా గుర్తించబడింది.
junk_marked_many = {count} సందేశాలు జంక్‌గా గుర్తించబడ్డాయి.
junk_no_new_sender = కొత్త పంపినవారు నిరోధించబడలేదు: ఇప్పటికే నిరోధించబడ్డారు, మెయిలింగ్ జాబితా, లేదా మీ స్వంత చిరునామాలలో ఒకటి.
not_junk_marked_one = జంక్ కాదని గుర్తించబడింది.
not_junk_marked_many = {count} సందేశాలు జంక్ కాదని గుర్తించబడ్డాయి.
moved_to_one = {to_folder}కు తరలించబడింది.
moved_to_many = {count} సందేశాలు {to_folder}కు తరలించబడ్డాయి.
copied_to_many = {count} సందేశాలు {to_folder}కు కాపీ చేయబడ్డాయి.
marked_read = చదివినట్లు గుర్తించబడింది.
marked_unread = చదవనట్లు గుర్తించబడింది.

# When a run of several messages is stopped or partly fails. {done}
# is the ordinary finished message above, spoken first.
bulk_cancelled = {total}లో {completed} తర్వాత రద్దు చేయబడింది. {succeeded} విజయవంతమయ్యాయి, {failed} విఫలమయ్యాయి.
bulk_failed_one = {done} 1 సందేశంలో {failed} విఫలమైంది.
bulk_failed_many = {done} {total} సందేశాలలో {failed} విఫలమయ్యాయి.

# Formatting, as it is spoken while writing. The word on the left of

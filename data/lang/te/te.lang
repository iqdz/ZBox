refresh_all_done_failures_one = {count} ఖాతా రిఫ్రెష్ చేయబడింది, {failed} రిఫ్రెష్ కాలేదు.

# The sender of the message in view
sender_address_copied = {sender}. చిరునామా కాపీ చేయబడింది.
sender_no_address = {sender}. కాపీ చేయడానికి చిరునామా లేదు.

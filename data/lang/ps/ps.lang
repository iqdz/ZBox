# The explanatory note under each setting. One paragraph, one key.
set_debug_note = د ډیبګ لاګ د ستونزو په تشخیص کې مرسته کوي که څه ناسم شي. بندول یې د نوو ثبتونو لیکل ودروي؛ شته لاګ فایلونه نه ړنګېږي. ZBox ته په بله پیل کې اغېز کوي.
set_language_note = ZBox ته په بله پیل کې اغېز کوي. د ژبې فایلونه ساده متن فایلونه دي چې د ZBox په lang پوښه کې، د sounds پوښې تر څنګ دي. د یوې ژبې د ورزیاتولو لپاره، en پوښه کاپي کړئ، کاپي او په کې .lang فایل ستاسو د ژبې کوډ ته نوم ورکړئ، او د هرې مساوي نښې ښۍ خوا متن ژباړئ. هر هغه څه چې تر اوسه نه دي ژباړل شوي په خاموشۍ پرېښودو پر ځای په انګلیسي ویل کېږي، نو نیمګړی فایل د کارولو لپاره خوندي دی.
set_headers_note = له، ته، Cc، نیټه او موضوع، د پیغام د متن پورته په متن او HTML دواړو کتنو کې ښودل کېږي. بې له دې، د پیغام دننه نه شي پوهېدای چې چا لېږلی پرته له دې چې ټب وتړئ او لیست ته ستانه شئ. فوکس لا هم د پیغام متن ته ځي؛ د سرلیک بلاک یو Shift+Tab لرې دی. په بل ځل چې پیغام خلاصېږي اغېز کوي.
set_zoom_note = د خلاص پیغام خپل متن لوی یا کوچنی کوي، د ZBox له پاتې برخې او د Windows له خپل ښودلو پیمانې څخه خپلواک. د متن او HTML دواړو کتنو ته پلي کېږي. "د لوستلو فونټ" په اختیاري ډول د پیغام د متن لپاره ځانګړی فونټ مجبوروي (د بېلګې په توګه Consolas، OpenDyslexic)؛ د عادي فونټ ساتلو لپاره یې تش پرېږدئ. په کتنه مېنو کې Ctrl+Shift+= / Ctrl+Shift+- / Ctrl+Shift+0 د دې ډیالوګ خلاصولو پرته یوازې د فونټ اندازه لوړوي، ټيټوي یا بیا ټاکي، او ژر ټولو خلاصو پیغامونو ته پلي کېږي. دلته شوي بدلونونه هم د OK په ټک سم ژر پلي کېږي.
set_view_note = HTML ډیفالټ دی. دا پیغام لکه څنګه چې لېږل شوی ښیي، او د NVDA او JAWS له خوا لوستل کېږي: کله چې د HTML پاڼه خلاصېږي، ZBox د براوزر خپل اعلان غلی کوي، د لوستلو کرسر د پیغام لومړۍ کرښې ته اچوي، او د ZBox خپل شارټکټونه، په کې د F6 چې فوکس له پاڼې بهر ته بېرته راولي، په پاڼه کې کار ورکوي. متن همدا پیغام د ساده، بې بڼې متن په توګه په یو عادي ایډیټ کنټرول کې ښیي -- نه انځورونه، نه ترتیب، او هیڅ داسې څه نه چې د براوزر انجن په نصب بنسټ ولاړ وي. په خلاص پیغام کې Ctrl+B د دواړو لورو لپاره وهئ.
set_engine_note = Edge عصري CSS ښیي خو پاڼه په جلا پروسه کې چلوي، او خپله منځپانګه یوازې د یو انٹرفیس له لارې د سکرین لوستونکي ته ورکوي چې wxPython ورته نه رسېږي -- نو پیغام کېدای شي هیڅ د لوستلو وړ څه پرته خلاص شي. زوړ MSHTML هغه انجن دی چې Outlook Express او Windows Mail یې کاروي: دا په پروسه کې چلېږي او یوه عادي سند ونه خپروي، نو NVDA او JAWS یې د هرې ویب پاڼې په څېر د براوزینګ په حالت کې لولي. په بل ځل چې پیغام خلاصېږي اغېز کوي.
set_runtime_note = د سیستم چلښت د Windows Update له خوا خدمت کېږي، نو هغه انجن چې ستاسو پیغامونه لولي بې خبرتیا بدلېدای شي -- دا هغه ډول دی چې په یوه ماشین کې چې د ZBox په اړه هیڅ نه دي بدل شوي، د HTML پیغام کتنه خرابه شي. په deps پوښه کې ځای پر ځای کاپي هغه دقیقه بڼه ټاکي چې ZBox پرې ازمایل شوی. د نصبولو لپاره tools\get_webview2.bat وچلوئ. که ځای پر ځای کاپي نه وي، ZBox په هر حال د سیستم چلښت کاروي، نو دا تل پیلېږي. ZBox ته په بله پیل کې اغېز کوي.
set_sr_intro = ستاسو سکرین لوستونکی ته څومره اجازه ورکول کېږي چې ووايي پداسې حال کې چې پیغام خلاصېږي، او د ZBox خپل غږیز اعلانونه څومره پاتې کېږي.
set_silence_note = کله چې د HTML پیغام خلاصېږي، ZBox کولای شي تر ۲ ثانیو پورې یو مصنوعي Ctrl ونیسي ترڅو د سکرین لوستونکي د براوزر اعلان غلی کړي. د پیغام موضوع لا دمخه د پاڼې سرلیک په توګه کارول کېږي، چې د base64 URL د لوستلو مخه نیسي، خو لوستونکی لا هم کنټرول او د سند ډول د پیغام پیل ته اعلانوي، نو دا ډیفالټ فعال دی. د بندولو لپاره بند وټاکئ، یا اوږد وخت که لا هم غږ تېرېږي.
set_focus_delay_note = کله چې د HTML پیغام بارول بشپړ شي، ZBox دومره انتظار کوي مخکې له دې چې حقیقتاً فوکس کړي. دا چې WebView2 وايي پاڼه بار شوه او دا چې Windows د هغې پاڼې د لاسرسي ونه بشپړه کړي، یو شان شېبه نه ده؛ ډېر ژر فوکس کول هغه څه دي چې NVDA/JAWS ته د پیغام پر ځای عمومي "Web content page" اعلانوي، یا د خلاصېدو وروسته د یوې مودې لپاره پیغام ناشته راپور ورکوي. انتخابونه له ۰٫۱ ثانیې تر ۱ ثانیې دي. که تاسو لا هم دا اوریئ اوږد وخت وټاکئ، او کله چې خلاصېدل مستحکم احساس شي لنډ وخت د چټک خلاصېدو لپاره.
set_announce_note = Ctrl+U او Ctrl+Shift+U لیږونکی په یوه کوچني ډیالوګ کې راپور کوي چې پخپله بندېږي، ځکه چې د حالت کرښه یوازې هغه وخت ویل کېږي چې ستاسو سکرین لوستونکي د حالت کرښې راپور ورکول فعال وي. دا هغه موده ده چې ډیالوګ پاتې کېږي. دا ستاسو د خبرو له سرعت سره برابر کړئ: که ډېره لنډه وي، د جملې په منځ کې بندېږي، چې موخه ماتوي. هره کیلي یې ژر بندوي؛ د غشو کیلۍ یې خلاص ساتي ترڅو بیا ولولئ. د کیلۍ انتظار یې خلاص ساتي ترڅو تاسو یوه کیلۍ ووهئ.
set_attachment_dir_note = هغه ځای چېرته چې "ټول خوندي کول" ضمیمې لیکي کله چې پیغام له یوې ضمیمې ډېر ولري. که شتون ونه لري په اتومات ډول جوړېږي. هغه پیغام چې یوازې یوه ضمیمه لري لا هم لکه پخوا پوښتنه کوي چې چېرته یې خوندي کړي. د ډیفالټ لپاره یې تش پرېږدئ:\n{path}
set_autosave_note = یو خلاص لیکلو ټب څومره ځله ځان مسودو ته خوندي کوي پداسې حال کې چې تاسو لیکئ. مسوده خوندي کول (Ctrl+S) په هر حال کې د غوښتنې پر مهال خوندي کوي، او هغه ټب بندول چې خوندي نه شوی لیکنه لري تل د خوندي کولو وړاندیز کوي. بند اتومات خوندي کول بندوي. له ۱۵ ثانیو کم نه وړاندیز کېږي -- هغه به د سرور سفر وي چې ستاسو له لیکلو سره سیالي کوي.
set_auto_purge_note = پیغامونه له زباله‌دان او سپیم څخه د تل لپاره لرې کوي کله چې دا شمېر ورځې هلته پاتې وي -- هماغه د تل لپاره لرې کول چې زباله‌دان خالي کول او سپیم خالي کول د غوښتنې پر مهال ترسره کوي، په ورځ کې یو ځل په اتومات ډول چلېږي پداسې حال کې چې ZBox خلاص وي. په ډیفالټ ډول په ۳۰ ورځو فعال دی. بند یې بندوي. کله چې پیغام لرې شي دا نه شي بېرته کېدای.
set_bare_keys_note = کله چې فعال وي، د پیغام په لیست کې یوازې S، A، J، W یا K وهل ژر ستوری بدلوي، آرشیف کوي، ټاکل شوي پیغامونه د سپیم په توګه نښه کوي (Shift+J یې د ناسپیم په توګه نښه کوي)، یا هغه لړۍ چې ټاکنه یې برخه ده څاري/له پامه غورځوي -- آرشیف او د سپیم په توګه نښه کول تایید نه لري او بېرته کول نه لري. دا بندول S، A، J، W او K بېرته عادي لومړي توري د لیست ناوبرۍ ته راګرځوي. Ctrl+S او Ctrl+Shift+A په دواړو حالتونو کې کار کوي. ژر اغېز کوي.
set_sounds_note = د پرمختګ، نوو پیغامونو، لېږل شوو، ځواب شوو یا مخکې لېږل شوو عملونو، ړنګونو او د لټون د پایلو لپاره لنډ غږونه. بند په اپ کې ټول غږونه بندوي؛ د سکرین لوستونکي او د حالت کرښې اعلانونه په دواړو حالتونو کې نه اغېزمن کېږي.

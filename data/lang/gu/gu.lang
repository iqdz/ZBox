[menus]

# The words on the menus.
#
# Not the keys beside them. A shortcut like Ctrl+R is written in
# ZBox's own code and is never read from this file, so nothing here
# can change a shortcut. The ampersand marks the Alt letter; put it
# where you like or leave it out, because ZBox removes it and puts
# the original Alt letter back in brackets after your words. Your own
# folder names are never translated.


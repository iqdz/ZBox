# What a bulk action is called, when ZBox says which one just
# finished. These are names, not sentences.
action_archive = આર્કાઇવ કરો
action_delete = કાઢી નાખો
action_delete_permanently = કાયમ માટે કાઢી નાખો
action_mark_as_junk = જંક તરીકે ચિહ્નિત કરો
action_mark_as_not_junk = જંક નથી એમ ચિહ્નિત કરો
action_move_to = ખસેડો
action_copy_to = કૉપિ કરો
action_mark_message = સંદેશ ચિહ્નિત કરો
action_undo = પૂર્વવત્ કરો

# Finishing an action on one or more messages. {action} is one of the
# names just above and {to_folder} is one of your own folders.
undo_done_one = {action} પૂર્વવત્ થયું.
undo_done_many = {count} સંદેશા માટે {action} પૂર્વવત્ થયું.
junk_marked_one = જંક તરીકે ચિહ્નિત થયો.
junk_marked_many = {count} સંદેશા જંક તરીકે ચિહ્નિત થયા.
junk_no_new_sender = કોઈ નવો મોકલનાર અવરોધાયો નથી: પહેલેથી અવરોધિત, મેઇલિંગ સૂચિ, અથવા તમારાં પોતાનાં સરનામાંમાંથી એક.
not_junk_marked_one = જંક નથી એમ ચિહ્નિત થયો.
not_junk_marked_many = {count} સંદેશા જંક નથી એમ ચિહ્નિત થયા.
moved_to_one = {to_folder} માં ખસેડાયો.
moved_to_many = {count} સંદેશા {to_folder} માં ખસેડાયા.
copied_to_many = {count} સંદેશા {to_folder} માં કૉપિ થયા.
marked_read = વાંચેલા તરીકે ચિહ્નિત.
marked_unread = ન વાંચેલા તરીકે ચિહ્નિત.

# When a run of several messages is stopped or partly fails. {done}
# is the ordinary finished message above, spoken first.
bulk_cancelled = {total} માંથી {completed} પછી રદ કર્યું. {succeeded} સફળ, {failed} નિષ્ફળ.
bulk_failed_one = {done} 1 સંદેશમાંથી {failed} નિષ્ફળ.
bulk_failed_many = {done} {total} સંદેશામાંથી {failed} નિષ્ફળ.


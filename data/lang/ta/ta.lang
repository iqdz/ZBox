filters_left_behind = {count} செய்திகள் வடிகட்டிக்குப் பொருந்தின ஆனால் இன்னும் {folder} இல் உள்ளன.
cache_clear_confirm = அனைத்துக் கணக்குகளுக்கும் இணைப்பில்லா செய்தித் தற்காலிகச் சேமிப்பை அழிக்கலாமா?\n\nஇது ZBox இன் உள்ளூர் நகல்களை மட்டுமே நீக்கும். எந்த அஞ்சல் சேவையகத்திலிருந்தும் எதுவும் அகற்றப்படாது, உங்களுக்குத் தேவைப்படும்போது செய்திகள் மீண்டும் பதிவிறக்கப்படும்.
account_remove_confirm = {name} ({address}) ஐ அகற்றலாமா?\n\nசேவையகத்திலுள்ள அஞ்சல் நீக்கப்படாது.\nஇந்தக் கணினிக்குப் பதிவிறக்கிய நகல்கள் நீக்கப்படும்.\nசேமித்த கடவுச்சொல் நீக்கப்படும்.
folder_delete_confirm = {address} க்கு "{folder}" கோப்புறையையும் அதிலுள்ள அனைத்தையும் நிரந்தரமாக நீக்கலாமா?\n\nஇதைச் செயல்தவிர்க்க முடியாது.
empty_trash_confirm = {address} க்கான குப்பைத் தொட்டியிலுள்ள அனைத்துச் செய்திகளையும் நிரந்தரமாக நீக்கலாமா?\n\nஇதைச் செயல்தவிர்க்க முடியாது.
empty_junk_confirm = {address} க்கான குப்பை அஞ்சலிலுள்ள அனைத்துச் செய்திகளையும் நிரந்தரமாக நீக்கலாமா?\n\nஇதைச் செயல்தவிர்க்க முடியாது.
sync_select_account = இணைப்பில்லா பயன்பாட்டிற்காக ஒத்திசைக்க ஒரு கணக்கைத் (ஒருங்கிணைந்த கோப்புறை அல்ல) தேர்ந்தெடுக்கவும்.
accounts_imported = {count} கணக்குகள் இறக்குமதி செய்யப்பட்டன:\n\n{names}\n\nகடவுச்சொற்கள் ஒருபோதும் ஏற்றுமதி செய்யப்படுவதில்லை, மறையாக்கப்பட்ட கடவுச்சொல் களஞ்சியம் இந்த Windows பயனர் கணக்கிற்கே உரியது, எனவே இறக்குமதி செய்த ஒவ்வொரு கணக்கும் இணைப்பதற்கு முன் கருவிகள் > கணக்கு மற்றும் அடையாள அமைப்புகள் வழியாகத் தனது கடவுச்சொல்லை ஒருமுறை உள்ளிட வேண்டும்.
accounts_import_none = இந்தக் கோப்பில் கணக்குகள் எதுவும் இல்லை. கோப்பில் அமைப்புகள் இருந்தால் அவை இன்னும் இறக்குமதி செய்யப்பட்டன.
delete_permanently_confirm_one = இந்தச் செய்தியை நிரந்தரமாக நீக்கலாமா? இது குப்பைத் தொட்டிக் கோப்புறையைத் தவிர்க்கும், செயல்தவிர்க்க முடியாது.
accounts_locked = சேமித்த கணக்குக் கடவுச்சொற்கள் மற்றொரு கணினியில் எழுதப்பட்டன, எனவே அவற்றை இங்கு படிக்க முடியாது.\n\nஒவ்வொரு கணக்கும் தனது அஞ்சல் சேவையகத்தில் மீண்டும் உள்நுழைய வேண்டும். அடுத்த முறை இதைத் தவிர்க்க, கணக்குகள் ஏற்கனவே செயல்படும் கணினியில் அமைப்புகள், பயன்பாடு மற்றும் தரவுப் பாதுகாப்பு என்பதில் இருந்து முதன்மைக் கடவுச்சொல்லை அமைக்கவும்.
master_password_remove_confirm = முதன்மைக் கடவுச்சொல்லை அகற்றலாமா? சேமித்த கணக்குக் கடவுச்சொற்களை அதன்பின் இந்தக் கணினியிலும் இந்த Windows கணக்கிலும் மட்டுமே படிக்க முடியும். பிறகு ZBox ஐ வேறு இடத்திற்கு நகலெடுத்தால் ஒவ்வொரு கணக்கும் மீண்டும் உள்நுழைய வேண்டும்.\n\nஇப்போது அகற்றலாமா?
shortcut_offer = மேசையில் ZBox குறுக்குவழியை வைக்கலாமா?\n\nஇது இந்த ZBox கோப்புறையைத் தொடங்கும்:\n{path}\n\nகுறுக்குவழி அந்த இடத்தையே நினைவில் வைத்திருக்கும். பிறகு ZBox கோப்புறையை நகர்த்தினால், அமைப்புகள், கணினி தட்டு மற்றும் சாளரம் என்பதைத் திறந்து, புதிய இடத்தைச் சுட்ட மேசைக் குறுக்குவழியை உருவாக்கு என்பதை மீண்டும் தேர்ந்தெடுக்கவும்.
shortcut_created = குறுக்குவழி உருவாக்கப்பட்டது:\n{path}


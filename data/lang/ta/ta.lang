# ZBox interface language file.
#
# To translate ZBox, copy this file, rename it to your language code
# with the same .lang ending -- fr.lang, ar.lang, es.lang -- and put
# it in this same folder. Then change only the text on the right of
# each equals sign. Leave the section names in square brackets and
# the key names on the left exactly as they are: they are what ZBox
# looks the text up by, and translating them makes the line do
# nothing.
#
# Anything in curly braces is filled in by ZBox, so {count} becomes a
# number and {word} becomes a word. Keep every one that appears on a
# line, spelled the same way. You may move them wherever your own
# grammar needs them.
#
# Where a line ends in _one and another ends in _many, they are the
# singular and the plural of the same message. If your language needs
# a different split, write whatever is correct in each: ZBox picks
# _one when the number is exactly one and _many otherwise.
#
# A key you have not translated yet is heard in English rather than
# being silent, so a part-finished file is safe to use and safe to
# share.
#
# Save the file as UTF-8. Lines beginning with a hash are notes and
# are ignored.

[meta]
name = தமிழ்
code = ta
direction = ltr
translator = ZBox
app_version = 2026.09

# Everything ZBox says out loud when an action finishes.
[actions_announcements]

# Writing a message
message_sent = செய்தி அனுப்பப்பட்டது.
draft_saved = வரைவு சேமிக்கப்பட்டது.
signature_inserted = கையொப்பம் செருகப்பட்டது.
signature_none = இந்தக் கணக்கில் கையொப்பம் இல்லை.
signature_saved = கையொப்பம் சேமிக்கப்பட்டது.
signature_not_saved = கையொப்பம் சேமிக்கப்படவில்லை.
pasted_as_quotation = மேற்கோளாக ஒட்டப்பட்டது.
clipboard_empty = கிளிப்போர்டில் எதுவும் இல்லை.
word_count = {words} சொற்கள், {characters} எழுத்துகள்.
report_copied = அறிக்கை நகலெடுக்கப்பட்டது.
compose_tab_needed = அந்தக் கட்டளைக்கு எழுதும் தாவல் தேவை.
attach_file_instead = இழுத்து விட்ட கோப்புகள் செய்தி உரையில் சேர்க்கப்படுவதில்லை. ஒன்றை அனுப்ப கோப்பை இணை என்பதைப் பயன்படுத்தவும்.

# Formatting in the message body
formatting_here = இங்கு வடிவமைப்பு: {formatting}.
no_formatting_here = இங்கு வடிவமைப்பு இல்லை, எளிய உரை.

# Spelling
nothing_to_check = சரிபார்க்க எதுவும் இல்லை.
no_misspellings = எழுத்துப் பிழைகள் இல்லை.
spelling_dictionary_unavailable = எழுத்துப்பிழை அகராதி கிடைக்கவில்லை.
next_misspelling_first = முதலில் அடுத்த எழுத்துப் பிழையைப் பயன்படுத்தவும்.
word_added = {word} அகராதியில் சேர்க்கப்பட்டது.
word_not_added = {word} சேர்க்க முடியவில்லை.
corrections_applied_one = 1 திருத்தம் பயன்படுத்தப்பட்டது.
corrections_applied_many = {count} திருத்தங்கள் பயன்படுத்தப்பட்டன.
corrections_applied_partly = {total} இல் {applied} திருத்தங்கள் பயன்படுத்தப்பட்டன. மீதமுள்ளவை மறுக்கப்பட்டன; பதிவைப் பார்க்கவும்.
occurrences_replaced_one = 1 இடம் மாற்றப்பட்டது.
occurrences_replaced_many = {count} இடங்கள் மாற்றப்பட்டன.

# Reading mail
message_did_not_open = செய்தி திறக்கவில்லை. சேவையகம் பதிலளிக்கவில்லை. மீண்டும் முயல Enter அழுத்தவும்.
thread_open = இந்த இழையில் {messages}. மூட மீண்டும் அழுத்தவும்.
no_thread_selected = இழை எதுவும் தேர்ந்தெடுக்கப்படவில்லை.
thread_watched = இழை கண்காணிக்கப்படுகிறது.
thread_not_watched = இழை இனி கண்காணிக்கப்படாது.
thread_ignored = இழை புறக்கணிக்கப்பட்டது.
thread_not_ignored = இழை இனி புறக்கணிக்கப்படாது.
none_found = எதுவும் கிடைக்கவில்லை.
refreshing_this_folder = இந்தக் கோப்புறையைப் புதுப்பிக்கிறது.
refreshing_all_accounts = அனைத்துக் கணக்குகளையும் புதுப்பிக்கிறது.
message_view_html = செய்தி காட்சி: HTML (வடிவமைத்துக் காட்டப்பட்டது).
message_view_text = செய்தி காட்சி: உரை.
html_view_still_loading = செய்தி இன்னும் ஏற்றப்படுகிறது. Escape அதை மூடும்.
message_still_opening = செய்தியைத் திறக்கிறது. சேவையகம் மெதுவாக உள்ளது.
remote_content_blocked = தொலை உள்ளடக்கம் தடுக்கப்பட்டது.
remote_content_unblocked = தொலை உள்ளடக்கத்தின் தடை நீக்கப்பட்டது.
remote_content_already_showing = இந்தச் செய்தியில் தொலை உள்ளடக்கம் ஏற்கனவே காட்டப்படுகிறது.
archived = காப்பகப்படுத்தப்பட்டது.
copied_to_folder = {to_folder} க்கு நகலெடுக்கப்பட்டது.
deleted_one = செய்தி நிரந்தரமாக நீக்கப்பட்டது.
deleted_many = {count} செய்திகள் நிரந்தரமாக நீக்கப்பட்டன.
trashed_one = செய்தி குப்பைத் தொட்டிக்கு நகர்த்தப்பட்டது.
trashed_many = {count} செய்திகள் குப்பைத் தொட்டிக்கு நகர்த்தப்பட்டன.

# Accounts and new mail
no_account_yet = தாவிச் செல்ல இன்னும் கணக்கு இல்லை.
inbox_landed = {name} இன்பாக்ஸ்.
account_enabled = {name} இயக்கப்பட்டது.
auto_check_paused = {account} க்கான தானியங்கி சரிபார்ப்பு இடைநிறுத்தப்பட்டது.
auto_check_resumed = {account} க்கான தானியங்கி சரிபார்ப்பு இயக்கப்பட்டது.
account_disabled = {name} முடக்கப்பட்டது.
new_mail_one = {name} க்கு 1 புதிய செய்தி.
new_mail_many = {name} க்கு {count} புதிய செய்திகள்.
refresh_all_done_one = 1 கணக்கு புதுப்பிக்கப்பட்டது.
refresh_all_done_many = {count} கணக்குகள் புதுப்பிக்கப்பட்டன.
refresh_all_done_failures = {count} கணக்குகள் புதுப்பிக்கப்பட்டன, {failed} புதுப்பிக்க முடியவில்லை.
refresh_all_done_failures_one = {count} கணக்கு புதுப்பிக்கப்பட்டது, {failed} புதுப்பிக்க முடியவில்லை.

# The sender of the message in view
sender_address_copied = {sender}. முகவரி நகலெடுக்கப்பட்டது.
sender_no_address = {sender}. நகலெடுக்க முகவரி இல்லை.
clipboard_not_opened = {sender}. கிளிப்போர்டைத் திறக்க முடியவில்லை.

# The signature editor
signature_page_formatted = வடிவமைக்கப்பட்டது. இதுவே சேமிக்கப்படும்.
signature_page_html = HTML மூலம். இதுவே சேமிக்கப்படும்.
signature_page_html_still_wins = வடிவமைக்கப்பட்டது. HTML மூலமே இன்னும் சேமிக்கப்படும்.

# Background work
phishing_list_updating = ஃபிஷிங் பட்டியல் பின்னணியில் புதுப்பிக்கப்படுகிறது.
cache_cleared = {files} தற்காலிகச் சேமிப்புக் கோப்புகள் அழிக்கப்பட்டன, {size} MB.
hotkeys_diagnostic_on = சூடான விசை கண்டறிதல் இயக்கப்பட்டது, தேர்ந்தெடுக்கப்பட்டது
hotkeys_diagnostic_off = சூடான விசை கண்டறிதல் முடக்கப்பட்டது, தேர்வு நீக்கப்பட்டது

# What a bulk action is called, when ZBox says which one just
# finished. These are names, not sentences.
action_archive = காப்பகப்படுத்து
action_delete = நீக்கு
action_delete_permanently = நிரந்தரமாக நீக்கு
action_mark_as_junk = குப்பை அஞ்சலாகக் குறி
action_mark_as_not_junk = குப்பை அஞ்சல் அல்ல எனக் குறி
action_move_to = நகர்த்து
action_copy_to = நகலெடு
action_mark_message = செய்தியைக் குறி
action_undo = செயல்தவிர்

# Finishing an action on one or more messages. {action} is one of the
# names just above and {to_folder} is one of your own folders.
undo_done_one = {action} செயல்தவிர்க்கப்பட்டது.
undo_done_many = {count} செய்திகளுக்கான {action} செயல்தவிர்க்கப்பட்டது.
junk_marked_one = குப்பை அஞ்சலாகக் குறிக்கப்பட்டது.
junk_marked_many = {count} செய்திகள் குப்பை அஞ்சலாகக் குறிக்கப்பட்டன.
junk_no_new_sender = புதிய அனுப்புநர் எவரும் தடுக்கப்படவில்லை: ஏற்கனவே தடுக்கப்பட்டவர், அஞ்சல் பட்டியல், அல்லது உங்கள் சொந்த முகவரிகளில் ஒன்று.
not_junk_marked_one = குப்பை அஞ்சல் அல்ல எனக் குறிக்கப்பட்டது.
not_junk_marked_many = {count} செய்திகள் குப்பை அஞ்சல் அல்ல எனக் குறிக்கப்பட்டன.
moved_to_one = {to_folder} க்கு நகர்த்தப்பட்டது.
moved_to_many = {count} செய்திகள் {to_folder} க்கு நகர்த்தப்பட்டன.
copied_to_many = {count} செய்திகள் {to_folder} க்கு நகலெடுக்கப்பட்டன.
marked_read = படித்ததாகக் குறிக்கப்பட்டது.
marked_unread = படிக்காததாகக் குறிக்கப்பட்டது.

# When a run of several messages is stopped or partly fails. {done}
# is the ordinary finished message above, spoken first.
bulk_cancelled = {total} இல் {completed} க்குப் பிறகு ரத்து செய்யப்பட்டது. {succeeded} வெற்றி, {failed} தோல்வி.
bulk_failed_one = {done} 1 செய்தியில் {failed} தோல்வியடைந்தது.
bulk_failed_many = {done} {total} செய்திகளில் {failed} தோல்வியடைந்தன.

# Formatting, as it is spoken while writing. The word on the left of
# each format_word line is ZBox's own name for that formatting and is
# never translated; the text on the right is what is said.
format_word_bold = தடித்த
format_word_italic = சாய்வு
format_word_strike = நடுக்கோடு
format_word_href = இணைப்பு
format_word_bullet = புள்ளிப் பட்டியல்
format_word_number = எண் பட்டியல்
format_word_quote = மேற்கோள்
format_word_code = குறியீடு
format_word_heading1 = தலைப்பு
format_applied = {formatting} பயன்படுத்தப்பட்டது.
format_inserted = {formatting} செருகப்பட்டது.
format_not_available = எளிய செய்தி உடலில் {formatting} கிடைக்காது.
format_on = {formatting} இயக்கம்
format_off = {formatting} முடக்கம்
link_applied = இணைப்பு பயன்படுத்தப்பட்டது.
link_applied_to_selection = தேர்வுக்கு இணைப்பு பயன்படுத்தப்பட்டது.
plain_body_formatting = எளிய செய்தி உடல் தனது வடிவமைப்பைக் குறிச்சொற்களாகக் காட்டும்.

# Reaching either end of a thread
thread_edge_first = இந்த இழையின் முதல் செய்தி. மூட மீண்டும் அழுத்தவும்.
thread_edge_last = இந்த இழையின் கடைசி செய்தி. மூட மீண்டும் அழுத்தவும்.
jump_unified_inbox = ஒருங்கிணைந்த இன்பாக்ஸ்.
remote_none = இந்தச் செய்தியில் தொலை உள்ளடக்கம் இல்லை.
sender_none = இந்தச் செய்தியில் அனுப்புநர் இல்லை.
sender_name_no_address = %s, முகவரி இல்லை
signature_not_switched = கையொப்பம் மாற்றப்படவில்லை. இந்தக் கணக்கின் கையொப்பத்தைச் செருக Ctrl+Shift+S அழுத்தவும்.
signature_removed_no_signature = கையொப்பம் அகற்றப்பட்டது. இந்தக் கணக்கில் ஒன்றும் இல்லை.
signature_switched = கையொப்பம் இந்தக் கணக்கினதாக மாற்றப்பட்டது.
spell_not_replaced = சொல்லை மாற்ற முடியவில்லை.
spell_replaced_with = {word} ஆக மாற்றப்பட்டது.
folder_marked_read = {count} செய்திகள் படித்ததாகக் குறிக்கப்பட்டன.
folder_no_unread = படிக்காத செய்திகள் இல்லை.
threads_all_collapsed = அனைத்து இழைகளும் சுருக்கப்பட்டன.
threads_all_expanded = அனைத்து இழைகளும் விரிக்கப்பட்டன.
upd_percent = {percent} சதவீதம்
upd_download_done = பதிவிறக்கம் முடிந்தது. புதுப்பிப்பைத் தயார் செய்கிறது...
upd_updated_to = ZBox {version} க்குப் புதுப்பிக்கப்பட்டது.
header_copied = நகலெடுக்கப்பட்டது.
headers_copied = அனைத்துத் தலைப்புகளும் நகலெடுக்கப்பட்டன.
identity_copies_updated = இந்த அடையாளத்திற்கான நகலும் மறைநகலும் புதுப்பிக்கப்பட்டன.
signature_switched_identity = கையொப்பம் இந்த அடையாளத்தினதாக மாற்றப்பட்டது.
signature_removed_identity = கையொப்பம் அகற்றப்பட்டது. இந்த அடையாளத்தில் ஒன்றும் இல்லை.
signature_not_switched_identity = கையொப்பம் மாற்றப்படவில்லை. இந்த அடையாளத்தின் கையொப்பத்தைச் செருக Ctrl+Shift+S அழுத்தவும்.
signature_none_identity = இந்த அடையாளத்தில் கையொப்பம் இல்லை.
move_keys_no_selection = முதலில் ஒரு செய்தியைத் தேர்ந்தெடுக்கவும்.

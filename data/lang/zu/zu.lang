# The lock screen and the Unlock Methods dialog: its notes, the name
# a button takes when it is unavailable, and every status line.
unl_note_locked = I-ZBox ikhiyiwe. Sebenzisa noma iyiphi indlela engezansi ukuyivula. Ukukhansela kuvala i-ZBox ngaphandle kokuvula noma iyiphi i-akhawunti.
unl_note_foreign_passkey = Ukhiye wokungena olondolozwe nale folda ungokwekhompyutha elinye, ngakho awukwazi ukusetshenziswa lapha. Vula ngokhiye wakho wokuphepha noma ngephasiwedi enkulu, bese usebenzisa u-Amasethingi, Ukuphepha, Izindlela zokuvula ukusetha ukhiye wokungena kuleli khompyutha.
unl_note_methods = Noma iyiphi kwalezi ivula i-ZBox uma ukhiye wohlelo uvuliwe, kanye nephasiwedi enkulu. Ukhiye wokungena usebenzisa i-Windows Hello kuleli khompyutha; ukhiye wokuphepha ungukhiye we-FIDO2 nge-USB noma i-NFC futhi usebenza kunoma yikuphi ikhompyutha ewufaka kulo.
unl_note_not_encryption = Lezi zivula uhlelo. Aziwubetheli lutho: iphasiwedi enkulu isaba yodwa engavula amaphasiwedi ama-akhawunti alondoloziwe kukhompyutha le folda engakaze isetshenziswe kulo. Kufanele isethwe kuqala, futhi akukho okungengezwa kwalezi uze wenze lokho.
unl_add_passkey_unavailable = &Engeza ukhiye wokungena (akutholakali)
unl_add_key_unavailable = &Engeza ukhiye wokuphepha (akutholakali)
unl_reassign_unavailable = &Nikeza kabusha ukhiye wokungena kuleli khompyutha (akutholakali)
unl_status_cancelled_passkey = Ukhiye wokungena ukhanseliwe. I-ZBox isakhiyiwe.
unl_status_cancelled_key = Ukhiye wokuphepha ukhanseliwe. I-ZBox isakhiyiwe.
unl_status_enter_password = Faka iphasiwedi enkulu.
unl_status_no_master = Ayikho iphasiwedi enkulu esethiwe, ngakho ukhiye wokungena noma ukhiye wokuphepha akakwazi ukwengezwa okwamanje. Setha eyodwa ngenkinobho ethi Iphasiwedi enkulu ku-Amasethingi, Ukuphepha, bese ubuyela lapha. Iphasiwedi enkulu yilokho okuvula amaphasiwedi ama-akhawunti akho alondoloziwe kwelinye ikhompyutha; ukhiye wokungena uvula uhlelo kuleli kuphela, ngakho awukwazi ukuma wodwa.
unl_status_unsupported = I-Windows yaleli khompyutha ayisekeli okhiye bokungena noma okhiye bokuphepha, ngakho iphasiwedi enkulu kuphela engavula i-ZBox lapha.
unl_status_foreign_one = Ukhiye wokungena oyi-1 ungokwekhompyutha elinye futhi awukwazi ukuvula i-ZBox lapha. Ukunikeza kabusha kuwushintshela ngoyedwa owenziwe kuleli khompyutha.
unl_status_foreign_many = Okhiye bokungena abangu-{count} bangokwekhompyutha elinye futhi abakwazi ukuvula i-ZBox lapha. Ukunikeza kabusha kubashintshela ngoyedwa owenziwe kuleli khompyutha.
unl_status_foreign_one_no_hello = Ukhiye wokungena oyi-1 ungokwekhompyutha elinye futhi awukwazi ukuvula i-ZBox lapha. I-Windows Hello ayisethiwe lapha, ngakho akukwazi ukushintshwa kuleli khompyutha; U-Susa uyawukhohlwa.
unl_status_foreign_many_no_hello = Okhiye bokungena abangu-{count} bangokwekhompyutha elinye futhi abakwazi ukuvula i-ZBox lapha. I-Windows Hello ayisethiwe lapha, ngakho abakwazi ukushintshwa kuleli khompyutha; U-Susa uyabakhohlwa.

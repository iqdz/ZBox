filters_left_behind = Imilayezo engu-{count} ifane nesihlungi kodwa isesefolda ethi {folder}.
cache_clear_confirm = Susa i-cache yemilayezo ye-offline yawo wonke ama-akhawunti?\n\nLokhu kususa amakhophi endaweni e-ZBox kuphela. Akukho okususwa kunoma iyiphi iseva yamameyili, futhi imilayezo idawunilodwa futhi njengoba uyidinga.
account_remove_confirm = Susa i-{name} ({address})?\n\nIposi eliseseva alisuswa.\nAmakhophi adawunilodiwe kuleli khompyutha ayasuswa.\nIphasiwedi elondoloziwe iyasuswa.
folder_delete_confirm = Susa unomphela ifolda ethi "{folder}" nakho konke okukuyo kwe-{address}?\n\nLokhu akukwazi ukuhlehliswa.
empty_trash_confirm = Susa unomphela yonke imilayezo kudoti ye-{address}?\n\nLokhu akukwazi ukuhlehliswa.
empty_junk_confirm = Susa unomphela yonke imilayezo ku-Okungafuneki ye-{address}?\n\nLokhu akukwazi ukuhlehliswa.
sync_select_account = Khetha i-akhawunti (hhayi ifolda Ehlanganisiwe) ozoyivumelanisa ukusetshenziswa ngaphandle kwe-inthanethi.
accounts_imported = Ama-akhawunti angu-{count} angeniswe:\n\n{names}\n\nAmaphasiwedi awasoze athunyelwa, futhi indawo egcina amaphasiwedi ebethelwe ikhethekile kule akhawunti yomsebenzisi we-Windows, ngakho i-akhawunti ngayinye engeniswe idinga ukufakwa iphasiwedi kanye nge-Amathuluzi > Amasethingi ama-akhawunti nobuwena ngaphambi kokuthi ixhume.
accounts_import_none = Awekho ama-akhawunti atholakele kuleli fayela. Amasethingi angeniswe nokho, uma ifayela libenawo.
delete_permanently_confirm_one = Susa unomphela lo mlayezo? Lokhu kweqa ifolda kadoti futhi akukwazi ukuhlehliswa.
accounts_locked = Amaphasiwedi ama-akhawunti alondoloziwe abhalwe kwelinye ikhompyutha, ngakho awakwazi ukufundwa lapha.\n\nI-akhawunti ngayinye izodinga ukungena futhi kuseva yayo yamameyili. Ukugwema lokhu ngokuzayo, setha iphasiwedi enkulu ku-Amasethingi, Ukuphepha kohlelo nedatha kukhompyutha lapho ama-akhawunti esevele esebenza khona.
master_password_remove_confirm = Susa iphasiwedi enkulu? Amaphasiwedi ama-akhawunti alondoloziwe azobe esefundeka kuphela kuleli khompyutha nakule akhawunti ye-Windows. Uma ukopisha i-ZBox kwenye indawo ngemuva kwalokho, i-akhawunti ngayinye izodinga ukungena futhi.\n\nYisuse manje?
shortcut_offer = Beka isinqamuleli se-ZBox kudeskithophu?\n\nSizoqalisa le folda ye-ZBox:\n{path}\n\nIsinqamuleli siqopha le ndawo kanye. Uma uthutha ifolda ye-ZBox kamuva, vula Amasethingi, Indawo yezaziso nefasitela bese ukhetha futhi Dala isinqamuleli sedeskithophu ukusikhomba endaweni entsha.
shortcut_created = Isinqamuleli sidaliwe:\n{path}


# ZBox interface language file.
#
# To translate ZBox, copy this file, rename it to your language code
# with the same .lang ending -- fr.lang, ar.lang, es.lang -- and put
# it in this same folder. Then change only the text on the right of
# each equals sign. Leave the section names in square brackets and
# the key names on the left exactly as they are: they are what ZBox
# looks the text up by, and translating them makes the line do
# nothing.
#
# Anything in curly braces is filled in by ZBox, so {count} becomes a
# number and {word} becomes a word. Keep every one that appears on a
# line, spelled the same way. You may move them wherever your own
# grammar needs them.
#
# Where a line ends in _one and another ends in _many, they are the
# singular and the plural of the same message. If your language needs
# a different split, write whatever is correct in each: ZBox picks
# _one when the number is exactly one and _many otherwise.
#
# A key you have not translated yet is heard in English rather than
# being silent, so a part-finished file is safe to use and safe to
# share.
#
# Save the file as UTF-8. Lines beginning with a hash are notes and
# are ignored.

[meta]
name = বাংলা
code = bn
direction = ltr
translator = ZBox
app_version = 2026.09

# Everything ZBox says out loud when an action finishes.
[actions_announcements]

# Writing a message
message_sent = বার্তা পাঠানো হয়েছে।
draft_saved = খসড়া সংরক্ষিত হয়েছে।
signature_inserted = স্বাক্ষর যোগ করা হয়েছে।
signature_none = এই অ্যাকাউন্টের কোনো স্বাক্ষর নেই।
signature_saved = স্বাক্ষর সংরক্ষিত হয়েছে।
signature_not_saved = স্বাক্ষর সংরক্ষিত হয়নি।
pasted_as_quotation = উদ্ধৃতি হিসেবে পেস্ট করা হয়েছে।
clipboard_empty = ক্লিপবোর্ডে কিছু নেই।
word_count = {words}টি শব্দ, {characters}টি অক্ষর।
report_copied = প্রতিবেদন কপি করা হয়েছে।
compose_tab_needed = এই কমান্ডের জন্য একটি লেখার ট্যাব দরকার।
attach_file_instead = ছেড়ে দেওয়া ফাইল বার্তার লেখায় বসানো হয় না। ফাইল পাঠাতে ফাইল সংযুক্ত করুন ব্যবহার করুন।

# Formatting in the message body
formatting_here = এখানের ফরম্যাটিং: {formatting}।
no_formatting_here = এখানে কোনো ফরম্যাটিং নেই, সাধারণ লেখা।

# Spelling
nothing_to_check = যাচাই করার মতো কিছু নেই।
no_misspellings = কোনো বানান ভুল নেই।
spelling_dictionary_unavailable = বানান অভিধান উপলব্ধ নয়।
next_misspelling_first = আগে পরবর্তী বানান ভুল ব্যবহার করুন।
word_added = {word} অভিধানে যোগ করা হয়েছে।
word_not_added = {word} যোগ করা যায়নি।
corrections_applied_one = ১টি সংশোধন প্রয়োগ করা হয়েছে।
corrections_applied_many = {count}টি সংশোধন প্রয়োগ করা হয়েছে।
corrections_applied_partly = {total}টির মধ্যে {applied}টি সংশোধন প্রয়োগ করা হয়েছে। বাকিগুলো প্রত্যাখ্যাত হয়েছে; লগ দেখুন।
occurrences_replaced_one = ১টি জায়গায় প্রতিস্থাপন করা হয়েছে।
occurrences_replaced_many = {count}টি জায়গায় প্রতিস্থাপন করা হয়েছে।

# Reading mail
message_did_not_open = বার্তাটি খোলেনি। সার্ভার সাড়া দেয়নি। আবার চেষ্টা করতে Enter চাপুন।
thread_open = এই থ্রেডে {messages}। বন্ধ করতে আবার চাপুন।
no_thread_selected = কোনো থ্রেড নির্বাচিত নয়।
thread_watched = থ্রেডটি নজরে রাখা হচ্ছে।
thread_not_watched = থ্রেডটি আর নজরে রাখা হচ্ছে না।
thread_ignored = থ্রেডটি উপেক্ষা করা হয়েছে।
thread_not_ignored = থ্রেডটি আর উপেক্ষিত নয়।
none_found = কিছু পাওয়া যায়নি।
refreshing_this_folder = এই ফোল্ডার রিফ্রেশ হচ্ছে।
refreshing_all_accounts = সব অ্যাকাউন্ট রিফ্রেশ হচ্ছে।
message_view_html = বার্তার দৃশ্য: HTML (রেন্ডার করা)।
message_view_text = বার্তার দৃশ্য: লেখা।
html_view_still_loading = বার্তাটি এখনও লোড হচ্ছে। Escape এটি বন্ধ করে।
message_still_opening = বার্তা খোলা হচ্ছে। সার্ভার ধীর।
remote_content_blocked = রিমোট কনটেন্ট অবরুদ্ধ করা হয়েছে।
remote_content_unblocked = রিমোট কনটেন্ট অবরোধমুক্ত করা হয়েছে।
remote_content_already_showing = এই বার্তায় রিমোট কনটেন্ট আগে থেকেই দেখানো হচ্ছে।
archived = আর্কাইভ করা হয়েছে।
copied_to_folder = {to_folder}-এ কপি করা হয়েছে।
deleted_one = বার্তাটি স্থায়ীভাবে মুছে ফেলা হয়েছে।
deleted_many = {count}টি বার্তা স্থায়ীভাবে মুছে ফেলা হয়েছে।
trashed_one = বার্তাটি ট্র্যাশে সরানো হয়েছে।
trashed_many = {count}টি বার্তা ট্র্যাশে সরানো হয়েছে।

# Accounts and new mail
no_account_yet = যাওয়ার মতো এখনও কোনো অ্যাকাউন্ট নেই।
inbox_landed = {name} ইনবক্স।
account_enabled = {name} সক্রিয় করা হয়েছে।
auto_check_paused = {account}-এর স্বয়ংক্রিয় যাচাই বিরতিতে রাখা হয়েছে।
auto_check_resumed = {account}-এর স্বয়ংক্রিয় যাচাই চালু আছে।
account_disabled = {name} নিষ্ক্রিয় করা হয়েছে।
new_mail_one = {name}-এর জন্য ১টি নতুন বার্তা।
new_mail_many = {name}-এর জন্য {count}টি নতুন বার্তা।
refresh_all_done_one = ১টি অ্যাকাউন্ট রিফ্রেশ করা হয়েছে।
refresh_all_done_many = {count}টি অ্যাকাউন্ট রিফ্রেশ করা হয়েছে।
refresh_all_done_failures = {count}টি অ্যাকাউন্ট রিফ্রেশ করা হয়েছে, {failed}টি রিফ্রেশ করা যায়নি।
refresh_all_done_failures_one = {count}টি অ্যাকাউন্ট রিফ্রেশ করা হয়েছে, {failed}টি রিফ্রেশ করা যায়নি।

# The sender of the message in view
sender_address_copied = {sender}। ঠিকানা কপি করা হয়েছে।
sender_no_address = {sender}। কপি করার মতো কোনো ঠিকানা নেই।
clipboard_not_opened = {sender}। ক্লিপবোর্ড খোলা যায়নি।

# The signature editor
signature_page_formatted = ফরম্যাট করা। এটিই সংরক্ষিত হবে।
signature_page_html = HTML উৎস। এটিই সংরক্ষিত হবে।
signature_page_html_still_wins = ফরম্যাট করা। সংরক্ষিত হবে তবুও HTML উৎসই।

# Background work
phishing_list_updating = ফিশিং তালিকা পটভূমিতে হালনাগাদ হচ্ছে।
cache_cleared = {files}টি ক্যাশ ফাইল মুছে ফেলা হয়েছে, {size} MB।
hotkeys_diagnostic_on = হটকি ডায়াগনস্টিক চালু, চেক করা
hotkeys_diagnostic_off = হটকি ডায়াগনস্টিক বন্ধ, আনচেক করা

# What a bulk action is called, when ZBox says which one just
# finished. These are names, not sentences.
action_archive = আর্কাইভ
action_delete = মুছুন
action_delete_permanently = স্থায়ীভাবে মুছুন
action_mark_as_junk = জাঙ্ক হিসেবে চিহ্নিত করুন
action_mark_as_not_junk = জাঙ্ক নয় হিসেবে চিহ্নিত করুন
action_move_to = এখানে সরান
action_copy_to = এখানে কপি করুন
action_mark_message = বার্তা চিহ্নিত করুন
action_undo = পূর্বাবস্থায় ফেরান

# Finishing an action on one or more messages. {action} is one of the
# names just above and {to_folder} is one of your own folders.
undo_done_one = {action} পূর্বাবস্থায় ফেরানো হয়েছে।
undo_done_many = {count}টি বার্তার জন্য {action} পূর্বাবস্থায় ফেরানো হয়েছে।
junk_marked_one = জাঙ্ক হিসেবে চিহ্নিত করা হয়েছে।
junk_marked_many = {count}টি বার্তা জাঙ্ক হিসেবে চিহ্নিত করা হয়েছে।
junk_no_new_sender = কোনো নতুন প্রেরক অবরুদ্ধ হয়নি: আগেই অবরুদ্ধ, একটি মেইলিং তালিকা, অথবা আপনার নিজের কোনো ঠিকানা।
not_junk_marked_one = জাঙ্ক নয় হিসেবে চিহ্নিত করা হয়েছে।
not_junk_marked_many = {count}টি বার্তা জাঙ্ক নয় হিসেবে চিহ্নিত করা হয়েছে।
moved_to_one = {to_folder}-এ সরানো হয়েছে।
moved_to_many = {count}টি বার্তা {to_folder}-এ সরানো হয়েছে।
copied_to_many = {count}টি বার্তা {to_folder}-এ কপি করা হয়েছে।
marked_read = পঠিত হিসেবে চিহ্নিত করা হয়েছে।
marked_unread = অপঠিত হিসেবে চিহ্নিত করা হয়েছে।

# When a run of several messages is stopped or partly fails. {done}
# is the ordinary finished message above, spoken first.
bulk_cancelled = {total}টির মধ্যে {completed}টির পরে বাতিল করা হয়েছে। {succeeded}টি সফল, {failed}টি ব্যর্থ।
bulk_failed_one = {done} ১টির মধ্যে {failed}টি বার্তা ব্যর্থ হয়েছে।
bulk_failed_many = {done} {total}টির মধ্যে {failed}টি বার্তা ব্যর্থ হয়েছে।

# Formatting, as it is spoken while writing. The word on the left of
# each format_word line is ZBox's own name for that formatting and is
# never translated; the text on the right is what is said.
format_word_bold = বোল্ড
format_word_italic = ইটালিক
format_word_strike = স্ট্রাইকথ্রু
format_word_href = লিংক
format_word_bullet = বুলেট তালিকা
format_word_number = সংখ্যাযুক্ত তালিকা
format_word_quote = উদ্ধৃতি
format_word_code = কোড
format_word_heading1 = শিরোনাম
format_applied = {formatting} প্রয়োগ করা হয়েছে।
format_inserted = {formatting} যোগ করা হয়েছে।
format_not_available = সাধারণ বার্তার মূল অংশে {formatting} উপলব্ধ নয়।
format_on = {formatting} চালু
format_off = {formatting} বন্ধ
link_applied = লিংক প্রয়োগ করা হয়েছে।
link_applied_to_selection = নির্বাচিত অংশে লিংক প্রয়োগ করা হয়েছে।
plain_body_formatting = সাধারণ বার্তার মূল অংশ তার ফরম্যাটিং ট্যাগ হিসেবে দেখায়।

# Reaching either end of a thread
thread_edge_first = এই থ্রেডের প্রথম বার্তা। বন্ধ করতে আবার চাপুন।
thread_edge_last = এই থ্রেডের শেষ বার্তা। বন্ধ করতে আবার চাপুন।
jump_unified_inbox = একীভূত ইনবক্স।
remote_none = এই বার্তায় কোনো রিমোট কনটেন্ট নেই।
sender_none = এই বার্তার কোনো প্রেরক নেই।
sender_name_no_address = %s, কোনো ঠিকানা নেই
signature_not_switched = স্বাক্ষর পরিবর্তন হয়নি। এই অ্যাকাউন্টের স্বাক্ষর যোগ করতে Ctrl+Shift+S চাপুন।
signature_removed_no_signature = স্বাক্ষর সরানো হয়েছে। এই অ্যাকাউন্টের কোনো স্বাক্ষর নেই।
signature_switched = স্বাক্ষর এই অ্যাকাউন্টের স্বাক্ষরে পরিবর্তন করা হয়েছে।
spell_not_replaced = শব্দটি প্রতিস্থাপন করা যায়নি।
spell_replaced_with = {word} দিয়ে প্রতিস্থাপন করা হয়েছে।

[main_ui]

# The search tab. {term} is what was typed in.
search_placeholder = ওপরে কিছু লিখুন এবং Enter চাপুন অথবা খুঁজুন নির্বাচন করুন।
search_no_account = আগে একটি অ্যাকাউন্ট যোগ করুন।
search_no_term = খোঁজার জন্য কিছু লিখুন।
search_running = খোঁজা হচ্ছে...
search_none = "{term}"-এর কোনো মিল নেই।
search_found_one = "{term}"-এর ১টি মিল।
search_found_many = "{term}"-এর {count}টি মিল।
search_failed = খোঁজা ব্যর্থ হয়েছে।

# The related messages tab
related_running = খোঁজা হচ্ছে...
related_none = কোনো সম্পর্কিত বার্তা পাওয়া যায়নি।
related_found_one = ১টি সম্পর্কিত বার্তা পাওয়া গেছে।
related_found_many = {count}টি সম্পর্কিত বার্তা পাওয়া গেছে।
related_failed = সম্পর্কিত বার্তা খোঁজা যায়নি।

# Writing and sending
sending_via = {sender}-এর মাধ্যমে পাঠানো হচ্ছে...
send_failed = পাঠানো ব্যর্থ হয়েছে। বিস্তারিত জানতে লগ দেখুন।
draft_autosaved = খসড়া স্বয়ংক্রিয়ভাবে সংরক্ষিত হয়েছে।
draft_autosave_failed = খসড়ার স্বয়ংক্রিয় সংরক্ষণ ব্যর্থ হয়েছে। বিস্তারিত জানতে লগ দেখুন।

# Reading a message, and its attachments. {folder} here is a folder on
# your own computer.
remote_allowed_for_sender = {sender}-এর বার্তার জন্য এখন থেকে রিমোট কনটেন্ট লোড হবে।
downloading_attachment = {filename} ডাউনলোড হচ্ছে...
downloading_attachments_one = ১টি সংযুক্তি ডাউনলোড হচ্ছে...
downloading_attachments_many = {count}টি সংযুক্তি ডাউনলোড হচ্ছে...
saved_to = {folder}-এ সংরক্ষিত হয়েছে
attachment_download_failed = সংযুক্তি ডাউনলোড ব্যর্থ হয়েছে।

# Getting mail onto the screen
loading_folder = {account}-এর জন্য {folder} লোড হচ্ছে...
messages_in_folder = {folder}-এ {count}টি বার্তা।
messages_in_folder_cached = {folder}-এ {count}টি বার্তা (শেষ সিঙ্ক করা কপি, হালনাগাদ হচ্ছে...)
no_offline_copy = {folder}-এর এখনও কোনো অফলাইন কপি নেই।
refresh_failed_cached = {folder} রিফ্রেশ করা যায়নি: শেষ সিঙ্ক করা কপি দেখানো হচ্ছে।
no_such_folder = এই অ্যাকাউন্টে কোনো {folder} ফোল্ডার নেই।
load_failed = বার্তা লোড করা যায়নি। বিস্তারিত জানতে লগ দেখুন।
no_more_to_load = এই ফোল্ডারে লোড করার মতো আর বার্তা নেই।
loading_more = {folder}-এ আরও বার্তা লোড হচ্ছে...
more_loaded = আরও {count}টি বার্তা লোড হয়েছে।
no_more_messages = এই ফোল্ডারে আর কোনো বার্তা নেই।
load_more_failed = আরও বার্তা লোড করা যায়নি: {error}
loading_unified = একীভূত {folder} লোড হচ্ছে...
messages_in_unified = একীভূত {folder}-এ সব অ্যাকাউন্ট মিলিয়ে {count}টি বার্তা।
messages_in_unified_cached = একীভূত {folder}-এ {count}টি বার্তা (শেষ সিঙ্ক করা কপি, হালনাগাদ হচ্ছে...)
auto_purge_done = স্বয়ংক্রিয় পরিষ্কার ট্র্যাশ/জাঙ্ক থেকে {count}টি পুরোনো বার্তা সরিয়েছে।

# The main window's own status line. {folder} and {account} are your
# own folder and account names and are never translated.
ready = প্রস্তুত।
opening_message = বার্তা খোলা হচ্ছে...
opening_message_already = বার্তা খোলা হচ্ছে... (আগে থেকেই লোড হচ্ছে)
could_not_open_message = বার্তা খোলা যায়নি।
could_not_open_that_message = ওই বার্তাটি খোলা যায়নি।
could_not_load_message = এই বার্তাটি লোড করা যায়নি।
message_still_loading = ওই বার্তাটি এখনও লোড হচ্ছে।
folder_still_loading = এই ফোল্ডার এখনও লোড হচ্ছে -- একটু পরে আবার চেষ্টা করুন।
not_in_thread = এই বার্তাটি কোনো থ্রেডের অংশ নয়।
no_longer_in_thread = এই বার্তাটি আর থ্রেডে নেই।
thread_position = এই থ্রেডে {total}টির মধ্যে {position} নম্বর বার্তা।
thread_finished_one = এই থ্রেড শেষ হয়েছে (১টি বার্তা)।
thread_finished_many = এই থ্রেড শেষ হয়েছে ({count}টি বার্তা)।
select_message_first = আগে একটি বার্তা নির্বাচন করুন।
conversation_failed = এই কথোপকথন খোলা যায়নি।
select_message_for_related = আগে সেই বার্তাটি নির্বাচন করুন যার সম্পর্কিত বার্তা দেখতে চান।
looking_for_related = সম্পর্কিত বার্তা খোঁজা হচ্ছে...
no_threading_headers = এই বার্তায় খোঁজার মতো কোনো Message-ID বা থ্রেডিং হেডার নেই।
reply_one_at_a_time = উত্তর একবারে একটি বার্তায় কাজ করে। অনুগ্রহ করে একটিমাত্র বার্তা নির্বাচন করুন।
select_message_to_reply = আগে উত্তর দেওয়ার জন্য একটি বার্তা নির্বাচন করুন।
preparing_reply = উত্তর প্রস্তুত হচ্ছে...
reply_load_failed = উত্তরের জন্য মূল বার্তা লোড করা যায়নি।
select_message_to_forward = আগে ফরোয়ার্ড করার জন্য একটি বার্তা নির্বাচন করুন।
preparing_forward = ফরোয়ার্ড করার জন্য বার্তা প্রস্তুত হচ্ছে...
forward_load_failed = ফরোয়ার্ড করার বার্তা লোড করা যায়নি।
compose_tab_needed_hint = এই কমান্ডের জন্য একটি লেখার ট্যাব দরকার। বার্তা লিখতে Ctrl+N চাপুন।
open_message_first_view = আগে একটি বার্তা খুলুন, তারপর এর দৃশ্য বদলাতে Ctrl+B চাপুন।
open_message_first_remote = আগে একটি বার্তা খুলুন, তারপর এর রিমোট কনটেন্ট লোড করতে Ctrl+Shift+I চাপুন।

# Acting on messages
copying_message = বার্তা কপি হচ্ছে...
copy_failed = কপি ব্যর্থ হয়েছে।
delete_failed = মোছা ব্যর্থ হয়েছে।
already_in_archive = আগে থেকেই আর্কাইভে আছে।
archiving = আর্কাইভ করা হচ্ছে...
archive_failed = আর্কাইভ ব্যর্থ হয়েছে।
action_failed = {action} ব্যর্থ হয়েছে।
nothing_to_undo = পূর্বাবস্থায় ফেরানোর মতো কিছু নেই।
undo_failed = {action} পূর্বাবস্থায় ফেরানো যায়নি।

# Views and folders
folder_pane_all = ফোল্ডার প্যান: সব ফোল্ডার।
folder_pane_unified = ফোল্ডার প্যান: একীভূত ফোল্ডার।
sorted_ascending = {field} অনুযায়ী ঊর্ধ্বক্রমে সাজানো।
sorted_descending = {field} অনুযায়ী অধঃক্রমে সাজানো।
unified_folders_updated = একীভূত ফোল্ডার হালনাগাদ করা হয়েছে।
zoom_reset = বার্তার ফন্টের আকার ডিফল্টে ফেরানো হয়েছে।
folder_creating = "{folder}" ফোল্ডার তৈরি হচ্ছে...
folder_created = "{folder}" ফোল্ডার তৈরি হয়েছে।
folder_create_failed = ফোল্ডার তৈরি করা যায়নি।
folder_renaming = "{folder}"-এর নাম বদলে "{new_name}" করা হচ্ছে...
folder_renamed = ফোল্ডারের নাম বদলে "{new_name}" করা হয়েছে।
folder_rename_failed = ফোল্ডারের নাম বদলানো যায়নি।
folder_deleting = "{folder}" ফোল্ডার মোছা হচ্ছে...
folder_deleted = ফোল্ডার মুছে ফেলা হয়েছে।
folder_delete_failed = ফোল্ডার মোছা যায়নি।
folder_subscribing = "{folder}"-এ সাবস্ক্রাইব করা হচ্ছে...
folder_unsubscribing = "{folder}" থেকে আনসাবস্ক্রাইব করা হচ্ছে...
folder_subscribed = সাবস্ক্রাইব করা হয়েছে।
folder_unsubscribed = আনসাবস্ক্রাইব করা হয়েছে।
folder_subscribe_failed = ফোল্ডারে সাবস্ক্রাইব করা যায়নি।
folder_unsubscribe_failed = ফোল্ডার থেকে আনসাবস্ক্রাইব করা যায়নি।

# Accounts
account_not_added = অ্যাকাউন্ট যোগ করা হয়নি।
account_added = অ্যাকাউন্ট যোগ করা হয়েছে: {account}
account_settings_not_saved = অ্যাকাউন্ট সেটিংস সংরক্ষিত হয়নি।
account_updated = অ্যাকাউন্ট হালনাগাদ করা হয়েছে: {account}
account_not_removed = অ্যাকাউন্ট সরানো হয়নি।
account_removed = অ্যাকাউন্ট সরানো হয়েছে।
account_removed_with_files = অ্যাকাউন্ট সরানো হয়েছে। {count}টি স্থানীয় ফাইল মুছে ফেলা হয়েছে।
default_account_failed = ডিফল্ট অ্যাকাউন্ট সেট করা যায়নি।
default_account_set = {account} এখন ডিফল্ট অ্যাকাউন্ট।
auto_check_not_saved = স্বয়ংক্রিয় যাচাইয়ের সেটিং সংরক্ষিত হয়নি।
mute_not_saved = মিউট সেটিং সংরক্ষিত হয়নি।
account_muted = {account} মিউট করা হয়েছে।
account_unmuted = {account} আনমিউট করা হয়েছে।
export_done = {count}টি অ্যাকাউন্ট ও সেটিংস {path}-এ রপ্তানি করা হয়েছে।
import_done = {path} থেকে {count}টি অ্যাকাউন্ট আমদানি করা হয়েছে।

# Filters, cache and the background lists
filters_not_saved = ফিল্টার সংরক্ষিত হয়নি।
filters_saved = {account}-এর জন্য ফিল্টার সংরক্ষিত হয়েছে।
filters_checking = {folder} আপনার ফিল্টার দিয়ে যাচাই করা হচ্ছে...
filters_none_matched = এখনই চালান: {folder}-এর কোনো বার্তা কোনো সক্রিয় নিয়মের সাথে মেলেনি।
filters_run_failed = ফিল্টার চালানো যায়নি।
filters_moving = ফিল্টার করা {count}টি বার্তা সরানো হচ্ছে...
filters_move_failures = ফিল্টার: {count}টি বার্তা সরানো যায়নি।
filters_moved = ফিল্টার {folder} থেকে {count}টি বার্তা সরিয়েছে।
filters_move_failed = ফিল্টার করা বার্তা সরানো যায়নি।
cache_not_cleared = ক্যাশ পরিষ্কার করা হয়নি।
auto_cache_cleanup = স্বয়ংক্রিয় ক্যাশ পরিষ্কার: {age}-এর চেয়ে পুরোনো বার্তা।
phishing_update_failed = ফিশিং তালিকা হালনাগাদ করা যায়নি: {error}
blocklist_update_failed = ব্লকলিস্ট হালনাগাদ করা যায়নি: {error}

# Saving, printing, emptying and syncing
open_message_first_save = আগে একটি বার্তা খুলুন, তারপর এভাবে সংরক্ষণ করুন ব্যবহার করুন।
saving_message = বার্তা সংরক্ষণ করা হচ্ছে...
save_file_failed = ফাইল সংরক্ষণ করা যায়নি।
save_fetch_failed = সংরক্ষণের জন্য বার্তা আনা যায়নি।
open_message_first_print = আগে একটি বার্তা খুলুন, তারপর মুদ্রণ ব্যবহার করুন।
open_message_first_preview = আগে একটি বার্তা খুলুন, তারপর মুদ্রণ পূর্বরূপ ব্যবহার করুন।
refreshing_accounts = {count}টি অ্যাকাউন্ট রিফ্রেশ হচ্ছে...
emptying_trash = {account}-এর ট্র্যাশ খালি করা হচ্ছে...
trash_already_empty = ট্র্যাশ আগে থেকেই খালি ছিল।
trash_emptied = ট্র্যাশ খালি করা হয়েছে: {count}টি বার্তা মুছে ফেলা হয়েছে।
empty_trash_failed = ট্র্যাশ খালি করা যায়নি।
emptying_junk = {account}-এর জাঙ্ক খালি করা হচ্ছে...
junk_already_empty = জাঙ্ক আগে থেকেই খালি ছিল।
junk_emptied = জাঙ্ক খালি করা হয়েছে: {count}টি বার্তা মুছে ফেলা হয়েছে।
junk_emptied_prefix = জাঙ্ক খালি করা হয়েছে:
junk_part_purged = {count}টি মুছে ফেলা হয়েছে
junk_part_in_trash = {count}টি ট্র্যাশে সরানো হয়েছে কিন্তু মোছা নিশ্চিত হয়নি, ট্র্যাশ দেখুন
junk_part_not_moved = {count}টি ট্র্যাশে সরানো হয়নি, এখনও জাঙ্কে আছে
empty_junk_failed = জাঙ্ক খালি করা যায়নি।
working_offline = অফলাইনে কাজ: ইনবক্স/প্রেরিত/খসড়ার শেষ সিঙ্ক করা কপি দেখানো হচ্ছে।
back_online = আবার অনলাইন।
offline_sync_running = অফলাইন ব্যবহারের জন্য {account} সিঙ্ক হচ্ছে...
offline_sync_done = অফলাইন ব্যবহারের জন্য ইনবক্স, প্রেরিত ও খসড়া মিলিয়ে {count}টি বার্তা সিঙ্ক করা হয়েছে।
offline_sync_failed = অফলাইন সিঙ্ক ব্যর্থ হয়েছে: {error}

# Senders, contacts, privacy and zoom
select_or_open_message = আগে একটি বার্তা নির্বাচন করুন বা খুলুন।
select_or_open_message_ctrl_u = আগে একটি বার্তা নির্বাচন করুন বা খুলুন, তারপর Ctrl+U চাপুন।
no_sender_address = এই বার্তায় যোগ করার মতো কোনো প্রেরকের ঠিকানা নেই।
contact_added = {contact}-কে আপনার ঠিকানা বইয়ে যোগ করা হয়েছে।
contact_already_there = {contact} আগে থেকেই আপনার ঠিকানা বইয়ে আছে।
privacy_saved = গোপনীয়তা সেটিংস সংরক্ষিত হয়েছে। প্রয়োগ করতে বার্তাটি আবার খুলুন।
message_font_size = বার্তার ফন্টের আকার: {size} pt।


# The explanatory note under each setting. One paragraph, one key.
set_debug_note = কিছু ভুল হলে ডিবাগ লগিং সমস্যা নির্ণয়ে সাহায্য করে। এটি বন্ধ করলে নতুন এন্ট্রি লেখা বন্ধ হয়; বিদ্যমান লগ ফাইল মোছা হয় না। পরের বার ZBox চালু হলে কার্যকর হয়।
set_language_note = পরের বার ZBox চালু হলে কার্যকর হয়। ভাষার ফাইলগুলো ZBox-এর lang ফোল্ডারে, sounds ফোল্ডারের পাশে থাকা সাধারণ লেখার ফাইল। একটি যোগ করতে en ফোল্ডারটি কপি করুন, কপিটি ও তার ভেতরের .lang ফাইলের নাম আপনার ভাষার কোডে বদলান, এবং প্রতিটি সমান চিহ্নের ডানের লেখা অনুবাদ করুন। যা এখনও অনুবাদ হয়নি তা নীরব না থেকে ইংরেজিতে বলা হয়, তাই আংশিক শেষ করা ফাইলও ব্যবহারে নিরাপদ।
set_headers_note = প্রেরক, প্রাপক, Cc, তারিখ ও বিষয়, লেখা ও HTML দুই দৃশ্যেই বার্তার মূল অংশের ওপরে দেখানো হয়। এটি ছাড়া ট্যাব বন্ধ করে তালিকায় না ফিরে বার্তার ভেতর থেকে কে পাঠিয়েছে জানার উপায় নেই। ফোকাস তবুও বার্তার মূল অংশে যায়; হেডার অংশ একটি Shift+Tab দূরে। পরের বার বার্তা খুললে কার্যকর হয়।
set_zoom_note = খোলা বার্তার নিজস্ব লেখা বড় বা ছোট করে, ZBox-এর বাকি অংশ ও Windows-এর নিজস্ব ডিসপ্লে স্কেলিং থেকে আলাদাভাবে। লেখা ও HTML দুই দৃশ্যেই প্রযোজ্য। “পড়ার ফন্ট” ঐচ্ছিকভাবে বার্তার মূল অংশে একটি নির্দিষ্ট ফন্ট (যেমন Consolas, OpenDyslexic) চাপিয়ে দেয়; স্বাভাবিক ফন্ট রাখতে ফাঁকা রাখুন। দৃশ্য মেনুতে Ctrl+Shift+= / Ctrl+Shift+- / Ctrl+Shift+0 এই ডায়ালগ না খুলেই শুধু ফন্টের আকার বাড়ায়, কমায় বা ডিফল্টে ফেরায়, এবং সব খোলা বার্তায় তখনই প্রযোজ্য হয়। এখানে করা পরিবর্তনও ঠিক আছে চাপলে তখনই প্রযোজ্য হয়।
set_view_note = HTML ডিফল্ট। এটি বার্তাটি যেভাবে পাঠানো হয়েছে সেভাবে দেখায়, এবং NVDA ও JAWS এটি পড়ে: HTML পেজ খুললে ZBox ব্রাউজারের নিজস্ব ঘোষণা নীরব করে, পড়ার কার্সর বার্তার প্রথম লাইনে রাখে, এবং পেজের ভেতরে ZBox-এর নিজস্ব শর্টকাট চালু রাখে, ফোকাস বাইরে আনার F6-সহ। লেখা একই বার্তা একটি সাধারণ এডিট কন্ট্রোলে সাধারণ, ফরম্যাটবিহীন লেখা হিসেবে দেখায় -- কোনো ছবি নেই, লেআউট নেই, এবং ব্রাউজার ইঞ্জিন ইনস্টল থাকার ওপর নির্ভরশীল কিছু নেই। যেকোনো দিকে বদলাতে খোলা বার্তার ভেতরে Ctrl+B চাপুন।
set_engine_note = Edge আধুনিক CSS রেন্ডার করে কিন্তু পেজটি আলাদা প্রক্রিয়ায় চালায়, এবং তার কনটেন্ট স্ক্রিন রিডারকে শুধু এমন একটি ইন্টারফেসে দেয় যেখানে wxPython পৌঁছাতে পারে না -- তাই বার্তাটি পড়ার মতো কিছু ছাড়াই খুলতে পারে। পুরোনো MSHTML হলো সেই ইঞ্জিন যা Outlook Express ও Windows Mail ব্যবহার করত: এটি একই প্রক্রিয়ায় চলে এবং একটি সাধারণ ডকুমেন্ট ট্রি প্রকাশ করে, তাই NVDA ও JAWS এটি যেকোনো ওয়েব পেজের মতো ব্রাউজ মোডে পড়ে। পরের বার বার্তা খুললে কার্যকর হয়।
set_runtime_note = সিস্টেম-ব্যাপী রানটাইম Windows Update দিয়ে রক্ষণাবেক্ষণ হয়, তাই আপনার মেইল পড়া ইঞ্জিন কোনো নোটিশ ছাড়াই বদলে যেতে পারে — এভাবেই এমন মেশিনেও কাজ করা HTML বার্তা দৃশ্য ভেঙে যেতে পারে যেখানে ZBox-এর কিছুই বদলায়নি। deps ফোল্ডারে সঙ্গে দেওয়া কপিটি ঠিক সেই সংস্করণ স্থির রাখে যার বিপরীতে ZBox পরীক্ষা করা হয়েছিল। একটি ইনস্টল করতে tools\get_webview2.bat চালান। সঙ্গে দেওয়া কপি না থাকলে ZBox যেকোনো অবস্থায় সিস্টেম-ব্যাপী রানটাইম ব্যবহার করে, তাই এটি সবসময় চালু হয়। পরের বার ZBox চালু হলে কার্যকর হয়।
set_sr_intro = বার্তা খোলার সময় ZBox আপনার স্ক্রিন রিডারকে কতটা বলতে দেয়, এবং তার নিজস্ব কথিত ঘোষণা কতক্ষণ থাকে।
set_silence_note = HTML বার্তা খুললে স্ক্রিন রিডারের ব্রাউজার ঘোষণা নীরব করতে ZBox ২ সেকেন্ড পর্যন্ত একটি কৃত্রিম Ctrl চাপ ধরে রাখতে পারে। বার্তার বিষয় ইতিমধ্যে পেজের শিরোনাম হিসেবে ব্যবহৃত হয়, যা base64 URL জোরে পড়া বন্ধ করে, কিন্তু রিডার তবুও বার্তার শুরুর ওপর কন্ট্রোল ও ডকুমেন্টের ধরন ঘোষণা করে, তাই এটি ডিফল্টভাবে চালু। বন্ধ করতে ০ করুন, অথবা কথাবার্তা তবুও ঢুকে পড়লে বাড়ান।
set_focus_delay_note = HTML বার্তা লোড শেষ হলে ZBox আসলে ফোকাস করার আগে এতক্ষণ অপেক্ষা করে। WebView2-এর পেজ লোড হওয়ার খবর দেওয়া আর Windows-এর সেই পেজের অ্যাক্সেসিবিলিটি ট্রি শেষ করা একই মুহূর্ত নয়; খুব আগে ফোকাস করলেই NVDA/JAWS বার্তার বদলে একটি সাধারণ “ওয়েব কনটেন্ট পেজ” ঘোষণা করে, বা খোলার পর কিছুক্ষণ বার্তাটিকে অনুপলব্ধ বলে। স্তর ১ মানে 100 ms, স্তর ১০ মানে পুরো এক সেকেন্ড। এটি এখনও দেখলে বাড়ান; খোলা নির্ভরযোগ্য মনে হলে দ্রুত খোলার জন্য কমান।
set_announce_note = Ctrl+U ও Ctrl+Shift+U প্রেরককে একটি ছোট ডায়ালগে জানায় যা নিজে থেকে বন্ধ হয়, কারণ স্ট্যাটাস বার তখনই বলা হয় যখন আপনার স্ক্রিন রিডারে স্ট্যাটাস বার রিপোর্টিং চালু থাকে। এটি সেই ডায়ালগ কতক্ষণ থাকবে তা। আপনার কথার গতির সাথে মিলিয়ে সেট করুন: খুব কম হলে বাক্যের মাঝেই বন্ধ হয়ে যায়, যা এর উদ্দেশ্যই ব্যর্থ করে। যেকোনো কী এটি আগেই বন্ধ করে; তীর কী এটি খোলা রাখে যাতে আবার পড়তে পারেন। ০ মানে এটি একটি কী-এর জন্য অপেক্ষা করে এবং নিজে থেকে কখনও বন্ধ হয় না।
set_attachment_dir_note = বার্তায় একাধিক সংযুক্তি থাকলে “সব সংরক্ষণ করুন” সেগুলো কোথায় লেখে। না থাকলে নিজে থেকে তৈরি হয়। একটিমাত্র সংযুক্তির বার্তা আগের মতোই জিজ্ঞেস করে কোথায় সংরক্ষণ করবে। ডিফল্টের জন্য ফাঁকা রাখুন:\n{path}
set_autosave_note = লেখার সময় খোলা লেখার ট্যাব কত ঘন ঘন নিজে থেকে খসড়ায় সংরক্ষিত হয়। খসড়া সংরক্ষণ করুন (Ctrl+S) যেকোনো অবস্থায় চাইলেই সংরক্ষণ করে, এবং অসংরক্ষিত লেখাসহ ট্যাব বন্ধ করলে সবসময় সংরক্ষণের সুযোগ দেয়। ০ স্বয়ংক্রিয় সংরক্ষণ বন্ধ করে। ১৫ সেকেন্ডের কম দেওয়া হয় না -- সেটি আপনার টাইপিংয়ের সাথে প্রতিযোগিতা করা একটি সার্ভার যাতায়াত হবে।
set_auto_purge_note = ট্র্যাশ ও জাঙ্কে এত দিন পড়ে থাকার পর বার্তা স্থায়ীভাবে সরায় -- ট্র্যাশ খালি করুন ও জাঙ্ক খালি করুন চাইলে যে স্থায়ী অপসারণ করে সেটিই, ZBox খোলা থাকলে দিনে একবার নিজে থেকে চলে। ডিফল্টভাবে ৩০ দিনে চালু। ০ এটি বন্ধ করে। বার্তা সরানো হলে এটি পূর্বাবস্থায় ফেরানো যায় না।
set_bare_keys_note = চালু থাকলে বার্তা তালিকায় শুধু S, A, J, W বা K চাপলে তখনই ফ্ল্যাগ বদলায়, আর্কাইভ হয়, নির্বাচিত বার্তা জাঙ্ক চিহ্নিত হয় (Shift+J জাঙ্ক নয় চিহ্নিত করে), অথবা নির্বাচন যে থ্রেডের অংশ তা নজরে রাখা/উপেক্ষা করা হয় -- আর্কাইভ ও জাঙ্ক হিসেবে চিহ্নিত করুন-এ কোনো নিশ্চিতকরণ বা পূর্বাবস্থায় ফেরানো নেই। এটি বন্ধ করলে S, A, J, W ও K সাধারণ প্রথম-অক্ষর তালিকা নেভিগেশনে ফিরে যায়। Ctrl+S ও Ctrl+Shift+A যেকোনো অবস্থায় কাজ করে। তখনই কার্যকর হয়।
set_sounds_note = অগ্রগতি, নতুন বার্তা, পাঠানো, উত্তর দেওয়া বা ফরোয়ার্ড করা কাজ, মোছা এবং খোঁজার ফলাফলের জন্য ছোট শব্দ। বন্ধ করলে অ্যাপের সব শব্দ বন্ধ হয়; স্ক্রিন রিডার ও স্ট্যাটাস বারের ঘোষণা যেকোনো অবস্থায় প্রভাবিত হয় না।
set_desktop_notifications_note = নতুন মেইলের প্রতিটি দলের জন্য একটি Windows বিজ্ঞপ্তি, ওপরের শব্দ থেকে আলাদা। বন্ধ করলে সব অ্যাকাউন্টের জন্য বন্ধ হয়; একটি অ্যাকাউন্টকে অ্যাকাউন্ট সেটিংসে আলাদাভাবেও মিউট করা যায়।
set_theme_note = কাস্টম থিম হলো ZBox-এর sounds ফোল্ডারের ভেতরে রাখা ফোল্ডার, প্রতিটিতে নিজস্ব progress-tick.wav, incoming-message.wav, action-done.wav, delete.wav, searching.wav, searching_done.wav ও none_found.wav থাকে। থিমের কোনো ফাইল না থাকলে ডিফল্ট শব্দ ব্যবহৃত হয়।
set_theme_note_only_default = কাস্টম থিম হলো ZBox-এর sounds ফোল্ডারের ভেতরে রাখা ফোল্ডার, প্রতিটিতে নিজস্ব progress-tick.wav, incoming-message.wav, action-done.wav, delete.wav, searching.wav, searching_done.wav ও none_found.wav থাকে। থিমের কোনো ফাইল না থাকলে ডিফল্ট শব্দ ব্যবহৃত হয়। অন্য একটি থিম ফোল্ডার যোগ না করা পর্যন্ত শুধু “default” উপলব্ধ।
set_lock_note = তখন ZBox চালু হলে কোনো অ্যাকাউন্ট খোলার আগে আপনার একটি আনলক পদ্ধতি চায়। যেকোনো একটিই যথেষ্ট: পাসকি, নিরাপত্তা কী, অথবা মাস্টার পাসওয়ার্ড। ট্রেতে বন্ধ করা প্রস্থান নয় এবং আবার লক করে না; ফাইল > প্রস্থান ও ট্রে আইকনের প্রস্থান তা করে। কিছু নিবন্ধিত না থাকলে এবং মাস্টার পাসওয়ার্ড সেট না থাকলে আপনাকে নিজের মেইল থেকে বাইরে না রেখে লকটি এড়িয়ে যাওয়া হয়।
set_security_note = তিনটির মধ্যে শুধু মাস্টার পাসওয়ার্ডই কিছু এনক্রিপ্ট করে: এর মাধ্যমেই এই ফোল্ডার অন্য কম্পিউটারে তার সংরক্ষিত অ্যাকাউন্ট পাসওয়ার্ড খুলতে পারে। পাসকি বা নিরাপত্তা কী এই কম্পিউটারে অ্যাপ আনলক করে। যে কম্পিউটারে ZBox আগে ব্যবহার হয়নি সেখানে কোনোটিই মাস্টার পাসওয়ার্ডের জায়গা নেয় না।
set_minimize_note = ZBox ছোট করলে তার টাস্কবার বোতাম লুকিয়ে যায় এবং এটি ট্রে আইকনের পেছনে চলতে থাকে। উইন্ডো ফিরিয়ে আনতে ট্রে আইকনে বাম-ক্লিক করুন (বা কীবোর্ড ফোকাস থাকলে Enter/Space)।
set_close_note = উইন্ডোর বন্ধ বোতাম, Alt+F4, এবং মেইল ট্যাবে চাপা Ctrl+W প্রস্থানের বদলে ZBox-কে ট্রেতে লুকায়। ফাইল > প্রস্থান (Ctrl+Shift+Q) ও ট্রে আইকনের নিজস্ব প্রস্থান আইটেম যেকোনো অবস্থায় সত্যিই ZBox বন্ধ করে, তাই ট্রে না ছুঁয়ে প্রস্থানের একটি কীবোর্ড পথ সবসময় থাকে।
set_stay_maximized_note = ZBox সর্বোচ্চ আকারে চালু হয় এবং আপনি সর্বোচ্চ আকার থেকে সরালে আবার সর্বোচ্চ করা হয়। মেনু বার, শিরোনাম বার ও উইন্ডোর সীমানা প্রভাবিত হয় না -- এটি সীমানাহীন পূর্ণ-স্ক্রিন মোড নয়, তাই প্রতিটি Alt-কী মেনু শর্টকাট কাজ করতে থাকে।
set_run_at_startup_note = Windows-এ সাইন ইন করলে ZBox নিজে থেকে চালু হয়, উইন্ডো না দেখিয়ে সরাসরি ট্রেতে খোলে। তখনই কার্যকর হয়, শুধু পরের বার চালু হলে নয়।
set_desktop_shortcut_note = আপনার ডেস্কটপে ZBox-এর একটি শর্টকাট রাখে, আগে থেকে থাকলে সেটি বদলে। শর্টকাট এই ZBox ফোল্ডারের সঠিক অবস্থান মনে রাখে, তাই ZBox অন্য কোথাও সরালে বা কপি করলে ডেস্কটপ শর্টকাটকে সেদিকে নির্দেশ করতে নতুন কপিতে আবার এটি চাপুন। তখনই কার্যকর হয় এবং ঠিক আছে-এর জন্য অপেক্ষা করে না।


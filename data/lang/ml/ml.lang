# The explanatory note under each setting. One paragraph, one key.
set_debug_note = എന്തെങ്കിലും തകരാറിലായാൽ പ്രശ്നങ്ങൾ കണ്ടെത്താൻ ഡീബഗ് ലോഗിംഗ് സഹായിക്കുന്നു. ഇത് ഓഫാക്കിയാൽ പുതിയ എൻട്രികൾ എഴുതില്ല; നിലവിലുള്ള ലോഗ് ഫയലുകൾ ഇല്ലാതാക്കില്ല. ZBox അടുത്തതവണ ആരംഭിക്കുമ്പോൾ പ്രാബല്യത്തിൽ വരും.
set_language_note = ZBox അടുത്തതവണ ആരംഭിക്കുമ്പോൾ പ്രാബല്യത്തിൽ വരും. ഭാഷാ ഫയലുകൾ sounds ഫോൾഡറിന് അടുത്തുള്ള ZBox-ന്റെ lang ഫോൾഡറിലെ സാധാരണ വാചക ഫയലുകളാണ്. ഒന്ന് ചേർക്കാൻ, en ഫോൾഡർ പകർത്തി, പകർപ്പിന്റെയും അതിനുള്ളിലെ .lang ഫയലിന്റെയും പേര് നിങ്ങളുടെ ഭാഷാ കോഡിലേക്ക് മാറ്റി, ഓരോ സമചിഹ്നത്തിന്റെയും വലതുവശത്തുള്ള വാചകം വിവർത്തനം ചെയ്യുക. ഇതുവരെ വിവർത്തനം ചെയ്യാത്തത് നിശബ്ദമാകുന്നതിന് പകരം ഇംഗ്ലീഷിൽ പറയും, അതിനാൽ പകുതി പൂർത്തിയായ ഫയൽ ഉപയോഗിക്കുന്നത് സുരക്ഷിതമാണ്.
set_headers_note = അയച്ചയാൾ, സ്വീകർത്താവ്, പകർപ്പ്, തീയതി, വിഷയം എന്നിവ വാചക, HTML കാഴ്ചകളിൽ സന്ദേശ ബോഡിക്ക് മുകളിൽ കാണിക്കുന്നു. അത് ഇല്ലെങ്കിൽ ടാബ് അടച്ച് പട്ടികയിലേക്ക് മടങ്ങാതെ സന്ദേശത്തിനുള്ളിൽ നിന്ന് ആരാണ് അയച്ചതെന്ന് അറിയാൻ വഴിയില്ല. ഫോക്കസ് ഇപ്പോഴും സന്ദേശ ബോഡിയിൽ തന്നെ വരും; ഹെഡർ ബ്ലോക്ക് ഒരു Shift+Tab അകലെയാണ്. സന്ദേശം അടുത്തതവണ തുറക്കുമ്പോൾ പ്രാബല്യത്തിൽ വരും.
set_zoom_note = തുറന്ന സന്ദേശത്തിന്റെ സ്വന്തം വാചകം ZBox-ന്റെ ബാക്കി ഭാഗത്തിൽ നിന്നും Windows-ന്റെ സ്വന്തം ഡിസ്പ്ലേ സ്കെയിലിംഗിൽ നിന്നും സ്വതന്ത്രമായി വലുതോ ചെറുതോ ആക്കുന്നു. വാചക, HTML കാഴ്ചകൾക്ക് ബാധകം. "വായനാ ഫോണ്ട്" ഓപ്ഷണലായി സന്ദേശ ബോഡിക്ക് ഒരു പ്രത്യേക ഫോണ്ട് (ഉദാ. Consolas, OpenDyslexic) നിർബന്ധമാക്കുന്നു; സാധാരണ ഫോണ്ട് നിലനിർത്താൻ അത് ശൂന്യമാക്കുക. കാണുക മെനുവിലെ Ctrl+Shift+= / Ctrl+Shift+- / Ctrl+Shift+0 ഈ ഡയലോഗ് തുറക്കാതെ ഫോണ്ട് വലുപ്പം മാത്രം കൂട്ടുകയോ കുറയ്ക്കുകയോ പുനഃസജ്ജമാക്കുകയോ ചെയ്യുന്നു, തുറന്ന ഓരോ സന്ദേശത്തിനും ഉടൻ ബാധകമാകും. ഇവിടെ വരുത്തുന്ന മാറ്റങ്ങളും ശരി ക്ലിക്ക് ചെയ്യുമ്പോൾ ഉടൻ ബാധകമാകും.
set_view_note = HTML ആണ് സ്ഥിരസ്ഥിതി. ഇത് സന്ദേശം അയച്ചതുപോലെ കാണിക്കുന്നു, NVDA, JAWS എന്നിവ അത് വായിക്കുന്നു: HTML പേജ് തുറക്കുമ്പോൾ, ZBox ബ്രൗസറിന്റെ സ്വന്തം അറിയിപ്പ് നിശബ്ദമാക്കുകയും, റീഡിംഗ് കഴ്സർ സന്ദേശത്തിന്റെ ആദ്യ വരിയിൽ വയ്ക്കുകയും, പേജിനുള്ളിൽ ZBox-ന്റെ സ്വന്തം ഷോർട്ട്കട്ടുകൾ പ്രവർത്തിക്കുന്നതായി ഉറപ്പാക്കുകയും ചെയ്യുന്നു, അതിൽ നിന്ന് ഫോക്കസ് പുറത്തേക്ക് മാറ്റുന്ന F6 ഉൾപ്പെടെ. വാചകം അതേ സന്ദേശത്തെ ഒരു സാധാരണ എഡിറ്റ് നിയന്ത്രണത്തിൽ സാധാരണ, ഫോർമാറ്റ് ചെയ്യാത്ത വാചകമായി കാണിക്കുന്നു -- ചിത്രങ്ങളില്ല, ലേഔട്ടില്ല, ബ്രൗസർ എഞ്ചിൻ ഇൻസ്റ്റാൾ ചെയ്തിരിക്കുന്നതിനെ ആശ്രയിക്കുന്ന ഒന്നുമില്ല. രണ്ട് വഴിക്കും മാറാൻ തുറന്ന സന്ദേശത്തിൽ Ctrl+B അമർത്തുക.
set_engine_note = Edge ആധുനിക CSS റെൻഡർ ചെയ്യുന്നു, പക്ഷേ പേജ് ഒരു പ്രത്യേക പ്രക്രിയയിൽ പ്രവർത്തിപ്പിക്കുകയും wxPython-ന് എത്താൻ കഴിയാത്ത ഇന്റർഫേസ് വഴി മാത്രം അതിന്റെ ഉള്ളടക്കം സ്ക്രീൻ റീഡറിന് നൽകുകയും ചെയ്യുന്നു -- അതിനാൽ സന്ദേശം വായിക്കാവുന്ന ഒന്നുമില്ലാതെ തുറന്നേക്കാം. പഴയ MSHTML ആണ് Outlook Express-ഉം Windows Mail-ഉം ഉപയോഗിച്ച എഞ്ചിൻ: ഇത് അതേ പ്രക്രിയയിൽ പ്രവർത്തിക്കുകയും സാധാരണ ഡോക്യുമെന്റ് ട്രീ പ്രസിദ്ധീകരിക്കുകയും ചെയ്യുന്നു, അതിനാൽ NVDA, JAWS എന്നിവ അത് ഏതൊരു വെബ് പേജും പോലെ ബ്രൗസ് മോഡിൽ വായിക്കുന്നു. സന്ദേശം അടുത്തതവണ തുറക്കുമ്പോൾ പ്രാബല്യത്തിൽ വരും.
set_runtime_note = സിസ്റ്റം-വ്യാപക റൺടൈം പരിപാലിക്കുന്നത് Windows Update ആണ്, അതിനാൽ നിങ്ങളുടെ മെയിൽ വായിക്കുന്ന എഞ്ചിൻ മുന്നറിയിപ്പില്ലാതെ മാറാം — ZBox-നെക്കുറിച്ച് ഒന്നും മാറാത്ത ഒരു കമ്പ്യൂട്ടറിൽ നന്നായി പ്രവർത്തിച്ചിരുന്ന HTML സന്ദേശ കാഴ്ച ഇങ്ങനെയാണ് തകരാറിലാകുന്നത്. deps ഫോൾഡറിലെ ഉൾപ്പെടുത്തിയ പകർപ്പ് ZBox പരീക്ഷിച്ച കൃത്യമായ പതിപ്പിനെ ഉറപ്പിച്ചുനിർത്തുന്നു. ഒന്ന് ഇൻസ്റ്റാൾ ചെയ്യാൻ tools\get_webview2.bat പ്രവർത്തിപ്പിക്കുക. ഉൾപ്പെടുത്തിയ പകർപ്പ് ഇല്ലെങ്കിൽ ZBox എന്തായാലും സിസ്റ്റം-വ്യാപക റൺടൈം ഉപയോഗിക്കും, അതിനാൽ അത് എപ്പോഴും ആരംഭിക്കും. ZBox അടുത്തതവണ ആരംഭിക്കുമ്പോൾ പ്രാബല്യത്തിൽ വരും.
set_sr_intro = സന്ദേശം തുറക്കുമ്പോൾ ZBox നിങ്ങളുടെ സ്ക്രീൻ റീഡറിനെ എത്രമാത്രം സംസാരിക്കാൻ അനുവദിക്കുന്നു, അതിന്റെ സ്വന്തം സംസാര അറിയിപ്പുകൾ എത്ര സമയം നിലനിൽക്കുന്നു.
set_silence_note = HTML സന്ദേശം തുറക്കുമ്പോൾ, സ്ക്രീൻ റീഡറിന്റെ ബ്രൗസർ അറിയിപ്പ് നിശബ്ദമാക്കാൻ ZBox ഒരു കൃത്രിമ Ctrl അമർത്തൽ 2 സെക്കൻഡ് വരെ പിടിച്ചേക്കാം. സന്ദേശത്തിന്റെ വിഷയം ഇതിനകം പേജ് ശീർഷകമായി ഉപയോഗിക്കുന്നു, ഇത് base64 URL വായിക്കുന്നത് തടയുന്നു, പക്ഷേ റീഡർ ഇപ്പോഴും സന്ദേശത്തിന്റെ തുടക്കത്തിൽ നിയന്ത്രണവും ഡോക്യുമെന്റ് തരവും അറിയിക്കുന്നു, അതിനാൽ ഇത് സ്ഥിരസ്ഥിതിയായി ഓണാണ്. ഇത് ഓഫാക്കാൻ ഓഫ് തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ സംസാരം ഇപ്പോഴും കടന്നുവരുന്നുവെങ്കിൽ കൂടുതൽ സമയം തിരഞ്ഞെടുക്കുക.
set_focus_delay_note = HTML സന്ദേശം ലോഡ് ചെയ്തു കഴിയുമ്പോൾ, അതിന് ഫോക്കസ് നൽകുന്നതിന് മുമ്പ് ZBox ഇത്രയും സമയം കാത്തിരിക്കുന്നു. WebView2 പേജ് ലോഡ് ആയി എന്ന് റിപ്പോർട്ട് ചെയ്യുന്നതും Windows ആ പേജിന്റെ ആക്സസിബിലിറ്റി ട്രീ പൂർത്തിയാക്കുന്നതും ഒരേ നിമിഷമല്ല; വളരെ നേരത്തെ ഫോക്കസ് ചെയ്താൽ NVDA/JAWS സന്ദേശത്തിന് പകരം പൊതുവായ "വെബ് ഉള്ളടക്ക പേജ്" അറിയിക്കുകയോ, തുറന്ന ശേഷം കുറച്ച് നേരം സന്ദേശം ലഭ്യമല്ലെന്ന് റിപ്പോർട്ട് ചെയ്യുകയോ ചെയ്യും. ഓപ്ഷനുകൾ 0.1 സെക്കൻഡ് മുതൽ 1 സെക്കൻഡ് വരെയാണ്. ഇത് ഇപ്പോഴും കേൾക്കുന്നുവെങ്കിൽ കൂടുതൽ സമയവും, തുറക്കൽ സ്ഥിരമായി തോന്നുന്നുവെങ്കിൽ വേഗത്തിലുള്ള തുറക്കലിന് കുറഞ്ഞ സമയവും തിരഞ്ഞെടുക്കുക.
set_announce_note = നിങ്ങളുടെ സ്ക്രീൻ റീഡറിൽ സ്റ്റാറ്റസ്-ബാർ റിപ്പോർട്ടിംഗ് ഓണാണെങ്കിൽ മാത്രമേ സ്റ്റാറ്റസ് ബാർ വായിക്കൂ എന്നതിനാൽ Ctrl+U, Ctrl+Shift+U എന്നിവ അയച്ചയാളെ സ്വയം അടയുന്ന ഒരു ചെറിയ ഡയലോഗിൽ റിപ്പോർട്ട് ചെയ്യുന്നു. ആ ഡയലോഗ് എത്ര സമയം നിലനിൽക്കുമെന്നതാണ് ഇത്. നിങ്ങളുടെ സംസാര വേഗതയ്ക്ക് അനുസരിച്ച് ഇത് സജ്ജമാക്കുക: വളരെ കുറഞ്ഞാൽ വാചകത്തിന്റെ മധ്യത്തിൽ അടയും, അത് ഉദ്ദേശ്യം നശിപ്പിക്കും. ഏത് കീയും അത് നേരത്തെ അടയ്ക്കും; ആരോ കീകൾ വീണ്ടും വായിക്കാൻ അത് തുറന്നു വയ്ക്കും. കീയ്ക്കായി കാത്തിരിക്കും നിങ്ങൾ ഒന്ന് അമർത്തുന്നത് വരെ അത് തുറന്നു വയ്ക്കുന്നു.
set_attachment_dir_note = ഒരു സന്ദേശത്തിൽ ഒന്നിലധികം അറ്റാച്ച്‌മെന്റുകൾ ഉള്ളപ്പോൾ "എല്ലാം സംരക്ഷിക്കുക" അറ്റാച്ച്‌മെന്റുകൾ എവിടെ എഴുതുന്നു എന്നത്. ഇല്ലെങ്കിൽ സ്വയമേവ സൃഷ്ടിക്കും. ഒരൊറ്റ അറ്റാച്ച്‌മെന്റുള്ള സന്ദേശം മുമ്പത്തെപ്പോലെ എവിടെ സംരക്ഷിക്കണമെന്ന് ഇപ്പോഴും ചോദിക്കും. സ്ഥിരസ്ഥിതിക്ക് ശൂന്യമാക്കുക:\n{path}
set_autosave_note = നിങ്ങൾ എഴുതുമ്പോൾ തുറന്ന എഴുത്ത് ടാബ് സ്വയം ഡ്രാഫ്റ്റുകളിലേക്ക് എത്ര തവണ സംരക്ഷിക്കുന്നു. ഡ്രാഫ്റ്റ് സംരക്ഷിക്കുക (Ctrl+S) ഏതായാലും ആവശ്യാനുസരണം സംരക്ഷിക്കും, സംരക്ഷിക്കാത്ത എഴുത്തുള്ള ടാബ് അടയ്ക്കുമ്പോൾ അത് സംരക്ഷിക്കാൻ എപ്പോഴും അവസരം നൽകും. ഓഫ് സ്വയമേവ സംരക്ഷിക്കൽ ഓഫാക്കുന്നു. 15 സെക്കൻഡിൽ കുറവ് നൽകുന്നില്ല -- അത് നിങ്ങളുടെ ടൈപ്പിംഗുമായി മത്സരിക്കുന്ന സെർവർ യാത്രയാകും.
set_auto_purge_note = ട്രാഷിലും ജങ്കിലുമുള്ള സന്ദേശങ്ങൾ ഇത്ര ദിവസം അവിടെ ഇരുന്നതിന് ശേഷം ശാശ്വതമായി നീക്കം ചെയ്യുന്നു -- ട്രാഷ് ഒഴിക്കുക, ജങ്ക് ഒഴിക്കുക എന്നിവ ആവശ്യാനുസരണം ചെയ്യുന്ന അതേ ശാശ്വത ഇല്ലാതാക്കൽ, ZBox തുറന്നിരിക്കുമ്പോൾ ദിവസത്തിൽ ഒരിക്കൽ സ്വയമേവ പ്രവർത്തിക്കുന്നു. സ്ഥിരസ്ഥിതിയായി 30 ദിവസത്തിൽ ഓണാണ്. ഓഫ് ഇത് ഓഫാക്കുന്നു. സന്ദേശം നീക്കം ചെയ്താൽ ഇത് പഴയപടിയാക്കാൻ കഴിയില്ല.
set_bare_keys_note = ഓണായിരിക്കുമ്പോൾ, സന്ദേശ പട്ടികയിൽ S, A, J, W അല്ലെങ്കിൽ K ഒറ്റയ്ക്ക് അമർത്തിയാൽ ഉടൻ നക്ഷത്രം മാറ്റുകയോ, ആർക്കൈവ് ചെയ്യുകയോ, തിരഞ്ഞെടുത്ത സന്ദേശങ്ങൾ ജങ്ക് ആയി അടയാളപ്പെടുത്തുകയോ (Shift+J അവ ജങ്ക് അല്ലെന്ന് അടയാളപ്പെടുത്തുന്നു), തിരഞ്ഞെടുപ്പ് ഉൾപ്പെടുന്ന ത്രെഡ് നിരീക്ഷിക്കുകയോ/അവഗണിക്കുകയോ ചെയ്യുന്നു -- ആർക്കൈവ് ചെയ്യുക, ജങ്ക് ആയി അടയാളപ്പെടുത്തുക എന്നിവയ്ക്ക് സ്ഥിരീകരണമോ പഴയപടിയാക്കലോ ഇല്ല. ഇത് ഓഫാക്കിയാൽ S, A, J, W, K എന്നിവ പട്ടികയിലെ സാധാരണ ആദ്യാക്ഷര നാവിഗേഷനിലേക്ക് മടങ്ങും. Ctrl+S, Ctrl+Shift+A എന്നിവ ഏതായാലും പ്രവർത്തിക്കുന്നത് തുടരും. ഉടൻ പ്രാബല്യത്തിൽ വരും.
set_sounds_note = പുരോഗതി, പുതിയ സന്ദേശങ്ങൾ, അയച്ചതോ മറുപടി നൽകിയതോ ഫോർവേഡ് ചെയ്തതോ ആയ പ്രവർത്തനങ്ങൾ, ഇല്ലാതാക്കലുകൾ, തിരയൽ ഫലങ്ങൾ എന്നിവയ്ക്കുള്ള ചെറിയ ശബ്ദങ്ങൾ. ഓഫ് ആപ്പിലെ എല്ലാ ശബ്ദവും പ്രവർത്തനരഹിതമാക്കുന്നു; സ്ക്രീൻ റീഡർ, സ്റ്റാറ്റസ് ബാർ അറിയിപ്പുകളെ ഒരു തരത്തിലും ബാധിക്കില്ല.
set_desktop_notifications_note = മുകളിലെ ശബ്ദത്തിൽ നിന്ന് വേറിട്ട്, ഓരോ പുതിയ മെയിൽ ബാച്ചിനും ഒരു Windows അറിയിപ്പ്. ഓഫ് ഇത് എല്ലാ അക്കൗണ്ടുകൾക്കും പ്രവർത്തനരഹിതമാക്കുന്നു; ഒരു അക്കൗണ്ടിനെ അക്കൗണ്ട്, ഐഡന്റിറ്റി ക്രമീകരണങ്ങളിൽ വേറിട്ട് മ്യൂട്ട് ചെയ്യുകയും ചെയ്യാം.
set_theme_note = ഇഷ്ടാനുസൃത തീമുകൾ ZBox-ന്റെ sounds ഫോൾഡറിനുള്ളിൽ ഇടുന്ന ഫോൾഡറുകളാണ്, ഓരോന്നും സ്വന്തം progress-tick.wav, incoming-message.wav, action-done.wav, delete.wav, searching.wav, searching_done.wav, none_found.wav എന്നിവ നൽകുന്നു. കാണാതായ തീം ഫയൽ സ്ഥിരസ്ഥിതി ശബ്ദത്തിലേക്ക് മടങ്ങും.
set_theme_note_only_default = ഇഷ്ടാനുസൃത തീമുകൾ ZBox-ന്റെ sounds ഫോൾഡറിനുള്ളിൽ ഇടുന്ന ഫോൾഡറുകളാണ്, ഓരോന്നും സ്വന്തം progress-tick.wav, incoming-message.wav, action-done.wav, delete.wav, searching.wav, searching_done.wav, none_found.wav എന്നിവ നൽകുന്നു. കാണാതായ തീം ഫയൽ സ്ഥിരസ്ഥിതി ശബ്ദത്തിലേക്ക് മടങ്ങും. നിങ്ങൾ മറ്റൊരു തീം ഫോൾഡർ ചേർക്കുന്നത് വരെ "default" മാത്രമേ ലഭ്യമാകൂ.
set_lock_note = ZBox ആരംഭിക്കുമ്പോൾ ഏതെങ്കിലും അക്കൗണ്ട് തുറക്കുന്നതിന് മുമ്പ് നിങ്ങളുടെ അൺലോക്ക് രീതികളിലൊന്ന് ചോദിക്കുന്നു. അവയിൽ ഏതെങ്കിലും ഒന്ന് മതി: പാസ്‌കീ, സുരക്ഷാ കീ, അല്ലെങ്കിൽ മാസ്റ്റർ പാസ്‌വേഡ്. ട്രേയിലേക്ക് അടയ്ക്കുന്നത് പുറത്തുകടക്കലല്ല, വീണ്ടും ലോക്ക് ചെയ്യുന്നുമില്ല; ഫയൽ > പുറത്തുകടക്കുക, ട്രേ ഐക്കണിന്റെ പുറത്തുകടക്കുക എന്നിവ അങ്ങനെ ചെയ്യുന്നു. ഒന്നും രജിസ്റ്റർ ചെയ്യാതെയും മാസ്റ്റർ പാസ്‌വേഡ് സജ്ജമാക്കാതെയും ഇരുന്നാൽ, നിങ്ങളുടെ സ്വന്തം മെയിലിൽ നിന്ന് നിങ്ങളെ പുറത്താക്കുന്നതിന് പകരം ലോക്ക് ഒഴിവാക്കും.
set_security_note = മൂന്നിൽ ഒന്നും എൻക്രിപ്റ്റ് ചെയ്യുന്നത് മാസ്റ്റർ പാസ്‌വേഡ് മാത്രമാണ്: ഈ ഫോൾഡറിന് മറ്റൊരു കമ്പ്യൂട്ടറിൽ സംരക്ഷിച്ച അക്കൗണ്ട് പാസ്‌വേഡുകൾ തുറക്കാൻ അനുവദിക്കുന്നത് അതാണ്. പാസ്‌കീ അല്ലെങ്കിൽ സുരക്ഷാ കീ ഈ ഒരു കമ്പ്യൂട്ടറിൽ മാത്രം ആപ്പ് അൺലോക്ക് ചെയ്യുന്നു. ZBox മുമ്പ് ഉപയോഗിക്കാത്ത കമ്പ്യൂട്ടറിൽ അവയിലൊന്നും മാസ്റ്റർ പാസ്‌വേഡിന് പകരമാകില്ല.
set_private_mode_note = സന്ദേശങ്ങൾ സെർവറിൽ നിന്ന് വായിച്ച് മെമ്മറിയിൽ മാത്രം സൂക്ഷിക്കുന്നു. ഓഫ്‌ലൈൻ പകർപ്പുകൾ, സംരക്ഷിച്ച സന്ദേശങ്ങൾ, ഡീബഗ് ലോഗുകൾ എന്നിവ സൂക്ഷിക്കില്ല, തുറന്ന അറ്റാച്ച്‌മെന്റുകളും HTML മെയിലിന്റെ ബ്രൗസർ ഡാറ്റയും ZBox അടയ്ക്കുമ്പോൾ ഇല്ലാതാക്കും. അടയ്ക്കുന്നത് ZBox ആരംഭിച്ച എല്ലാ പ്രോഗ്രാമുകളെയും, അറ്റാച്ച്‌മെന്റ് കാണിക്കുന്നവ ഉൾപ്പെടെ, അവസാനിപ്പിക്കുകയും, ക്ലിപ്ബോർഡ് ഒഴിക്കുകയും, സ്വകാര്യ മോഡ് ഈ കമ്പ്യൂട്ടറിൽ നിന്ന് തന്നെ ഓണാക്കിയതല്ലെങ്കിൽ ഈ കമ്പ്യൂട്ടറിനെ വിശ്വസിക്കുന്നത് നിർത്തുകയും ചെയ്യുന്നു. USB ഡ്രൈവുകളുടെ പട്ടിക, പേജ് ഫയൽ, ആന്റിവൈറസ്, നെറ്റ്‌വർക്ക് ലോഗുകൾ പോലെ ഒരു പ്രോഗ്രാമിനും നീക്കം ചെയ്യാനാകാത്ത ചില രേഖകൾ Windows ഇപ്പോഴും സൂക്ഷിക്കുന്നു.
title_private_mode = സ്വകാര്യ മോഡ്
private_mode_need_master = സ്വകാര്യ മോഡിന് മാസ്റ്റർ പാസ്‌വേഡ് ആവശ്യമാണ്, കാരണം നിങ്ങളുടേതല്ലാത്ത കമ്പ്യൂട്ടറിൽ നിങ്ങളുടെ അക്കൗണ്ടുകൾ തുറക്കുന്നത് മാസ്റ്റർ പാസ്‌വേഡ് മാത്രമാണ്. മാസ്റ്റർ പാസ്‌വേഡ് ബട്ടൺ ഉപയോഗിച്ച് ഒന്ന് സജ്ജമാക്കുക, തുടർന്ന് സ്വകാര്യ മോഡ് ഓണാക്കുക.
private_mode_enter_master = സ്വകാര്യ മോഡ് ഓണാക്കാൻ മാസ്റ്റർ പാസ്‌വേഡ് നൽകുക.
private_mode_confirm = സ്വകാര്യ മോഡ് ഈ കമ്പ്യൂട്ടറിലോ ZBox പ്രവർത്തിക്കുന്ന ഡ്രൈവിലോ നിങ്ങളുടെ മെയിലിന്റെ പകർപ്പുകൾ സൂക്ഷിക്കില്ല. ഇത് ഓണാക്കുന്നത് ZBox-ന്റെ ഓഫ്‌ലൈൻ പകർപ്പുകൾ, സംരക്ഷിച്ച സന്ദേശങ്ങൾ, തുറന്ന അറ്റാച്ച്‌മെന്റുകൾ, HTML മെയിലിന്റെ ബ്രൗസർ ഡാറ്റ, ഡീബഗ് ലോഗുകൾ എന്നിവ ഇല്ലാതാക്കും. നിങ്ങളുടെ മെയിൽ സെർവറുകളിൽ ഒന്നും ഇല്ലാതാക്കില്ല, നിങ്ങളുടെ അക്കൗണ്ടുകൾ, കോൺടാക്റ്റുകൾ, ക്രമീകരണങ്ങൾ എന്നിവ നിലനിർത്തും. സ്വകാര്യ മോഡ് ഓണാക്കണോ?
set_minimize_note = ZBox ചെറുതാക്കുന്നത് അതിന്റെ ടാസ്‌ക്ബാർ ബട്ടൺ മറയ്ക്കുകയും ട്രേ ഐക്കണിന് പിന്നിൽ പ്രവർത്തിക്കുന്നത് തുടരുകയും ചെയ്യുന്നു. വിൻഡോ തിരികെ കൊണ്ടുവരാൻ ട്രേ ഐക്കണിൽ ഇടത് ക്ലിക്ക് ചെയ്യുക (അല്ലെങ്കിൽ കീബോർഡ് ഫോക്കസ് ഉള്ളപ്പോൾ Enter/Space അമർത്തുക).
set_close_note = വിൻഡോയുടെ അടയ്ക്കുക ബട്ടൺ, Alt+F4, മെയിൽ ടാബിലെ Ctrl+W എന്നിവ ZBox പുറത്തുകടക്കുന്നതിന് പകരം ട്രേയിൽ മറയ്ക്കുന്നു. ഫയൽ > പുറത്തുകടക്കുക (Ctrl+Shift+Q), ട്രേ ഐക്കണിന്റെ സ്വന്തം പുറത്തുകടക്കുക എന്നിവ ഏതായാലും ZBox-നെ യഥാർത്ഥത്തിൽ പുറത്താക്കുന്നു, അതിനാൽ ട്രേ തൊടാതെ പുറത്തുകടക്കാൻ എപ്പോഴും ഒരു കീബോർഡ് വഴിയുണ്ട്.
set_stay_maximized_note = ZBox വലുതാക്കി ആരംഭിക്കുകയും നിങ്ങൾ വലുതാക്കൽ മാറ്റിയാൽ വീണ്ടും വലുതാക്കുകയും ചെയ്യും. മെനു ബാർ, ശീർഷക ബാർ, വിൻഡോ ബോർഡർ എന്നിവയെ ബാധിക്കില്ല -- ഇത് ബോർഡറില്ലാത്ത പൂർണ്ണ സ്ക്രീൻ മോഡ് അല്ല, അതിനാൽ എല്ലാ Alt-കീ മെനു ഷോർട്ട്കട്ടും പ്രവർത്തിക്കുന്നത് തുടരുന്നു.
set_run_at_startup_note = നിങ്ങൾ Windows-ൽ സൈൻ ഇൻ ചെയ്യുമ്പോൾ ZBox സ്വയമേവ ആരംഭിക്കുന്നു, അതിന്റെ വിൻഡോ കാണിക്കാതെ നേരിട്ട് ട്രേയിൽ തുറക്കുന്നു. അടുത്ത ആരംഭം വരെ കാത്തിരിക്കാതെ ഉടൻ പ്രാബല്യത്തിൽ വരും.
set_desktop_shortcut_note = നിങ്ങളുടെ ഡെസ്‌ക്ടോപ്പിൽ ഒരു ZBox ഷോർട്ട്കട്ട് വയ്ക്കുന്നു, അവിടെ നിലവിലുള്ളതിനെ മാറ്റിസ്ഥാപിക്കുന്നു. ഷോർട്ട്കട്ട് ഈ ZBox ഫോൾഡറിന്റെ കൃത്യമായ സ്ഥാനം സംഭരിക്കുന്നു, അതിനാൽ നിങ്ങൾ ZBox മറ്റെവിടെയെങ്കിലും നീക്കുകയോ പകർത്തുകയോ ചെയ്താൽ, ഡെസ്‌ക്ടോപ്പ് ഷോർട്ട്കട്ട് അവിടേക്ക് ചൂണ്ടാൻ പുതിയ പകർപ്പിൽ ഇത് വീണ്ടും അമർത്തുക. ഉടൻ പ്രാബല്യത്തിൽ വരും, ശരി-ക്കായി കാത്തിരിക്കില്ല.


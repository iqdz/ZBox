# ZBox interface language file.
#
# To translate ZBox, copy this file, rename it to your language code
# with the same .lang ending -- fr.lang, ar.lang, es.lang -- and put
# it in this same folder. Then change only the text on the right of
# each equals sign. Leave the section names in square brackets and
# the key names on the left exactly as they are: they are what ZBox
# looks the text up by, and translating them makes the line do
# nothing.
#
# Anything in curly braces is filled in by ZBox, so {count} becomes a
# number and {word} becomes a word. Keep every one that appears on a
# line, spelled the same way. You may move them wherever your own
# grammar needs them.
#
# Where a line ends in _one and another ends in _many, they are the
# singular and the plural of the same message. If your language needs
# a different split, write whatever is correct in each: ZBox picks
# _one when the number is exactly one and _many otherwise.
#
# A key you have not translated yet is heard in English rather than
# being silent, so a part-finished file is safe to use and safe to
# share.
#
# Save the file as UTF-8. Lines beginning with a hash are notes and
# are ignored.

[meta]
name = മലയാളം
code = ml
direction = ltr
translator = ZBox
app_version = 2026.09

# Everything ZBox says out loud when an action finishes.
[actions_announcements]

# Writing a message
message_sent = സന്ദേശം അയച്ചു.
draft_saved = ഡ്രാഫ്റ്റ് സംരക്ഷിച്ചു.
signature_inserted = ഒപ്പ് ചേർത്തു.
signature_none = ഈ അക്കൗണ്ടിന് ഒപ്പ് ഇല്ല.
signature_saved = ഒപ്പ് സംരക്ഷിച്ചു.
signature_not_saved = ഒപ്പ് സംരക്ഷിച്ചില്ല.
pasted_as_quotation = ഉദ്ധരണിയായി ഒട്ടിച്ചു.
clipboard_empty = ക്ലിപ്ബോർഡിൽ ഒന്നുമില്ല.
word_count = {words} വാക്കുകൾ, {characters} അക്ഷരങ്ങൾ.
report_copied = റിപ്പോർട്ട് പകർത്തി.
compose_tab_needed = ആ കമാൻഡിന് എഴുത്ത് ടാബ് ആവശ്യമാണ്.
attach_file_instead = വലിച്ചിട്ട ഫയലുകൾ സന്ദേശ വാചകത്തിൽ ചേർക്കില്ല. ഒന്ന് അയയ്ക്കാൻ ഫയൽ അറ്റാച്ച് ചെയ്യുക ഉപയോഗിക്കുക.

# Formatting in the message body
formatting_here = ഇവിടെ ഫോർമാറ്റിംഗ്: {formatting}.
no_formatting_here = ഇവിടെ ഫോർമാറ്റിംഗ് ഇല്ല, സാധാരണ വാചകം.

# Spelling
nothing_to_check = പരിശോധിക്കാൻ ഒന്നുമില്ല.
no_misspellings = അക്ഷരപ്പിശകുകൾ ഇല്ല.
spelling_dictionary_unavailable = അക്ഷരപ്പിശക് നിഘണ്ടു ലഭ്യമല്ല.
next_misspelling_first = ആദ്യം അടുത്ത അക്ഷരപ്പിശക് ഉപയോഗിക്കുക.
word_added = {word} നിഘണ്ടുവിൽ ചേർത്തു.
word_not_added = {word} ചേർക്കാനായില്ല.
corrections_applied_one = 1 തിരുത്തൽ പ്രയോഗിച്ചു.
corrections_applied_many = {count} തിരുത്തലുകൾ പ്രയോഗിച്ചു.
corrections_applied_partly = {total}-ൽ {applied} തിരുത്തലുകൾ പ്രയോഗിച്ചു. ബാക്കിയുള്ളവ നിരസിച്ചു; ലോഗ് കാണുക.
occurrences_replaced_one = 1 സ്ഥലം മാറ്റിസ്ഥാപിച്ചു.
occurrences_replaced_many = {count} സ്ഥലങ്ങൾ മാറ്റിസ്ഥാപിച്ചു.

# Reading mail
message_did_not_open = സന്ദേശം തുറന്നില്ല. സെർവർ പ്രതികരിച്ചില്ല. വീണ്ടും ശ്രമിക്കാൻ Enter അമർത്തുക.
thread_open = ഈ ത്രെഡിൽ {messages}. അടയ്ക്കാൻ വീണ്ടും അമർത്തുക.
no_thread_selected = ത്രെഡ് തിരഞ്ഞെടുത്തിട്ടില്ല.
thread_watched = ത്രെഡ് നിരീക്ഷിക്കുന്നു.
thread_not_watched = ത്രെഡ് ഇനി നിരീക്ഷിക്കില്ല.
thread_ignored = ത്രെഡ് അവഗണിച്ചു.
thread_not_ignored = ത്രെഡ് ഇനി അവഗണിക്കില്ല.
none_found = ഒന്നും കണ്ടെത്തിയില്ല.
refreshing_this_folder = ഈ ഫോൾഡർ പുതുക്കുന്നു.
refreshing_all_accounts = എല്ലാ അക്കൗണ്ടുകളും പുതുക്കുന്നു.
message_view_html = സന്ദേശ കാഴ്ച: HTML (റെൻഡർ ചെയ്തത്).
message_view_text = സന്ദേശ കാഴ്ച: വാചകം.
html_view_still_loading = സന്ദേശം ഇപ്പോഴും ലോഡ് ചെയ്യുന്നു. Escape അത് അടയ്ക്കും.
message_still_opening = സന്ദേശം തുറക്കുന്നു. സെർവർ മന്ദഗതിയിലാണ്.
remote_content_blocked = റിമോട്ട് ഉള്ളടക്കം തടഞ്ഞു.
remote_content_unblocked = റിമോട്ട് ഉള്ളടക്കത്തിന്റെ തടസ്സം നീക്കി.
remote_content_already_showing = ഈ സന്ദേശത്തിൽ റിമോട്ട് ഉള്ളടക്കം ഇതിനകം കാണിക്കുന്നു.
archived = ആർക്കൈവ് ചെയ്തു.
copied_to_folder = {to_folder}-ലേക്ക് പകർത്തി.
deleted_one = സന്ദേശം ശാശ്വതമായി ഇല്ലാതാക്കി.
deleted_many = {count} സന്ദേശങ്ങൾ ശാശ്വതമായി ഇല്ലാതാക്കി.
trashed_one = സന്ദേശം ട്രാഷിലേക്ക് മാറ്റി.
trashed_many = {count} സന്ദേശങ്ങൾ ട്രാഷിലേക്ക് മാറ്റി.

# Accounts and new mail
no_account_yet = ചാടിപ്പോകാൻ ഇതുവരെ അക്കൗണ്ട് ഇല്ല.
inbox_landed = {name} ഇൻബോക്സ്.
account_enabled = {name} പ്രവർത്തനക്ഷമമാക്കി.
auto_check_paused = {account}-നുള്ള സ്വയമേവയുള്ള പരിശോധന താൽക്കാലികമായി നിർത്തി.
auto_check_resumed = {account}-നുള്ള സ്വയമേവയുള്ള പരിശോധന ഓണാക്കി.
account_disabled = {name} പ്രവർത്തനരഹിതമാക്കി.
new_mail_one = {name}-ന് 1 പുതിയ സന്ദേശം.
new_mail_many = {name}-ന് {count} പുതിയ സന്ദേശങ്ങൾ.
refresh_all_done_one = 1 അക്കൗണ്ട് പുതുക്കി.
refresh_all_done_many = {count} അക്കൗണ്ടുകൾ പുതുക്കി.
refresh_all_done_failures = {count} അക്കൗണ്ടുകൾ പുതുക്കി, {failed} പുതുക്കാനായില്ല.
refresh_all_done_failures_one = {count} അക്കൗണ്ട് പുതുക്കി, {failed} പുതുക്കാനായില്ല.

# The sender of the message in view
sender_address_copied = {sender}. വിലാസം പകർത്തി.
sender_no_address = {sender}. പകർത്താൻ വിലാസമില്ല.
clipboard_not_opened = {sender}. ക്ലിപ്ബോർഡ് തുറക്കാനായില്ല.

# The signature editor
signature_page_formatted = ഫോർമാറ്റ് ചെയ്തത്. ഇതാണ് സംരക്ഷിക്കുക.
signature_page_html = HTML ഉറവിടം. ഇതാണ് സംരക്ഷിക്കുക.
signature_page_html_still_wins = ഫോർമാറ്റ് ചെയ്തത്. HTML ഉറവിടമാണ് ഇപ്പോഴും സംരക്ഷിക്കുക.

# Background work
phishing_list_updating = ഫിഷിംഗ് പട്ടിക പശ്ചാത്തലത്തിൽ പുതുക്കുന്നു.
cache_cleared = {files} കാഷെ ഫയലുകൾ മായ്ച്ചു, {size} MB.
hotkeys_diagnostic_on = ഷോർട്ട്കട്ട് കീ ഡയഗ്നോസ്റ്റിക് ഓൺ, ചെക്ക് ചെയ്തു
hotkeys_diagnostic_off = ഷോർട്ട്കട്ട് കീ ഡയഗ്നോസ്റ്റിക് ഓഫ്, ചെക്ക് മാറ്റി

# What a bulk action is called, when ZBox says which one just
# finished. These are names, not sentences.
action_archive = ആർക്കൈവ് ചെയ്യുക
action_delete = ഇല്ലാതാക്കുക
action_delete_permanently = ശാശ്വതമായി ഇല്ലാതാക്കുക
action_mark_as_junk = ജങ്ക് ആയി അടയാളപ്പെടുത്തുക
action_mark_as_not_junk = ജങ്ക് അല്ലെന്ന് അടയാളപ്പെടുത്തുക
action_move_to = നീക്കുക
action_copy_to = പകർത്തുക
action_mark_message = സന്ദേശം അടയാളപ്പെടുത്തുക
action_undo = പഴയപടിയാക്കുക

# Finishing an action on one or more messages. {action} is one of the
# names just above and {to_folder} is one of your own folders.
undo_done_one = {action} പഴയപടിയാക്കി.
undo_done_many = {count} സന്ദേശങ്ങൾക്കുള്ള {action} പഴയപടിയാക്കി.
junk_marked_one = ജങ്ക് ആയി അടയാളപ്പെടുത്തി.
junk_marked_many = {count} സന്ദേശങ്ങൾ ജങ്ക് ആയി അടയാളപ്പെടുത്തി.
junk_no_new_sender = പുതിയ അയച്ചയാളെ തടഞ്ഞില്ല: നേരത്തേ തടഞ്ഞത്, മെയിലിംഗ് ലിസ്റ്റ്, അല്ലെങ്കിൽ നിങ്ങളുടെ സ്വന്തം വിലാസങ്ങളിൽ ഒന്ന്.
not_junk_marked_one = ജങ്ക് അല്ലെന്ന് അടയാളപ്പെടുത്തി.
not_junk_marked_many = {count} സന്ദേശങ്ങൾ ജങ്ക് അല്ലെന്ന് അടയാളപ്പെടുത്തി.
moved_to_one = {to_folder}-ലേക്ക് നീക്കി.
moved_to_many = {count} സന്ദേശങ്ങൾ {to_folder}-ലേക്ക് നീക്കി.
copied_to_many = {count} സന്ദേശങ്ങൾ {to_folder}-ലേക്ക് പകർത്തി.
marked_read = വായിച്ചതായി അടയാളപ്പെടുത്തി.
marked_unread = വായിക്കാത്തതായി അടയാളപ്പെടുത്തി.

# When a run of several messages is stopped or partly fails. {done}
# is the ordinary finished message above, spoken first.
bulk_cancelled = {total}-ൽ {completed} ശേഷം റദ്ദാക്കി. {succeeded} വിജയിച്ചു, {failed} പരാജയപ്പെട്ടു.
bulk_failed_one = 1 സന്ദേശത്തിൽ {failed} {done} പരാജയപ്പെട്ടു.
bulk_failed_many = {total} സന്ദേശങ്ങളിൽ {failed} {done} പരാജയപ്പെട്ടു.

# Formatting, as it is spoken while writing. The word on the left of
# each format_word line is ZBox's own name for that formatting and is
# never translated; the text on the right is what is said.
format_word_bold = കട്ടി
format_word_italic = ചരിഞ്ഞത്
format_word_strike = വെട്ടിയത്
format_word_href = ലിങ്ക്
format_word_bullet = ബുള്ളറ്റ് പട്ടിക
format_word_number = നമ്പർ പട്ടിക
format_word_quote = ഉദ്ധരണി
format_word_code = കോഡ്
format_word_heading1 = തലക്കെട്ട്
format_applied = {formatting} പ്രയോഗിച്ചു.
format_inserted = {formatting} ചേർത്തു.
format_not_available = സാധാരണ സന്ദേശ ബോഡിയിൽ {formatting} ലഭ്യമല്ല.
format_on = {formatting} ഓൺ
format_off = {formatting} ഓഫ്
link_applied = ലിങ്ക് പ്രയോഗിച്ചു.
link_applied_to_selection = തിരഞ്ഞെടുത്തതിൽ ലിങ്ക് പ്രയോഗിച്ചു.
plain_body_formatting = സാധാരണ സന്ദേശ ബോഡി അതിന്റെ ഫോർമാറ്റിംഗ് ടാഗുകളായി കാണിക്കുന്നു.

# Reaching either end of a thread
thread_edge_first = ഈ ത്രെഡിലെ ആദ്യ സന്ദേശം. അടയ്ക്കാൻ വീണ്ടും അമർത്തുക.
thread_edge_last = ഈ ത്രെഡിലെ അവസാന സന്ദേശം. അടയ്ക്കാൻ വീണ്ടും അമർത്തുക.
jump_unified_inbox = ഏകീകൃത ഇൻബോക്സ്.
remote_none = ഈ സന്ദേശത്തിൽ റിമോട്ട് ഉള്ളടക്കമില്ല.
sender_none = ഈ സന്ദേശത്തിൽ അയച്ചയാൾ ഇല്ല.
sender_name_no_address = %s, വിലാസമില്ല
signature_not_switched = ഒപ്പ് മാറ്റിയില്ല. ഈ അക്കൗണ്ടിന്റെ ഒപ്പ് ചേർക്കാൻ Ctrl+Shift+S അമർത്തുക.
signature_removed_no_signature = ഒപ്പ് നീക്കി. ഈ അക്കൗണ്ടിന് ഒന്നുമില്ല.
signature_switched = ഒപ്പ് ഈ അക്കൗണ്ടിന്റേതാക്കി മാറ്റി.
spell_not_replaced = വാക്ക് മാറ്റിസ്ഥാപിച്ചില്ല.
spell_replaced_with = {word} ഉപയോഗിച്ച് മാറ്റിസ്ഥാപിച്ചു.
folder_marked_read = {count} സന്ദേശങ്ങൾ വായിച്ചതായി അടയാളപ്പെടുത്തി.
folder_no_unread = വായിക്കാത്ത സന്ദേശങ്ങളില്ല.
threads_all_collapsed = എല്ലാ ത്രെഡുകളും ചുരുക്കി.
threads_all_expanded = എല്ലാ ത്രെഡുകളും വികസിപ്പിച്ചു.
upd_percent = {percent} ശതമാനം
upd_download_done = ഡൗൺലോഡ് പൂർത്തിയായി. അപ്‌ഡേറ്റ് തയ്യാറാക്കുന്നു...
upd_updated_to = ZBox {version}-ലേക്ക് അപ്‌ഡേറ്റ് ചെയ്തു.
header_copied = പകർത്തി.
headers_copied = എല്ലാ ഹെഡറുകളും പകർത്തി.
identity_copies_updated = ഈ ഐഡന്റിറ്റിക്കുള്ള പകർപ്പും രഹസ്യ പകർപ്പും പുതുക്കി.
signature_switched_identity = ഒപ്പ് ഈ ഐഡന്റിറ്റിയുടേതാക്കി മാറ്റി.
signature_removed_identity = ഒപ്പ് നീക്കി. ഈ ഐഡന്റിറ്റിക്ക് ഒന്നുമില്ല.

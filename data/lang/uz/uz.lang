unl_status_reassigned = {name} qo‘shildi va boshqa kompyuterlardan {count} tasi unutildi.
unl_status_test_cancelled = Sinov bekor qilindi.
unl_status_removed = Olib tashlandi.
unl_remove_warning_last = {name} olib tashlansinmi?\n\nU ro‘yxatdan o‘tkazilgan yagona ochish usuli va bosh parol belgilanmagan, shuning uchun ilova qulfi yoqilganda ZBoxni ochadigan hech narsa qolmaydi. Sizni qulflab qo‘yish o‘rniga qulf o‘tkazib yuboriladi, lekin ZBox shunda qulflanmagan holda ochiladi.
unl_remove_warning = {name} olib tashlansinmi? ZBox uni boshqa qabul qilmaydi.

hotkeys_diagnostic_off = Η διάγνωση πλήκτρων συντόμευσης είναι ανενεργή, μη επιλεγμένη

# What a bulk action is called, when ZBox says which one just
# finished. These are names, not sentences.
action_archive = Αρχειοθέτηση
action_delete = Διαγραφή
action_delete_permanently = Οριστική διαγραφή
action_mark_as_junk = Επισήμανση ως ανεπιθύμητο
action_mark_as_not_junk = Επισήμανση ως όχι ανεπιθύμητο
action_move_to = Μετακίνηση σε
action_copy_to = Αντιγραφή σε
action_mark_message = Επισήμανση μηνύματος
action_undo = Αναίρεση

# Finishing an action on one or more messages. {action} is one of the
# names just above and {to_folder} is one of your own folders.
undo_done_one = Αναιρέθηκε: {action}.
undo_done_many = Αναιρέθηκε: {action} για {count} μηνύματα.
junk_marked_one = Επισημάνθηκε ως ανεπιθύμητο.
junk_marked_many = {count} μηνύματα επισημάνθηκαν ως ανεπιθύμητα.
junk_no_new_sender = Δεν αποκλείστηκε νέος αποστολέας: είναι ήδη αποκλεισμένος, λίστα αλληλογραφίας ή μία από τις δικές σας διευθύνσεις.
not_junk_marked_one = Επισημάνθηκε ως όχι ανεπιθύμητο.
not_junk_marked_many = {count} μηνύματα επισημάνθηκαν ως όχι ανεπιθύμητα.
moved_to_one = Μετακινήθηκε στον φάκελο {to_folder}.
moved_to_many = Μετακινήθηκαν {count} μηνύματα στον φάκελο {to_folder}.
copied_to_many = Αντιγράφηκαν {count} μηνύματα στον φάκελο {to_folder}.
marked_read = Επισημάνθηκε ως αναγνωσμένο.
marked_unread = Επισημάνθηκε ως μη αναγνωσμένο.

# When a run of several messages is stopped or partly fails. {done}
# is the ordinary finished message above, spoken first.
bulk_cancelled = Ακυρώθηκε μετά από {completed} από {total}. {succeeded} πέτυχαν, {failed} απέτυχαν.
bulk_failed_one = {done} {failed} από 1 μήνυμα απέτυχε.
bulk_failed_many = {done} {failed} από {total} μηνύματα απέτυχαν.


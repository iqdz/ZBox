format_word_italic = Πλάγια
format_word_strike = Διαγραμμισμένο
format_word_href = Σύνδεσμος
format_word_bullet = Λίστα με κουκκίδες
format_word_number = Αριθμημένη λίστα
format_word_quote = Παράθεση
format_word_code = Κώδικας
format_word_heading1 = Επικεφαλίδα
format_applied = Εφαρμόστηκε: {formatting}.
format_inserted = Εισήχθη: {formatting}.
format_not_available = Το {formatting} δεν είναι διαθέσιμο στο απλό σώμα μηνύματος.
format_on = {formatting} ενεργό
format_off = {formatting} ανενεργό
link_applied = Ο σύνδεσμος εφαρμόστηκε.
link_applied_to_selection = Ο σύνδεσμος εφαρμόστηκε στην επιλογή.
plain_body_formatting = Το απλό σώμα μηνύματος δείχνει τη μορφοποίησή του ως ετικέτες.


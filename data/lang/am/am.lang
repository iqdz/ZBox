# ZBox interface language file.
#
# To translate ZBox, copy this file, rename it to your language code
# with the same .lang ending -- fr.lang, ar.lang, es.lang -- and put
# it in this same folder. Then change only the text on the right of
# each equals sign. Leave the section names in square brackets and
# the key names on the left exactly as they are: they are what ZBox
# looks the text up by, and translating them makes the line do
# nothing.
#
# Anything in curly braces is filled in by ZBox, so {count} becomes a
# number and {word} becomes a word. Keep every one that appears on a
# line, spelled the same way. You may move them wherever your own
# grammar needs them.
#
# Where a line ends in _one and another ends in _many, they are the
# singular and the plural of the same message. If your language needs
# a different split, write whatever is correct in each: ZBox picks
# _one when the number is exactly one and _many otherwise.
#
# A key you have not translated yet is heard in English rather than
# being silent, so a part-finished file is safe to use and safe to
# share.
#
# Save the file as UTF-8. Lines beginning with a hash are notes and
# are ignored.

[meta]
name = አማርኛ
code = am
direction = ltr
translator = ZBox
app_version = 2026.09

# Everything ZBox says out loud when an action finishes.
[actions_announcements]

# Writing a message
message_sent = መልዕክቱ ተልኳል።
draft_saved = ረቂቁ ተቀምጧል።
signature_inserted = ፊርማው ገብቷል።
signature_none = ይህ መለያ ፊርማ የለውም።
signature_saved = ፊርማው ተቀምጧል።
signature_not_saved = ፊርማው አልተቀመጠም።
pasted_as_quotation = እንደ ጥቅስ ተለጥፏል።
clipboard_empty = ቅንጥብ ሰሌዳው ባዶ ነው።
word_count = {words} ቃላት፣ {characters} ፊደላት።
report_copied = ሪፖርቱ ተቀድቷል።
compose_tab_needed = ያ ትዕዛዝ የመጻፊያ ትር ያስፈልገዋል።
attach_file_instead = የተጣሉ ፋይሎች ወደ መልዕክቱ ጽሑፍ አይገቡም። አንዱን ለመላክ ፋይል አያይዝ ይጠቀሙ።

# Formatting in the message body
formatting_here = እዚህ ቅርጸት: {formatting}።
no_formatting_here = እዚህ ቅርጸት የለም፣ ተራ ጽሑፍ።

# Spelling
nothing_to_check = የሚመረመር ነገር የለም።
no_misspellings = የፊደል ስህተቶች የሉም።
spelling_dictionary_unavailable = የፊደል ማረሚያ መዝገበ ቃላት አይገኝም።
next_misspelling_first = መጀመሪያ ቀጣዩን የፊደል ስህተት ይጠቀሙ።
word_added = {word} ወደ መዝገበ ቃላት ተጨምሯል።
word_not_added = {word} መጨመር አልተቻለም።
corrections_applied_one = 1 እርማት ተተግብሯል።
corrections_applied_many = {count} እርማቶች ተተግብረዋል።
corrections_applied_partly = ከ{total} {applied} እርማቶች ተተግብረዋል። የተቀሩት ተቀባይነት አላገኙም፤ መዝገቡን ይመልከቱ።
occurrences_replaced_one = 1 ቦታ ተተክቷል።
occurrences_replaced_many = {count} ቦታዎች ተተክተዋል።

# Reading mail
message_did_not_open = መልዕክቱ አልተከፈተም። አገልጋዩ አልመለሰም። እንደገና ለመሞከር Enter ይጫኑ።
thread_open = በዚህ ክር ውስጥ {messages}። ለመዝጋት እንደገና ይጫኑ።
no_thread_selected = ምንም ክር አልተመረጠም።
thread_watched = ክሩ እየተከታተለ ነው።
thread_not_watched = ክሩ ከእንግዲህ አይከታተልም።
thread_ignored = ክሩ ችላ ተብሏል።
thread_not_ignored = ክሩ ከእንግዲህ ችላ አይባልም።
none_found = ምንም አልተገኘም።
refreshing_this_folder = ይህን አቃፊ በማደስ ላይ።
refreshing_all_accounts = ሁሉንም መለያዎች በማደስ ላይ።
message_view_html = የመልዕክት እይታ: HTML (የተሰራ)።
message_view_text = የመልዕክት እይታ: ጽሑፍ።
html_view_still_loading = መልዕክቱ አሁንም በመጫን ላይ ነው። Escape ይዘጋዋል።
message_still_opening = መልዕክቱን በመክፈት ላይ። አገልጋዩ ቀርፋፋ ነው።
remote_content_blocked = የርቀት ይዘት ታግዷል።
remote_content_unblocked = የርቀት ይዘት ዕገዳ ተነስቷል።
remote_content_already_showing = በዚህ መልዕክት የርቀት ይዘት ቀድሞውኑ ይታያል።
archived = ወደ ማህደር ተልኳል።
copied_to_folder = ወደ {to_folder} ተቀድቷል።
deleted_one = መልዕክቱ እስከመጨረሻው ተሰርዟል።
deleted_many = {count} መልዕክቶች እስከመጨረሻው ተሰርዘዋል።
trashed_one = መልዕክቱ ወደ ቆሻሻ መጣያ ተወስዷል።
trashed_many = {count} መልዕክቶች ወደ ቆሻሻ መጣያ ተወስደዋል።

# Accounts and new mail
no_account_yet = ለመዝለል ገና መለያ የለም።
inbox_landed = የ{name} የገቢ መልዕክት ሳጥን።
account_enabled = {name} ነቅቷል።
auto_check_paused = ለ{account} ራስ-ሰር ፍተሻ ቆሟል።
auto_check_resumed = ለ{account} ራስ-ሰር ፍተሻ በርቷል።
account_disabled = {name} ተሰናክሏል።
new_mail_one = ለ{name} 1 አዲስ መልዕክት።
new_mail_many = ለ{name} {count} አዲስ መልዕክቶች።
refresh_all_done_one = 1 መለያ ታድሷል።
refresh_all_done_many = {count} መለያዎች ታድሰዋል።
refresh_all_done_failures = {count} መለያዎች ታድሰዋል፣ {failed} ማደስ አልተሳካም።
refresh_all_done_failures_one = {count} መለያ ታድሷል፣ {failed} ማደስ አልተሳካም።

# The sender of the message in view
sender_address_copied = {sender}። አድራሻው ተቀድቷል።
sender_no_address = {sender}። ለመቅዳት አድራሻ የለም።
clipboard_not_opened = {sender}። ቅንጥብ ሰሌዳው አልተከፈተም።

# The signature editor
signature_page_formatted = ተቀርጿል። የሚቀመጠው ይህ ነው።
signature_page_html = HTML ምንጭ። የሚቀመጠው ይህ ነው።
signature_page_html_still_wins = ተቀርጿል። አሁንም የሚቀመጠው የHTML ምንጭ ነው።

# Background work
phishing_list_updating = የማጭበርበር ዝርዝር ከጀርባ በመዘመን ላይ ነው።
cache_cleared = {files} የመሸጎጫ ፋይሎች ጸድተዋል፣ {size} MB።
hotkeys_diagnostic_on = የአቋራጭ ቁልፍ ምርመራ በርቷል፣ ምልክት ተደርጎበታል
hotkeys_diagnostic_off = የአቋራጭ ቁልፍ ምርመራ ጠፍቷል፣ ምልክት ተነስቷል

# What a bulk action is called, when ZBox says which one just
# finished. These are names, not sentences.
action_archive = ወደ ማህደር ላክ
action_delete = ሰርዝ
action_delete_permanently = እስከመጨረሻው ሰርዝ
action_mark_as_junk = እንደ አይፈለጌ ምልክት አድርግ
action_mark_as_not_junk = አይፈለጌ አይደለም ብለህ ምልክት አድርግ
action_move_to = ውሰድ
action_copy_to = ቅዳ
action_mark_message = መልዕክቱን ምልክት አድርግ
action_undo = ቀልብስ

# Finishing an action on one or more messages. {action} is one of the
# names just above and {to_folder} is one of your own folders.
undo_done_one = {action} ተቀልብሷል።
undo_done_many = ለ{count} መልዕክቶች {action} ተቀልብሷል።
junk_marked_one = እንደ አይፈለጌ ምልክት ተደርጓል።
junk_marked_many = {count} መልዕክቶች እንደ አይፈለጌ ምልክት ተደርጓል።
junk_no_new_sender = ምንም አዲስ ላኪ አልታገደም፦ አስቀድሞ ታግዷል፣ የመልዕክት ዝርዝር ነው፣ ወይም ከራስዎ አድራሻዎች አንዱ ነው።
not_junk_marked_one = አይፈለጌ አይደለም ተብሎ ምልክት ተደርጓል።
not_junk_marked_many = {count} መልዕክቶች አይፈለጌ አይደሉም ተብለው ምልክት ተደርጓል።
moved_to_one = ወደ {to_folder} ተወስዷል።
moved_to_many = {count} መልዕክቶች ወደ {to_folder} ተወስደዋል።
copied_to_many = {count} መልዕክቶች ወደ {to_folder} ተቀድተዋል።
marked_read = እንደተነበበ ምልክት ተደርጓል።
marked_unread = እንዳልተነበበ ምልክት ተደርጓል።

# When a run of several messages is stopped or partly fails. {done}
# is the ordinary finished message above, spoken first.
bulk_cancelled = ከ{total} {completed} በኋላ ተሰርዟል። {succeeded} ተሳክተዋል፣ {failed} አልተሳኩም።
bulk_failed_one = ከ1 መልዕክት {failed} {done} አልተሳካም።
bulk_failed_many = ከ{total} መልዕክቶች {failed} {done} አልተሳኩም።

# Formatting, as it is spoken while writing. The word on the left of
# each format_word line is ZBox's own name for that formatting and is
# never translated; the text on the right is what is said.
format_word_bold = ደማቅ
format_word_italic = ሰያፍ
format_word_strike = የተሰመረበት
format_word_href = አገናኝ
format_word_bullet = ነጥብ ዝርዝር
format_word_number = ቁጥር ዝርዝር
format_word_quote = ጥቅስ
format_word_code = ኮድ
format_word_heading1 = ርዕስ
format_applied = {formatting} ተተግብሯል።
format_inserted = {formatting} ገብቷል።
format_not_available = በተራ የመልዕክት አካል ውስጥ {formatting} አይገኝም።
format_on = {formatting} በርቷል
format_off = {formatting} ጠፍቷል
link_applied = አገናኙ ተተግብሯል።
link_applied_to_selection = አገናኙ ለተመረጠው ተተግብሯል።
plain_body_formatting = ተራ የመልዕክት አካል ቅርጸቱን እንደ መለያዎች ያሳያል።

# Reaching either end of a thread
thread_edge_first = በዚህ ክር ውስጥ የመጀመሪያው መልዕክት። ለመዝጋት እንደገና ይጫኑ።
thread_edge_last = በዚህ ክር ውስጥ የመጨረሻው መልዕክት። ለመዝጋት እንደገና ይጫኑ።
jump_unified_inbox = የተዋሃደ የገቢ መልዕክት ሳጥን።
remote_none = በዚህ መልዕክት ውስጥ የርቀት ይዘት የለም።
sender_none = በዚህ መልዕክት ውስጥ ላኪ የለም።
sender_name_no_address = %s፣ አድራሻ የለም
signature_not_switched = ፊርማው አልተቀየረም። የዚህን መለያ ፊርማ ለማስገባት Ctrl+Shift+S ይጫኑ።
signature_removed_no_signature = ፊርማው ተወግዷል። ይህ መለያ ፊርማ የለውም።
signature_switched = ፊርማው ወደዚህ መለያ ፊርማ ተቀይሯል።
spell_not_replaced = ቃሉ አልተተካም።
spell_replaced_with = በ{word} ተተክቷል።
folder_marked_read = {count} መልዕክቶች እንደተነበቡ ምልክት ተደርጓል።
folder_no_unread = ያልተነበቡ መልዕክቶች የሉም።
threads_all_collapsed = ሁሉም ክሮች ተጠቅልለዋል።
threads_all_expanded = ሁሉም ክሮች ተዘርግተዋል።
upd_percent = {percent} በመቶ
upd_download_done = ማውረዱ ተጠናቋል። ዝመናውን በማዘጋጀት ላይ...
upd_updated_to = ZBox ወደ {version} ተዘምኗል።
header_copied = ተቀድቷል።

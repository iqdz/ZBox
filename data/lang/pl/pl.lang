# The lock screen and the Unlock Methods dialog: its notes, the name
# a button takes when it is unavailable, and every status line.
unl_note_locked = ZBox jest zablokowany. Użyj jednej z poniższych metod, aby go odblokować. Anulowanie zamyka ZBox bez otwierania żadnego konta.
unl_note_foreign_passkey = Klucz dostępu zapisany w tym folderze należy do innego komputera, więc nie można go tu użyć. Odblokuj kluczem bezpieczeństwa lub hasłem głównym, a następnie w Ustawieniach, Prywatność i bezpieczeństwo, Metody odblokowania skonfiguruj klucz dostępu na tym komputerze.
unl_note_methods = Gdy blokada aplikacji jest włączona, każda z tych metod odblokowuje ZBox, obok hasła głównego. Klucz dostępu korzysta z Windows Hello na tym komputerze; klucz bezpieczeństwa to klucz FIDO2 na USB lub NFC i działa na każdym komputerze, do którego go podłączysz.
unl_note_not_encryption = Te metody odblokowują aplikację. Niczego nie szyfrują: hasło główne pozostaje jedynym sposobem na otwarcie zapisanych haseł kont na komputerze, na którym ten folder nie był wcześniej używany. Trzeba je najpierw ustawić i do tego czasu nie można dodać żadnej z tych metod.
unl_add_passkey_unavailable = &Dodaj klucz dostępu (niedostępne)
unl_add_key_unavailable = &Dodaj klucz bezpieczeństwa (niedostępne)
unl_reassign_unavailable = &Przypisz klucz dostępu do tego komputera (niedostępne)
unl_status_cancelled_passkey = Anulowano klucz dostępu. ZBox nadal jest zablokowany.
unl_status_cancelled_key = Anulowano klucz bezpieczeństwa. ZBox nadal jest zablokowany.
unl_status_enter_password = Wpisz hasło główne.
unl_status_no_master = Nie ustawiono hasła głównego, więc nie można jeszcze dodać klucza dostępu ani klucza bezpieczeństwa. Ustaw je przyciskiem Hasło główne w Ustawieniach, Prywatność i bezpieczeństwo, a potem wróć tutaj. Hasło główne otwiera zapisane hasła kont na innym komputerze; klucz dostępu tylko odblokowuje aplikację na tym komputerze, więc nie może działać samodzielnie.
unl_status_unsupported = System Windows na tym komputerze nie obsługuje kluczy dostępu ani kluczy bezpieczeństwa, więc tutaj ZBox można odblokować tylko hasłem głównym.
unl_status_foreign_one = 1 klucz dostępu należy do innego komputera i nie może tu odblokować ZBox. Przypisanie zastępuje go kluczem utworzonym na tym komputerze.
unl_status_foreign_many = Klucze dostępu należące do innego komputera, które nie mogą tu odblokować ZBox: {count}. Przypisanie zastępuje je kluczem utworzonym na tym komputerze.
unl_status_foreign_one_no_hello = 1 klucz dostępu należy do innego komputera i nie może tu odblokować ZBox. Windows Hello nie jest tu skonfigurowane, więc nie można go zastąpić na tym komputerze; Usuń go zapomina.
unl_status_foreign_many_no_hello = Klucze dostępu należące do innego komputera, które nie mogą tu odblokować ZBox: {count}. Windows Hello nie jest tu skonfigurowane, więc nie można ich zastąpić na tym komputerze; Usuń je zapomina.
unl_status_no_hello = Windows Hello nie jest skonfigurowane na tym komputerze, więc nie można tu dodać klucza dostępu. Klucz bezpieczeństwa nadal można dodać.
unl_status_none_registered = Nie zarejestrowano jeszcze żadnych metod odblokowania.
unl_status_add_cancelled_passkey = Anulowano dodawanie klucza dostępu.
unl_status_add_cancelled_key = Anulowano dodawanie klucza bezpieczeństwa.
unl_status_added = Dodano: {name}.
unl_status_reassign_cancelled = Anulowano przypisanie. Nic nie zostało zmienione.
unl_status_reassigned = Dodano {name} i zapomniano klucze z innych komputerów: {count}.
unl_status_test_cancelled = Test został anulowany.
unl_status_removed = Usunięto.
unl_remove_warning_last = Usunąć {name}?\n\nTo jedyna zarejestrowana metoda odblokowania i nie ustawiono hasła głównego, więc przy włączonej blokadzie aplikacji nie będzie czym odblokować ZBox. Blokada zostanie pominięta, zamiast Cię odciąć, ale ZBox będzie się wtedy otwierał bez blokady.
unl_remove_warning = Usunąć {name}? ZBox nie będzie już tego akceptować.
ab_col_email = E-mail
ab_col_name = Nazwa
ab_col_phone = Telefon

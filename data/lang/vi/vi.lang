# The lock screen and the Unlock Methods dialog: its notes, the name
# a button takes when it is unavailable, and every status line.
unl_note_locked = ZBox đang bị khóa. Hãy dùng một trong các phương thức bên dưới để mở khóa. Hủy sẽ đóng ZBox mà không mở tài khoản nào.
unl_note_foreign_passkey = Khóa truy cập lưu cùng thư mục này thuộc về máy tính khác, nên không dùng được ở đây. Hãy mở khóa bằng khóa bảo mật hoặc mật khẩu chính, rồi dùng Cài đặt, Riêng tư và bảo mật, Phương thức mở khóa để thiết lập khóa truy cập trên máy tính này.
unl_note_methods = Khi bật khóa ứng dụng, bất kỳ phương thức nào trong số này cũng mở khóa được ZBox, cùng với mật khẩu chính. Khóa truy cập dùng Windows Hello trên máy tính này; khóa bảo mật là khóa FIDO2 qua USB hoặc NFC và dùng được trên mọi máy tính bạn cắm vào.
unl_note_not_encryption = Các phương thức này mở khóa ứng dụng. Chúng không mã hóa gì cả: mật khẩu chính vẫn là thứ duy nhất mở được mật khẩu tài khoản đã lưu trên máy tính chưa từng dùng thư mục này. Phải đặt mật khẩu chính trước, và chưa thêm được phương thức nào cho đến khi đặt.
unl_add_passkey_unavailable = &Thêm khóa truy cập (không khả dụng)
unl_add_key_unavailable = &Thêm khóa bảo mật (không khả dụng)
unl_reassign_unavailable = &Gán lại khóa truy cập cho máy tính này (không khả dụng)
unl_status_cancelled_passkey = Đã hủy khóa truy cập. ZBox vẫn đang bị khóa.
unl_status_cancelled_key = Đã hủy khóa bảo mật. ZBox vẫn đang bị khóa.
unl_status_enter_password = Nhập mật khẩu chính.
unl_status_no_master = Chưa đặt mật khẩu chính, nên chưa thêm được khóa truy cập hay khóa bảo mật. Hãy đặt bằng nút Mật khẩu chính trong Cài đặt, Riêng tư và bảo mật, rồi quay lại đây. Mật khẩu chính là thứ mở được mật khẩu tài khoản đã lưu trên máy tính khác; khóa truy cập chỉ mở khóa ứng dụng trên máy này, nên không thể dùng riêng.
unl_status_unsupported = Windows trên máy tính này không hỗ trợ khóa truy cập hay khóa bảo mật, nên ở đây chỉ mật khẩu chính mở khóa được ZBox.
unl_status_foreign_one = 1 khóa truy cập thuộc về máy tính khác và không mở khóa được ZBox ở đây. Gán lại sẽ thay bằng một khóa tạo trên máy tính này.
unl_status_foreign_many = {count} khóa truy cập thuộc về máy tính khác và không mở khóa được ZBox ở đây. Gán lại sẽ thay bằng một khóa tạo trên máy tính này.
unl_status_foreign_one_no_hello = 1 khóa truy cập thuộc về máy tính khác và không mở khóa được ZBox ở đây. Windows Hello chưa được thiết lập ở đây, nên không thể thay trên máy tính này; Gỡ sẽ quên chúng.
unl_status_foreign_many_no_hello = {count} khóa truy cập thuộc về máy tính khác và không mở khóa được ZBox ở đây. Windows Hello chưa được thiết lập ở đây, nên không thể thay trên máy tính này; Gỡ sẽ quên chúng.
unl_status_no_hello = Windows Hello chưa được thiết lập trên máy tính này, nên không thêm được khóa truy cập ở đây. Vẫn thêm được khóa bảo mật.
unl_status_none_registered = Chưa đăng ký phương thức mở khóa nào.
unl_status_add_cancelled_passkey = Đã hủy thêm khóa truy cập.
unl_status_add_cancelled_key = Đã hủy thêm khóa bảo mật.
unl_status_added = Đã thêm: {name}.
unl_status_reassign_cancelled = Đã hủy gán lại. Không có gì thay đổi.
unl_status_reassigned = Đã thêm {name} và quên {count} khóa từ các máy tính khác.
unl_status_test_cancelled = Đã hủy kiểm tra.
unl_status_removed = Đã gỡ.
unl_remove_warning_last = Gỡ {name}?\n\nĐây là phương thức mở khóa duy nhất đã đăng ký và chưa đặt mật khẩu chính, nên khi bật khóa ứng dụng sẽ không còn gì để mở khóa ZBox. Khóa sẽ được bỏ qua thay vì chặn bạn, nhưng khi đó ZBox sẽ mở mà không khóa.
unl_remove_warning = Gỡ {name}? ZBox sẽ không chấp nhận phương thức này nữa.

# The lock screen and the Unlock Methods dialog: its notes, the name
# a button takes when it is unavailable, and every status line.
unl_note_locked = ZBox قفل است. برای باز کردن قفل آن از هر یک از روش‌های زیر استفاده کنید. لغو، ZBox را بدون باز کردن هیچ حسابی می‌بندد.
unl_note_foreign_passkey = کلید ورود ذخیره‌شده با این پوشه متعلق به کامپیوتر دیگری است، بنابراین اینجا قابل استفاده نیست. با کلید امنیتی یا گذرواژهٔ اصلی خود قفل را باز کنید، سپس از تنظیمات، حریم خصوصی و امنیت، روش‌های باز کردن قفل برای تنظیم یک کلید ورود روی این کامپیوتر استفاده کنید.
unl_note_methods = هر کدام از این‌ها، در کنار گذرواژهٔ اصلی، وقتی قفل برنامه روشن است ZBox را باز می‌کند. یک کلید ورود از Windows Hello روی این کامپیوتر استفاده می‌کند؛ یک کلید امنیتی یک کلید FIDO2 روی USB یا NFC است و روی هر کامپیوتری که آن را وصل کنید کار می‌کند.
unl_note_not_encryption = این‌ها برنامه را باز می‌کنند. چیزی را رمزگذاری نمی‌کنند: گذرواژهٔ اصلی همچنان تنها چیزی است که می‌تواند گذرواژه‌های ذخیره‌شدهٔ حساب را روی کامپیوتری که این پوشه پیش‌تر روی آن استفاده نشده باز کند. باید ابتدا تنظیم شود، و هیچ‌کدام از این‌ها تا آن زمان قابل افزودن نیستند.
unl_add_passkey_unavailable = افزودن کلید ورود (در دسترس نیست)
unl_add_key_unavailable = افزودن کلید امنیتی (در دسترس نیست)
unl_reassign_unavailable = تخصیص دوبارهٔ کلید ورود به این کامپیوتر (در دسترس نیست)
unl_status_cancelled_passkey = کلید ورود لغو شد. ZBox همچنان قفل است.
unl_status_cancelled_key = کلید امنیتی لغو شد. ZBox همچنان قفل است.
unl_status_enter_password = گذرواژهٔ اصلی را وارد کنید.
unl_status_no_master = گذرواژهٔ اصلی‌ای تنظیم نشده، بنابراین یک کلید ورود یا کلید امنیتی هنوز قابل افزودن نیست. یکی را با دکمهٔ گذرواژهٔ اصلی در تنظیمات، حریم خصوصی و امنیت تنظیم کنید، سپس به اینجا برگردید. گذرواژهٔ اصلی چیزی است که گذرواژه‌های ذخیره‌شدهٔ حساب شما را روی کامپیوتر دیگری باز می‌کند؛ یک کلید ورود فقط برنامه را روی همین یکی باز می‌کند، بنابراین نمی‌تواند به‌تنهایی بایستد.
unl_status_unsupported = ویندوز این کامپیوتر از کلید ورود یا کلید امنیتی پشتیبانی نمی‌کند، بنابراین فقط گذرواژهٔ اصلی می‌تواند اینجا ZBox را باز کند.
unl_status_foreign_one = ۱ کلید ورود متعلق به کامپیوتر دیگری است و نمی‌تواند اینجا ZBox را باز کند. تخصیص دوباره آن‌ها را با یکی که روی این کامپیوتر ساخته شده جایگزین می‌کند.
unl_status_foreign_many = {count} کلید ورود متعلق به کامپیوتر دیگری هستند و نمی‌توانند اینجا ZBox را باز کنند. تخصیص دوباره آن‌ها را با یکی که روی این کامپیوتر ساخته شده جایگزین می‌کند.
unl_status_foreign_one_no_hello = ۱ کلید ورود متعلق به کامپیوتر دیگری است و نمی‌تواند اینجا ZBox را باز کند. Windows Hello اینجا تنظیم نشده، بنابراین نمی‌توان آن‌ها را روی این کامپیوتر جایگزین کرد؛ حذف آن‌ها را فراموش می‌کند.

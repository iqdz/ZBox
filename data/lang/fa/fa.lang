# The explanatory note under each setting. One paragraph, one key.
set_debug_note = ثبت رخداد عیب‌یابی در تشخیص مشکلات در صورت بروز خطا کمک می‌کند. خاموش کردن آن نوشتن سطرهای جدید را متوقف می‌کند؛ فایل‌های گزارش موجود حذف نمی‌شوند. با راه‌اندازی بعدی ZBox اعمال می‌شود.
set_language_note = با راه‌اندازی بعدی ZBox اعمال می‌شود. فایل‌های زبان فایل‌های متن ساده در پوشهٔ lang در کنار پوشهٔ sounds هستند. برای افزودن یکی، پوشهٔ en را رونوشت کنید، رونوشت و فایل .lang درون آن را به کد زبان خود تغییر نام دهید، و متن سمت راست هر علامت مساوی را ترجمه کنید. هر چیزی که هنوز ترجمه نشده به انگلیسی خوانده می‌شود نه اینکه ساکت بماند، بنابراین یک فایل نیمه‌تمام برای استفاده امن است.
set_headers_note = فرستنده، به، رونوشت، تاریخ و موضوع، بالای بدنهٔ پیام هم در نمای متن و هم HTML نشان داده می‌شوند. بدون آن راهی نیست تا از داخل پیام بدانید چه کسی آن را فرستاده، بدون بستن زبانه و بازگشت به فهرست. فوکوس همچنان در بدنهٔ پیام قرار می‌گیرد؛ بلوک سرایند یک Shift+Tab فاصله دارد. با باز شدن پیام بعدی اعمال می‌شود.
set_zoom_note = متن پیام باز را بزرگ‌تر یا کوچک‌تر می‌کند، مستقل از باقی ZBox و از مقیاس‌بندی نمایش خود ویندوز. برای هر دو نمای متن و HTML اعمال می‌شود. «قلم خواندن» به‌طور اختیاری یک قلم مشخص (مثلاً Consolas، OpenDyslexic) را برای بدنهٔ پیام اجباری می‌کند؛ برای نگه داشتن قلم عادی آن را خالی بگذارید. Ctrl+Shift+= / Ctrl+Shift+- / Ctrl+Shift+0 در منوی نما اندازهٔ قلم را بدون باز کردن این پنجره افزایش، کاهش یا بازنشانی می‌کنند، و بلافاصله روی هر پیام باز اعمال می‌شوند. تغییرات اینجا نیز بلافاصله با تأیید اعمال می‌شوند.
set_view_note = HTML پیش‌فرض است. پیام را همان‌طور که فرستاده شده نشان می‌دهد، و توسط NVDA و JAWS خوانده می‌شود: هنگام باز شدن یک صفحهٔ HTML، ZBox اعلان خود مرورگر را ساکت می‌کند، نشانگر خواندن را روی اولین سطر پیام می‌گذارد، و میان‌برهای خود ZBox را درون صفحه فعال نگه می‌دارد، از جمله F6 برای بازگرداندن فوکوس از آن به بیرون. متن همان پیام را به‌صورت متن سادهٔ بدون قالب در یک کنترل ویرایش معمولی نشان می‌دهد -- بدون تصویر، بدون چیدمان، و بدون هیچ چیزی که به نصب بودن یک موتور مرورگر وابسته باشد. برای جابه‌جایی بین این دو، درون یک پیام باز Ctrl+B را بزنید.
set_engine_note = Edge سی‌اس‌اس مدرن را رندر می‌کند اما صفحه را در یک فرایند جدا اجرا می‌کند، و محتوای خود را فقط از طریق یک رابط که wxPython به آن دسترسی ندارد به صفحه‌خوان تحویل می‌دهد -- بنابراین ممکن است پیام بدون هیچ چیز قابل خواندنی باز شود. MSHTML قدیمی همان موتوری است که Outlook Express و Windows Mail استفاده می‌کردند: درون‌فرایندی اجرا می‌شود و یک درخت سند معمولی منتشر می‌کند، بنابراین NVDA و JAWS آن را در حالت مرور مانند هر صفحهٔ وب می‌خوانند. با باز شدن پیام بعدی اعمال می‌شود.
set_runtime_note = زمان اجرای سراسر سیستم توسط ویندوز آپدیت سرویس می‌شود، بنابراین موتوری که نامهٔ شما را می‌خواند می‌تواند بدون اطلاع تغییر کند -- به همین شکل نمای پیام HTML که کار می‌کرد می‌تواند روی ماشینی که چیزی دربارهٔ ZBox تغییر نکرده خراب شود. یک نسخهٔ همراه در پوشهٔ deps نسخهٔ دقیقی که ZBox در برابر آن آزموده شده را ثابت نگه می‌دارد. tools\get_webview2.bat را برای نصب یکی اجرا کنید. اگر نسخهٔ همراهی موجود نباشد ZBox به هر حال از زمان اجرای سراسر سیستم استفاده می‌کند، بنابراین همیشه آغاز می‌شود. با راه‌اندازی بعدی ZBox اعمال می‌شود.
set_sr_intro = اینکه ZBox چقدر اجازه می‌دهد صفحه‌خوان شما هنگام باز شدن یک پیام صحبت کند، و اعلان‌های گفتاری خودش چقدر باقی می‌مانند.
set_silence_note = هنگام باز شدن یک پیام HTML، ZBox می‌تواند یک فشردن مصنوعی Ctrl را تا ۲ ثانیه نگه دارد تا اعلان مرورگر صفحه‌خوان را ساکت کند. موضوع پیام از قبل به‌عنوان عنوان صفحه استفاده می‌شود، که مانع خوانده شدن آدرس base64 می‌شود، اما صفحه‌خوان همچنان کنترل و نوع سند را روی آغاز پیام اعلام می‌کند، بنابراین این به‌طور پیش‌فرض روشن است. برای خاموش کردن، خاموش را برگزینید، یا اگر هنوز صدایی نشت می‌کند زمانی بلندتر برگزینید.
set_focus_delay_note = وقتی یک پیام HTML بارگذاری آن تمام می‌شود، ZBox این مدت را قبل از فوکوس دادن واقعی به آن منتظر می‌ماند. اعلام بارگذاری صفحه توسط WebView2 و پایان یافتن درخت دسترس‌پذیری آن صفحه توسط ویندوز یک لحظه نیستند؛ فوکوس دادن خیلی زود چیزی است که باعث می‌شود NVDA/JAWS به‌جای پیام یک «صفحهٔ محتوای وب» عمومی اعلام کند، یا پیام را برای مدتی پس از باز شدن در دسترس‌نبودنی گزارش کند. گزینه‌ها از 0.1 ثانیه تا ۱ ثانیه است. اگر هنوز این را می‌بینید زمانی بلندتر برگزینید؛ وقتی باز شدن پایدار به نظر رسید برای بازکردن سریع‌تر زمانی کوتاه‌تر برگزینید.
set_announce_note = Ctrl+U و Ctrl+Shift+U فرستنده را در یک پنجرهٔ کوچک گزارش می‌دهند که خودش بسته می‌شود، زیرا نوار وضعیت فقط زمانی گفته می‌شود که گزارش نوار وضعیت صفحه‌خوان شما روشن باشد. این مدتی است که آن پنجره باز می‌ماند. آن را متناسب با سرعت گفتار خود تنظیم کنید: خیلی کوتاه و در میانهٔ جمله بسته می‌شود، که هدف را از بین می‌برد. هر کلیدی زودتر آن را می‌بندد؛ کلیدهای جهت‌نما آن را باز نگه می‌دارند تا دوباره بخوانید. گزینهٔ منتظر یک کلید می‌ماند آن را تا فشردن یک کلید باز نگه می‌دارد.
set_attachment_dir_note = جایی که «ذخیرهٔ همه» پیوست‌ها را می‌نویسد وقتی یک پیام بیش از یک پیوست دارد. اگر وجود نداشته باشد به‌طور خودکار ایجاد می‌شود. پیامی با یک پیوست تنها همچنان مانند قبل می‌پرسد کجا ذخیره شود. برای پیش‌فرض خالی بگذارید:\n{path}
set_autosave_note = هر چند وقت یک زبانهٔ نگارش باز خودش را در پیش‌نویس‌ها ذخیره می‌کند هنگام نوشتن. ذخیرهٔ پیش‌نویس (Ctrl+S) همچنان در هر صورت به تقاضا ذخیره می‌کند، و بستن یک زبانه با نوشتهٔ ذخیره‌نشده همیشه پیشنهاد ذخیره می‌دهد. خاموش ذخیرهٔ خودکار را خاموش می‌کند. زیر ۱۵ ثانیه ارائه نمی‌شود -- آن یک رفت‌وبرگشت سرور در رقابت با تایپ شما خواهد بود.
set_auto_purge_note = پیام‌ها را برای همیشه از زباله‌دان و هرزنامه پس از این تعداد روز که آنجا مانده‌اند حذف می‌کند -- همان حذف همیشگی که خالی کردن زباله‌دان و خالی کردن هرزنامه به تقاضا انجام می‌دهند، به‌طور خودکار یک‌بار در روز حین باز بودن ZBox اجرا می‌شود. به‌طور پیش‌فرض روی ۳۰ روز روشن است. خاموش آن را خاموش می‌کند. این پس از حذف یک پیام قابل واگرد نیست.
set_bare_keys_note = وقتی روشن باشد، فشردن تنهای S، A، J، W یا K در فهرست پیام بلافاصله پرچم را تغییر می‌دهد، بایگانی می‌کند، پیام(های) انتخاب‌شده را به‌عنوان هرزنامه علامت می‌زند (Shift+J آن‌ها را غیرهرزنامه علامت می‌زند)، یا رشته‌ای که گزیده بخشی از آن است را زیرنظر می‌گیرد/نادیده می‌گیرد -- بایگانی و علامت‌گذاری به‌عنوان هرزنامه تأیید یا واگردی ندارند. خاموش کردن این S، A، J، W و K را به ناوبری عادی فهرست با حرف اول بازمی‌گرداند. Ctrl+S و Ctrl+Shift+A در هر صورت کار می‌کنند. بلافاصله اعمال می‌شود.
set_sounds_note = صداهای کوتاه برای پیشرفت، پیام‌های جدید، کنش‌های ارسال، پاسخ یا ارسال به‌عنوان دیگری، حذف‌ها، و نتایج جستجو. خاموش کردن هر صدایی در برنامه را غیرفعال می‌کند؛ اعلان‌های صفحه‌خوان و نوار وضعیت در هر صورت تحت تأثیر قرار نمی‌گیرند.
set_desktop_notifications_note = یک اعلان ویندوز برای هر دستهٔ نامهٔ جدید، جدا از صدای بالا. خاموش کردن آن را برای هر حساب غیرفعال می‌کند؛ یک حساب تکی نیز می‌تواند جداگانه در تنظیمات حساب و هویت‌ها خاموش شود.
set_theme_note = پوسته‌های سفارشی پوشه‌هایی هستند که درون پوشهٔ sounds ZBox قرار می‌گیرند، هر کدام progress-tick.wav، incoming-message.wav، action-done.wav، delete.wav، searching.wav، searching_done.wav و none_found.wav خود را تأمین می‌کنند. یک فایل پوسته که موجود نباشد به صدای پیش‌فرض بازمی‌گردد.
set_theme_note_only_default = پوسته‌های سفارشی پوشه‌هایی هستند که درون پوشهٔ sounds ZBox قرار می‌گیرند، هر کدام progress-tick.wav، incoming-message.wav، action-done.wav، delete.wav، searching.wav، searching_done.wav و none_found.wav خود را تأمین می‌کنند. یک فایل پوسته که موجود نباشد به صدای پیش‌فرض بازمی‌گردد. تا وقتی پوشهٔ پوستهٔ دیگری اضافه نکنید فقط «پیش‌فرض» در دسترس است.
set_lock_note = راه‌اندازی ZBox سپس پیش از باز شدن هر حسابی یکی از روش‌های باز کردن قفل شما را می‌پرسد. هر کدام از آن‌ها کافی است: یک کلید ورود، یک کلید امنیتی، یا گذرواژهٔ اصلی. بستن به سینی خروج نیست و قفل را دوباره نمی‌کند؛ فایل > خروج و گزینهٔ خروج نماد سینی این کار را می‌کنند. اگر چیزی ثبت نشده باشد و گذرواژهٔ اصلی تنظیم نشده باشد، قفل نادیده گرفته می‌شود به‌جای اینکه شما را از نامهٔ خودتان بیرون نگه دارد.
set_security_note = گذرواژهٔ اصلی تنها موردی از این سه است که چیزی را رمزگذاری می‌کند: همان چیزی است که به این پوشه اجازه می‌دهد گذرواژه‌های ذخیره‌شدهٔ حساب خود را روی کامپیوتر دیگری باز کند. یک کلید ورود یا کلید امنیتی برنامه را روی همین یکی باز می‌کند. هیچ‌کدام جایگزین گذرواژهٔ اصلی روی کامپیوتری که ZBox پیش‌تر روی آن استفاده نشده نمی‌شوند.
set_minimize_note = کوچک کردن ZBox دکمهٔ نوار وظیفهٔ آن را پنهان می‌کند و آن را پشت نماد سینی در حال اجرا نگه می‌دارد. کلیک چپ روی نماد سینی (یا Enter/Space وقتی فوکوس صفحه‌کلید دارد) پنجره را بازمی‌گرداند.
set_close_note = دکمهٔ بستن پنجره، Alt+F4، و Ctrl+W فشرده‌شده در زبانهٔ نامه، ZBox را به‌جای خروج به سینی پنهان می‌کنند. فایل > خروج (Ctrl+Shift+Q) و گزینهٔ خروج خود نماد سینی در هر صورت واقعاً از ZBox خارج می‌شوند، بنابراین همیشه یک مسیر صفحه‌کلیدی برای خروج بدون لمس سینی هست.
set_stay_maximized_note = ZBox بیشینه راه‌اندازی می‌شود و اگر آن را از بیشینه خارج کنید دوباره بیشینه می‌شود. نوار منو، نوار عنوان و لبهٔ پنجره تحت تأثیر قرار نمی‌گیرند -- این یک حالت تمام‌صفحهٔ بدون‌حاشیه نیست، بنابراین هر میان‌بر منوی Alt همچنان کار می‌کند.
set_run_at_startup_note = ZBox را به‌طور خودکار هنگام ورود به ویندوز آغاز می‌کند، مستقیم به سینی باز می‌شود نه اینکه پنجره‌اش را نشان دهد. بلافاصله اعمال می‌شود، نه فقط در راه‌اندازی بعدی.
set_desktop_shortcut_note = یک میان‌بر ZBox روی رومیزی شما می‌گذارد، و یکی که از قبل آنجاست را جایگزین می‌کند. یک میان‌بر مسیر دقیق این پوشهٔ ZBox را ذخیره می‌کند، بنابراین اگر ZBox را جای دیگری جابه‌جا یا رونوشت کنید، این را دوباره روی نسخهٔ جدید فشار دهید تا میان‌بر رومیزی به آن اشاره کند. بلافاصله اعمال می‌شود و منتظر تأیید نمی‌ماند.


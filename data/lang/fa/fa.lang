# The explanatory note under a control, one paragraph per key.
acct_note_display_name = نام نمایشی اختیاری است -- برای ارسال با نام خود این حساب آن را خالی بگذارید.
acct_note_identity = نشانی ایمیل می‌تواند با ایمیل ورود متفاوت باشد اگر ارائه‌دهندهٔ شما یک دامنهٔ سفارشی متصل به این صندوق داشته باشد. نامه با نشانی بالا ارسال و دریافت خواهد شد، درحالی‌که ورود همچنان از ایمیل ورود استفاده می‌کند. فیلد گذرواژه را برای نگه داشتن گذرواژهٔ فعلاً ذخیره‌شده برای این حساب خالی بگذارید -- برای مثال پس از چرخش یک گذرواژهٔ برنامهٔ Gmail، گذرواژهٔ جدید را اینجا تایپ کنید؛ در غیر این صورت آن را خالی بگذارید.
acct_note_identities = نشانی‌های دیگری که این حساب می‌تواند با آن‌ها ارسال و پاسخ دهد. پاسخ دادن به پیامی که به یکی از این‌ها فرستاده شده به‌جای نشانی بالا فرستنده را به آن نشانی تنظیم می‌کند.
acct_note_signature = به هر پیام جدید، پاسخ و ارسال به‌عنوان دیگری ارسال‌شده از این حساب، زیر یک سطر «-- »، افزوده می‌شود. برای هیچ‌کدام خالی بگذارید. ویرایش امضا ویرایشگر قالب‌بندی‌شده را باز می‌کند، جایی که پررنگ، فهرست و پیوند در دسترس هستند؛ کادر بالا سپس نسخهٔ متن سادهٔ همراه آن را نگه می‌دارد که همراه آن ارسال می‌شود.
acct_note_junk = علامت‌گذاری به‌عنوان هرزنامه پیام‌ها را به کدام پوشهٔ واقعی منتقل می‌کند. «{automatic}» همان حدس آگاه از ارائه‌دهنده‌ای که بایگانی و زباله‌دان از قبل استفاده می‌کنند را به کار می‌برد؛ این را فقط در صورتی تنظیم کنید که آن حدس اشتباه باشد یا پوشهٔ هرزنامهٔ شما نام سفارشی داشته باشد.
acct_note_disable = یک حساب غیرفعال هرگز تماس گرفته نمی‌شود -- بدون IDLE، بدون به‌روزرسانی دوره‌ای، هیچ‌چیز -- تا وقتی دوباره فعال شود. همچنان در درخت نشان داده می‌شود، با علامت (غیرفعال)، و نامه‌های از قبل بارگیری‌شده‌اش به‌صورت آفلاین در دسترس می‌مانند. همان کلید حساب‌ها > غیرفعال کردن حساب یا فهرست زمینه‌ای خود حساب؛ این فقط یک محل دیگر برای دسترسی به آن است.
acct_note_default = پوشه‌های این حساب اول در درخت ظاهر می‌شوند، و یک پیام جدید به‌طور پیش‌فرض از آن ارسال می‌شود مگر اینکه در نگارشگر به‌صورت دستی تغییر کند. تأثیری روی اینکه یک پاسخ یا ارسال به‌عنوان دیگری کدام نشانی را استفاده می‌کند ندارد -- آن از قبل از پیامی که پاسخ داده می‌شود پیروی می‌کند (به هویت‌های اضافی بالا نگاه کنید). همیشه دقیقاً یک حساب پیش‌فرض وجود دارد، بنابراین برداشتن علامت این روی پیش‌فرض فعلی بدون گذاشتن علامت روی یکی دیگر آن را بدون تغییر می‌گذارد -- به‌جای آن کادر حساب دیگری را علامت بزنید تا پیش‌فرض به آن منتقل شود.
acct_note_mute = خاموش کردن صدای نامهٔ جدید این حساب، اعلان گفتاری و اعلان ویندوز را مسدود می‌کند، صرف‌نظر از اینکه آن‌ها در غیر این صورت چگونه پیکربندی شده‌اند. روی حساب‌های دیگر تأثیر نمی‌گذارد، و همچنان تابع کلیدهای اصلی در تنظیمات > صدا و اعلان‌ها (صداها و اعلان‌های رومیزی به‌طور کلی) است.
wiz_note_app_password = اگر از قبل یک گذرواژهٔ برنامه برای ZBox ایجاد کرده‌اید، برای ادامه بعدی را فشار دهید.
wiz_note_login = اعتبارنامهٔ ورود.\nاگر ایمیل ورود شما با نشانی بالا متفاوت است، برای مثال حساب ارائه‌دهندهٔ شما login@example.net است اما می‌خواهید به‌عنوان you@example.org ارسال و دریافت کنید، ایمیل ورود را اینجا وارد کنید. می‌توانید نشانی ارسال سفارشی را بعداً در تنظیمات حساب و هویت‌ها تنظیم کنید.
wiz_note_servers = تنظیمات سرور، از پیش پر شده جایی که دامنه شناخته‌شده باشد. هر چیزی که نیاز به تغییر دارد را ویرایش کنید.
wiz_preset_none = پیش‌تنظیمی برای این دامنه یافت نشد. تنظیمات سرور ارائه‌دهندهٔ خود را دستی وارد کنید؛ صفحات راهنمای ارائه‌دهندهٔ شما آن‌ها را فهرست می‌کنند.
ab_note_groups = نام یک گروه را در فیلد به، رونوشت یا رونوشت پنهان یک پنجرهٔ نگارش تایپ کنید تا همهٔ اعضای آن یکجا پر شوند.
cache_note_intro = این‌ها فقط نسخه‌های محلی ZBox را حذف می‌کنند. چیزی از هیچ سرور ایمیلی حذف نمی‌شود، و یک پیام حذف‌شده دفعهٔ بعد که آن را باز می‌کنید دوباره بارگیری می‌شود.
cache_note_age = پاک‌سازی خودکار یک‌بار در روز اجرا می‌شود، وقتی ZBox ده دقیقه فعالیت صفحه‌کلیدی نداشته و پیامی باز نباشد. بر اساس تاریخ خود هر پیام عمل می‌کند، از جمله پیام‌هایی که هنوز در حساب شما هستند.
filt_note_intro = قوانین به ترتیب، از بالا به پایین اجرا می‌شوند، فرستنده، به و موضوع را آزمایش می‌کنند. به‌طور خودکار روی نامهٔ جدید هنگام رسیدن به صندوق ورودی این حساب اعمال می‌شود؛ از اجرای فوری زیر برای اعمال آن‌ها روی پیام‌های از قبل موجود در یک پوشه استفاده کنید.
filt_note_run_now = هر قانون فعال بالا را به ترتیب روی هر پیام از قبل موجود در پوشهٔ انتخاب‌شده اعمال می‌کند -- ابتدا تغییرات شما را ذخیره می‌کند، مانند تأیید.
mp_note_intro = این حساب‌ها روی کامپیوتر دیگری تنظیم شده‌اند. گذرواژهٔ اصلی را وارد کنید تا گذرواژه‌های ذخیره‌شدهٔ آن‌ها اینجا باز شود. فقط یک‌بار روی این کامپیوتر از شما پرسیده خواهد شد.\n\nبدون آن، هر حساب باید دوباره وارد سرور ایمیل خود شود.
priv_note_remote = تصاویر، برگه‌های سبک و قلم‌هایی که یک پیام از اینترنت بارگذاری می‌کند، به فرستنده در همان لحظه که آن را باز کردید و از کجا می‌گویند. با روشن بودن این، هیچ‌کدام بارگذاری نمی‌شوند: یک اعلان بالای پیام نشان می‌دهد چه چیزی مسدود شد، و Ctrl+Shift+I آن را برای همان یک پیام بارگذاری می‌کند. تصاویر پیوست‌شده به خود پیام همیشه نشان داده می‌شوند. اسکریپت‌ها و قاب‌های تعبیه‌شده در هر صورت حذف می‌شوند و هرگز بارگذاری نمی‌شوند.
priv_note_blocklist = این لایهٔ دوم است. وقتی محتوای راه‌دور یک پیام را بارگذاری می‌کنید، یا یک فرستنده را اجازه می‌دهید اهمیت پیدا می‌کند: تصاویر بارگذاری می‌شوند، اما هر چیزی که از یک دامنهٔ ردیابی یا تبلیغاتی شناخته‌شده ارائه می‌شود همچنان بارگذاری نمی‌شود. فهرست از فهرست‌های عمومی تبلیغات و ردیاب بارگیری و ادغام می‌شود؛ به‌روزرسانی یک یا دو ثانیه طول می‌کشد و در پس‌زمینه اجرا می‌شود.
priv_note_junk = بدون حدس. علامت‌گذاری به‌عنوان هرزنامه فرستنده را به فهرست مسدود زیر اضافه می‌کند، مگر اینکه پیام از طریق یک فهرست پستی رسیده باشد. علامت‌گذاری به‌عنوان غیرهرزنامه فرستنده را به فهرست هرگز-هرزنامه اضافه می‌کند و آن پیام دیگر هرگز بررسی نمی‌شود. یک پیام جدید از یک فرستندهٔ مسدود در فهرست فرستندهٔ مسدود علامت می‌خورد؛ یکی که به یک سایت فیشینگ یا بدافزار شناخته‌شده پیوند می‌دهد فیشینگ احتمالی علامت می‌خورد. فیلترینگ هرزنامهٔ ارائه‌دهندهٔ ایمیل شما همچنان مانند قبل اجرا می‌شود.
priv_status_phishing_updating = فهرست فیشینگ: در حال به‌روزرسانی در پس‌زمینه. برای دیدن نتیجه این پنجره را دوباره باز کنید.
priv_status_updating = در حال به‌روزرسانی در پس‌زمینه. برای دیدن نتیجه این پنجره را دوباره باز کنید.
rel_note_intro = پیام‌های مرتبط با «{subject}» بر اساس سرایندهای Message-ID/References آن‌ها، در سراسر هر پوشه در این حساب.
srch_note_intro = در هر حساب و پوشه به دنبال واژه‌ها بگردید، یا جستجو را با گزینه‌های زیر محدود کنید. برای یافتن پیام‌ها تنها با تاریخ یا کادرهای انتخاب، واژه‌ها را خالی بگذارید.
sig_note_plain = جایگزین متن ساده را خالی بگذارید تا هنگام فشردن ذخیره از امضای قالب‌بندی‌شده نوشته شود.
unified_note_intro = انتخاب کنید کدام پوشه‌ها در سراسر هر حساب ترکیب شوند. هر کدام علامت‌خورده یک مدخل تکی در درخت می‌شود که آن پوشه را از همهٔ حساب‌های شما ترکیب می‌کند.


# ZBox interface language file.
#
# To translate ZBox, copy this file, rename it to your language code
# with the same .lang ending -- fr.lang, ar.lang, es.lang -- and put
# it in this same folder. Then change only the text on the right of
# each equals sign. Leave the section names in square brackets and
# the key names on the left exactly as they are: they are what ZBox
# looks the text up by, and translating them makes the line do
# nothing.
#
# Anything in curly braces is filled in by ZBox, so {count} becomes a
# number and {word} becomes a word. Keep every one that appears on a
# line, spelled the same way. You may move them wherever your own
# grammar needs them.
#
# Where a line ends in _one and another ends in _many, they are the
# singular and the plural of the same message. If your language needs
# a different split, write whatever is correct in each: ZBox picks
# _one when the number is exactly one and _many otherwise.
#
# A key you have not translated yet is heard in English rather than
# being silent, so a part-finished file is safe to use and safe to
# share.
#
# Save the file as UTF-8. Lines beginning with a hash are notes and
# are ignored.

[meta]
name = हिन्दी
code = hi
direction = ltr
translator = ZBox
app_version = 2026.09

# Everything ZBox says out loud when an action finishes.
[actions_announcements]

# Writing a message
message_sent = संदेश भेजा गया।
draft_saved = ड्राफ़्ट सहेजा गया।
signature_inserted = हस्ताक्षर डाला गया।
signature_none = इस खाते का कोई हस्ताक्षर नहीं है।
signature_saved = हस्ताक्षर सहेजा गया।
signature_not_saved = हस्ताक्षर नहीं सहेजा गया।
pasted_as_quotation = उद्धरण के रूप में चिपकाया गया।
clipboard_empty = क्लिपबोर्ड पर कुछ नहीं है।
word_count = {words} शब्द, {characters} अक्षर।
report_copied = रिपोर्ट कॉपी की गई।
compose_tab_needed = इस आदेश के लिए लिखने वाला टैब चाहिए।
attach_file_instead = छोड़ी गई फ़ाइलें संदेश के पाठ में नहीं डाली जातीं। फ़ाइल भेजने के लिए फ़ाइल संलग्न करें का उपयोग करें।

# Formatting in the message body
formatting_here = यहाँ का फ़ॉर्मेटिंग: {formatting}।
no_formatting_here = यहाँ कोई फ़ॉर्मेटिंग नहीं, सादा पाठ।

# Spelling
nothing_to_check = जाँचने के लिए कुछ नहीं है।
no_misspellings = कोई वर्तनी त्रुटि नहीं।
spelling_dictionary_unavailable = वर्तनी शब्दकोश उपलब्ध नहीं है।
next_misspelling_first = पहले अगली वर्तनी त्रुटि का उपयोग करें।
word_added = {word} शब्दकोश में जोड़ा गया।
word_not_added = {word} नहीं जोड़ा जा सका।
corrections_applied_one = 1 सुधार लागू किया गया।
corrections_applied_many = {count} सुधार लागू किए गए।
corrections_applied_partly = {total} में से {applied} सुधार लागू किए गए। बाकी अस्वीकार हुए; लॉग देखें।
occurrences_replaced_one = 1 जगह बदला गया।
occurrences_replaced_many = {count} जगह बदला गया।

# Reading mail
message_did_not_open = संदेश नहीं खुला। सर्वर ने उत्तर नहीं दिया। फिर से प्रयास करने के लिए Enter दबाएँ।
thread_open = इस थ्रेड में {messages}। बंद करने के लिए फिर से दबाएँ।
no_thread_selected = कोई थ्रेड चयनित नहीं।
thread_watched = थ्रेड पर नज़र रखी जा रही है।
thread_not_watched = थ्रेड पर अब नज़र नहीं रखी जा रही।
thread_ignored = थ्रेड अनदेखा किया गया।
thread_not_ignored = थ्रेड अब अनदेखा नहीं है।
none_found = कुछ नहीं मिला।
refreshing_this_folder = यह फ़ोल्डर रीफ़्रेश हो रहा है।
refreshing_all_accounts = सभी खाते रीफ़्रेश हो रहे हैं।
message_view_html = संदेश दृश्य: HTML (प्रस्तुत)।
message_view_text = संदेश दृश्य: पाठ।
html_view_still_loading = संदेश अभी लोड हो रहा है। Escape इसे बंद करता है।
message_still_opening = संदेश खुल रहा है। सर्वर धीमा है।
remote_content_blocked = रिमोट सामग्री अवरुद्ध की गई।
remote_content_unblocked = रिमोट सामग्री अनवरुद्ध की गई।
remote_content_already_showing = इस संदेश में रिमोट सामग्री पहले से दिख रही है।
archived = संग्रहित किया गया।
copied_to_folder = {to_folder} में कॉपी किया गया।
deleted_one = संदेश स्थायी रूप से हटाया गया।
deleted_many = {count} संदेश स्थायी रूप से हटाए गए।
trashed_one = संदेश ट्रैश में ले जाया गया।
trashed_many = {count} संदेश ट्रैश में ले जाए गए।

# Accounts and new mail
no_account_yet = अभी जाने के लिए कोई खाता नहीं है।
inbox_landed = {name} इनबॉक्स।
account_enabled = {name} सक्षम किया गया।
auto_check_paused = {account} के लिए स्वचालित जाँच रोकी गई।
auto_check_resumed = {account} के लिए स्वचालित जाँच चालू है।
account_disabled = {name} अक्षम किया गया।
new_mail_one = {name} के लिए 1 नया संदेश।
new_mail_many = {name} के लिए {count} नए संदेश।
refresh_all_done_one = 1 खाता रीफ़्रेश किया गया।
refresh_all_done_many = {count} खाते रीफ़्रेश किए गए।
refresh_all_done_failures = {count} खाते रीफ़्रेश किए गए, {failed} रीफ़्रेश नहीं हो सके।
refresh_all_done_failures_one = {count} खाता रीफ़्रेश किया गया, {failed} रीफ़्रेश नहीं हो सका।

# The sender of the message in view
sender_address_copied = {sender}। पता कॉपी किया गया।
sender_no_address = {sender}। कॉपी करने के लिए कोई पता नहीं।
clipboard_not_opened = {sender}। क्लिपबोर्ड नहीं खोला जा सका।

# The signature editor
signature_page_formatted = फ़ॉर्मेट किया गया। यही सहेजा जाएगा।
signature_page_html = HTML स्रोत। यही सहेजा जाएगा।
signature_page_html_still_wins = फ़ॉर्मेट किया गया। सहेजा अब भी HTML स्रोत ही जाएगा।

# Background work
phishing_list_updating = फ़िशिंग सूची पृष्ठभूमि में अपडेट हो रही है।
cache_cleared = {files} कैश फ़ाइलें साफ़ की गईं, {size} MB।
hotkeys_diagnostic_on = हॉटकी निदान चालू, चेक किया गया
hotkeys_diagnostic_off = हॉटकी निदान बंद, अनचेक किया गया

# What a bulk action is called, when ZBox says which one just
# finished. These are names, not sentences.
action_archive = संग्रहित करें
action_delete = हटाएँ
action_delete_permanently = स्थायी रूप से हटाएँ
action_mark_as_junk = जंक के रूप में चिह्नित करें
action_mark_as_not_junk = जंक नहीं के रूप में चिह्नित करें
action_move_to = यहाँ ले जाएँ
action_copy_to = यहाँ कॉपी करें
action_mark_message = संदेश चिह्नित करें
action_undo = पूर्ववत करें

# Finishing an action on one or more messages. {action} is one of the
# names just above and {to_folder} is one of your own folders.
undo_done_one = {action} पूर्ववत किया गया।
undo_done_many = {count} संदेशों के लिए {action} पूर्ववत किया गया।
junk_marked_one = जंक के रूप में चिह्नित किया गया।
junk_marked_many = {count} संदेश जंक के रूप में चिह्नित किए गए।
junk_no_new_sender = कोई नया प्रेषक अवरुद्ध नहीं हुआ: पहले से अवरुद्ध, मेलिंग सूची, या आपका अपना कोई पता।
not_junk_marked_one = जंक नहीं के रूप में चिह्नित किया गया।
not_junk_marked_many = {count} संदेश जंक नहीं के रूप में चिह्नित किए गए।
moved_to_one = {to_folder} में ले जाया गया।
moved_to_many = {count} संदेश {to_folder} में ले जाए गए।
copied_to_many = {count} संदेश {to_folder} में कॉपी किए गए।
marked_read = पढ़ा हुआ चिह्नित किया गया।
marked_unread = अपठित चिह्नित किया गया।

# When a run of several messages is stopped or partly fails. {done}
# is the ordinary finished message above, spoken first.
bulk_cancelled = {total} में से {completed} के बाद रद्द किया गया। {succeeded} सफल, {failed} विफल।
bulk_failed_one = {done} 1 में से {failed} संदेश विफल रहा।
bulk_failed_many = {done} {total} में से {failed} संदेश विफल रहे।

# Formatting, as it is spoken while writing. The word on the left of
# each format_word line is ZBox's own name for that formatting and is
# never translated; the text on the right is what is said.
format_word_bold = बोल्ड
format_word_italic = इटैलिक
format_word_strike = स्ट्राइकथ्रू
format_word_href = लिंक
format_word_bullet = बुलेट सूची
format_word_number = क्रमांकित सूची
format_word_quote = उद्धरण
format_word_code = कोड
format_word_heading1 = शीर्षक
format_applied = {formatting} लागू किया गया।
format_inserted = {formatting} डाला गया।
format_not_available = सादे संदेश मुख्य भाग में {formatting} उपलब्ध नहीं है।
format_on = {formatting} चालू
format_off = {formatting} बंद
link_applied = लिंक लागू किया गया।
link_applied_to_selection = चयन पर लिंक लागू किया गया।
plain_body_formatting = सादा संदेश मुख्य भाग अपना फ़ॉर्मेटिंग टैग के रूप में दिखाता है।

# Reaching either end of a thread
thread_edge_first = इस थ्रेड का पहला संदेश। बंद करने के लिए फिर से दबाएँ।
thread_edge_last = इस थ्रेड का अंतिम संदेश। बंद करने के लिए फिर से दबाएँ।
jump_unified_inbox = एकीकृत इनबॉक्स।
remote_none = इस संदेश में कोई रिमोट सामग्री नहीं।
sender_none = इस संदेश का कोई प्रेषक नहीं।
sender_name_no_address = %s, कोई पता नहीं

[main_ui]

# The search tab. {term} is what was typed in.
search_placeholder = ऊपर कुछ लिखें और Enter दबाएँ या खोजें चुनें।
search_no_account = पहले एक खाता जोड़ें।
search_no_term = खोजने के लिए कुछ लिखें।
search_running = खोज हो रही है...
search_none = "{term}" के लिए कोई मिलान नहीं।
search_found_one = "{term}" के लिए 1 मिलान।
search_found_many = "{term}" के लिए {count} मिलान।
search_failed = खोज विफल रही।

# The related messages tab
related_running = खोज हो रही है...
related_none = कोई संबंधित संदेश नहीं मिला।
related_found_one = 1 संबंधित संदेश मिला।
related_found_many = {count} संबंधित संदेश मिले।
related_failed = संबंधित संदेश नहीं खोजे जा सके।

# Writing and sending
sending_via = {sender} के ज़रिए भेजा जा रहा है...
send_failed = भेजना विफल रहा। विवरण के लिए लॉग देखें।
draft_autosaved = ड्राफ़्ट अपने आप सहेजा गया।
draft_autosave_failed = ड्राफ़्ट अपने आप सहेजना विफल रहा। विवरण के लिए लॉग देखें।

# Reading a message, and its attachments. {folder} here is a folder on
# your own computer.
remote_allowed_for_sender = {sender} के संदेशों के लिए अब रिमोट सामग्री लोड होगी।
downloading_attachment = {filename} डाउनलोड हो रहा है...
downloading_attachments_one = 1 अटैचमेंट डाउनलोड हो रहा है...
downloading_attachments_many = {count} अटैचमेंट डाउनलोड हो रहे हैं...
saved_to = {folder} में सहेजा गया
attachment_download_failed = अटैचमेंट डाउनलोड विफल रहा।

# Getting mail onto the screen
loading_folder = {account} के लिए {folder} लोड हो रहा है...
messages_in_folder = {folder} में {count} संदेश।
messages_in_folder_cached = {folder} में {count} संदेश (अंतिम सिंक की गई प्रति, अपडेट हो रही है...)
no_offline_copy = {folder} की अभी कोई ऑफ़लाइन प्रति नहीं है।
refresh_failed_cached = {folder} रीफ़्रेश नहीं हो सका: अंतिम सिंक की गई प्रति दिखाई जा रही है।
no_such_folder = इस खाते के लिए कोई {folder} फ़ोल्डर नहीं है।
load_failed = संदेश लोड नहीं हो सके। विवरण के लिए लॉग देखें।
no_more_to_load = इस फ़ोल्डर में लोड करने के लिए और संदेश नहीं हैं।
loading_more = {folder} में और संदेश लोड हो रहे हैं...
more_loaded = {count} और संदेश लोड हुए।
no_more_messages = इस फ़ोल्डर में और संदेश नहीं हैं।
load_more_failed = और संदेश लोड नहीं हो सके: {error}
loading_unified = एकीकृत {folder} लोड हो रहा है...
messages_in_unified = एकीकृत {folder} में सभी खातों के {count} संदेश।
messages_in_unified_cached = एकीकृत {folder} में {count} संदेश (अंतिम सिंक की गई प्रति, अपडेट हो रही है...)
auto_purge_done = स्वतः सफ़ाई ने ट्रैश/जंक से {count} पुराने संदेश हटाए।

# The main window's own status line. {folder} and {account} are your
# own folder and account names and are never translated.
ready = तैयार।
opening_message = संदेश खुल रहा है...
opening_message_already = संदेश खुल रहा है... (पहले से लोड हो रहा है)
could_not_open_message = संदेश नहीं खोला जा सका।
could_not_open_that_message = वह संदेश नहीं खोला जा सका।
could_not_load_message = यह संदेश लोड नहीं हो सका।
message_still_loading = वह संदेश अभी लोड हो रहा है।
folder_still_loading = यह फ़ोल्डर अभी लोड हो रहा है -- थोड़ी देर में फिर प्रयास करें।
not_in_thread = यह संदेश किसी थ्रेड का हिस्सा नहीं है।
no_longer_in_thread = यह संदेश अब थ्रेड में नहीं है।
thread_position = इस थ्रेड में {total} में से संदेश {position}।
thread_finished_one = यह थ्रेड पूरा हुआ (1 संदेश)।
thread_finished_many = यह थ्रेड पूरा हुआ ({count} संदेश)।
select_message_first = पहले एक संदेश चुनें।
conversation_failed = यह बातचीत नहीं खोली जा सकी।
select_message_for_related = पहले वह संदेश चुनें जिसके संबंधित संदेश देखने हैं।
looking_for_related = संबंधित संदेश खोजे जा रहे हैं...
no_threading_headers = इस संदेश में खोजने के लिए कोई Message-ID या थ्रेडिंग हेडर नहीं है।
reply_one_at_a_time = उत्तर एक बार में एक संदेश पर काम करता है। कृपया एक ही संदेश चुनें।
select_message_to_reply = पहले उत्तर देने के लिए एक संदेश चुनें।
preparing_reply = उत्तर तैयार हो रहा है...
reply_load_failed = उत्तर के लिए मूल संदेश लोड नहीं हो सका।
select_message_to_forward = पहले अग्रेषित करने के लिए एक संदेश चुनें।
preparing_forward = अग्रेषित करने के लिए संदेश तैयार हो रहा है...
forward_load_failed = अग्रेषित करने वाला संदेश लोड नहीं हो सका।
